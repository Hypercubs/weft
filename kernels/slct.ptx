// slct: `d = (c >= 0) ? a : b`, the select that real codegen emits where the comparison
// is only used to pick an operand.
.version 7.0
.target sm_80
.address_size 64

.visible .entry slcti(
    .param .u64 slcti_param_0,     // in: one int per lane
    .param .u64 slcti_param_1      // out: 0x3C00 or 0x4000
)
{
    .reg .b16 %hs<4>;
    .reg .b32 %r<4>;
    .reg .b64 %rd<8>;

    ld.param.u64 %rd1, [slcti_param_0];
    ld.param.u64 %rd2, [slcti_param_1];
    mov.u32 %r1, %tid.x;
    mul.wide.u32 %rd3, %r1, 4;
    add.u64 %rd4, %rd1, %rd3;
    add.u64 %rd5, %rd2, %rd3;

    ld.global.b32 %r2, [%rd4];
    mov.b16 %hs1, 0x3C00;     // 1.0
    mov.b16 %hs2, 0x4000;     // 2.0
    slct.b16.s32 %hs3, %hs1, %hs2, %r2;
    cvt.u32.u16 %r3, %hs3;
    st.global.b32 [%rd5], %r3;
    ret;
}

.visible .entry slctf(
    .param .u64 slctf_param_0,     // in: one float per lane
    .param .u64 slctf_param_1      // out: 111 or 222
)
{
    .reg .f32 %f<2>;
    .reg .b32 %r<6>;
    .reg .b64 %rd<8>;

    ld.param.u64 %rd1, [slctf_param_0];
    ld.param.u64 %rd2, [slctf_param_1];
    mov.u32 %r1, %tid.x;
    mul.wide.u32 %rd3, %r1, 4;
    add.u64 %rd4, %rd1, %rd3;
    add.u64 %rd5, %rd2, %rd3;

    ld.global.f32 %f1, [%rd4];
    mov.u32 %r2, 111;
    mov.u32 %r3, 222;
    slct.b32.f32 %r4, %r2, %r3, %f1;
    st.global.b32 [%rd5], %r4;
    ret;
}

.version 7.0
.target sm_80
.address_size 64

.visible .entry redatom(
    .param .u64 redatom_param_0     // out: one half2, contended by 64 lanes
)
{
    .reg .b32 %r<4>;
    .reg .b64 %rd<4>;

    ld.param.u64 %rd1, [redatom_param_0];
    mov.u32 %r1, %tid.x;
    and.b32 %r1, %r1, 63;

    mov.b32 %r2, 0x3C003800;  // hi 1.0, lo 0.5
    red.global.add.noftz.f16x2 [%rd1], %r2;
    ret;
}

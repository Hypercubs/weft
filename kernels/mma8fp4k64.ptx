// The fp4 multiply at K of 64, split out of `mma8fp4.ptx`.
//
// `mma.sync.aligned.m16n8k64.row.col.f32.e2m1.e2m1.f32.kind::f8f6f4` is not a shape
// this assembler has: it answers `Incorrect instruction type specified for mma with
// shape '.m16n8k64'`, and so does the same shape with e2m3, e3m2 or e4m3. The product
// is the sum over sixty-four codes, though, and a sum over sixty-four is the sum of
// two sums over thirty-two, so it is written here as two `m16n8k32` multiplies with
// the second accumulating into the first -- two legal instructions whose answer is
// the one the wider shape would have given.
//
// The code-to-lane map is the `k32` one, `col = 4*(lane%4) + (i&3)` with `col += 16`
// for the second register pair, because that is the instruction actually issued. The
// second half of K is the same map sixteen bytes along each row, which is why the
// loads below are the first half's offsets plus sixteen. Everything is exact in
// binary32 -- the codes are dyadic and their products are sums of powers of two -- so
// the split can only be exact too.
//
// weft reads both shapes, and `tools/mma_ref.py k64e2m1` still checks this kernel's
// output against a product over all sixty-four.
.version 8.8
.target sm_120a
.address_size 64

.visible .entry mmak64e2m1(
    .param .u64 mmak64e2m1_param_0,   // A: 16 x 64 fp4 codes, 32 bytes a row
    .param .u64 mmak64e2m1_param_1,   // Bt: 8 x 64 fp4 codes, 32 bytes a row
    .param .u64 mmak64e2m1_param_2    // D: 16 x 8 floats
)
{
    .reg .b32 %r<16>;
    .reg .b64 %rd<20>;
    .reg .f32 %f<12>;

    ld.param.u64 %rd1, [mmak64e2m1_param_0];
    ld.param.u64 %rd2, [mmak64e2m1_param_1];
    ld.param.u64 %rd3, [mmak64e2m1_param_2];

    mov.u32 %r1, %tid.x;
    shr.u32 %r2, %r1, 2;                // g
    and.b32 %r3, %r1, 3;                // t

    mul.wide.u32 %rd4, %r2, 32;         // 64 codes are 32 bytes a row
    mad.lo.s32 %r4, %r3, 2, 0;          // four codes a lane: 2t bytes
    mul.wide.u32 %rd6, %r4, 1;
    add.s64 %rd5, %rd1, %rd4;
    add.s64 %rd7, %rd5, %rd6;
    add.s64 %rd8, %rd2, %rd4;
    add.s64 %rd9, %rd8, %rd6;

    mov.f32 %f1, 0f00000000;
    mov.f32 %f2, 0f00000000;
    mov.f32 %f3, 0f00000000;
    mov.f32 %f4, 0f00000000;

    // the first thirty-two codes: cols 4t and 16+4t of the k32 map
    ld.global.b16 %r5, [%rd7];
    ld.global.b16 %r6, [%rd7+256];
    ld.global.b16 %r7, [%rd7+8];
    ld.global.b16 %r8, [%rd7+264];
    ld.global.b16 %r9, [%rd9];
    ld.global.b16 %r10, [%rd9+8];
    mma.sync.aligned.m16n8k32.row.col.f32.e2m1.e2m1.f32.kind::f8f6f4 {%f5,%f6,%f7,%f8}, {%r5,%r6,%r7,%r8}, {%r9,%r10}, {%f1,%f2,%f3,%f4};

    // the second thirty-two, sixteen bytes along each row, onto the same accumulators
    ld.global.b16 %r5, [%rd7+16];
    ld.global.b16 %r6, [%rd7+272];
    ld.global.b16 %r7, [%rd7+24];
    ld.global.b16 %r8, [%rd7+280];
    ld.global.b16 %r9, [%rd9+16];
    ld.global.b16 %r10, [%rd9+24];
    mma.sync.aligned.m16n8k32.row.col.f32.e2m1.e2m1.f32.kind::f8f6f4 {%f5,%f6,%f7,%f8}, {%r5,%r6,%r7,%r8}, {%r9,%r10}, {%f5,%f6,%f7,%f8};

    mad.lo.s32 %r11, %r3, 8, 0;
    mul.wide.u32 %rd10, %r2, 32;
    add.s64 %rd11, %rd3, %rd10;
    mul.wide.u32 %rd12, %r11, 1;
    add.s64 %rd13, %rd11, %rd12;
    st.global.f32 [%rd13], %f5;
    st.global.f32 [%rd13+4], %f6;
    st.global.f32 [%rd13+256], %f7;
    st.global.f32 [%rd13+260], %f8;
    ret;
}

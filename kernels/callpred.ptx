.version 8.6
.target sm_100
.address_size 64

// A predicated call to a function that waits. The call site records the predicate's
// value in a bit of its own, so the lane that parks inside the callee comes back
// asking whether the call was made rather than asking a register again. Lane i
// publishes v[i]+1, waits, then reads the lane after it: the answer is
// v[i] + v[next] + 2, and a re-entry that forgot the predicate would either skip the
// call or make it twice.
.visible .func (.param .b32 half) stallhalf(
    .param .u64 src
)
{
    .reg .b64 %rd<4>;
    .reg .b32 %r<7>;
    .reg .pred %p<2>;

    ld.param.u64 %rd1, [src];
    mov.u32 %r2, %tid.x;
    mul.wide.u32 %rd3, %r2, 4;
    add.u64 %rd1, %rd1, %rd3;

    ld.global.u32 %r1, [%rd1];
    add.u32 %r4, %r1, 1;
    st.global.u32 [%rd1], %r4;
    bar.sync 0;

    // The lane after this one, wrapping at the group size: element 0 for the last lane.
    mov.u32 %r1, %ntid.x;
    add.u32 %r5, %r2, 1;
    setp.eq.u32 %p1, %r5, %r1;
    @%p1 mov.u32 %r5, 0;
    mul.wide.u32 %rd3, %r5, 4;
    ld.param.u64 %rd1, [src];
    add.u64 %rd1, %rd1, %rd3;
    ld.global.u32 %r6, [%rd1];
    add.u32 %r4, %r4, %r6;
    st.param.b32 [half], %r4;
    ret;
}

.visible .entry callpred(
    .param .u64 in,
    .param .u64 out
)
{
    .reg .b64 %rd<4>;
    .reg .b32 %r<4>;
    .reg .pred %p<2>;

    ld.param.u64 %rd1, [in];
    ld.param.u64 %rd2, [out];
    mov.u32 %r1, %tid.x;
    mov.u32 %r3, %ntid.x;
    // Every lane of the group takes the call, which is what a barrier inside it needs.
    setp.lt.u32 %p1, %r1, %r3;
    @%p1 call.uni (%r2), stallhalf, (%rd1);
    mul.wide.u32 %rd3, %r1, 4;
    add.u64 %rd2, %rd2, %rd3;
    st.global.u32 [%rd2], %r2;
    ret;
}

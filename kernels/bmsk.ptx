.version 7.6
.target sm_70
.address_size 64
// bmsk is a run of bits, and every edge of it is a different answer: all ones, all but
// the top bit, a run in the middle, an empty run, an inverted one, the top bit alone, and
// a width that runs past the type. The 64-bit form is the same edges one size up, and
// ptxas has no `bmsk.b64`, so it is the mask formula written out: 2^hi-1 for the top of
// the run, everything above 2^lo-1 for the bottom, and the two ends clamped at 64.
.visible .entry bmsk(.param .u64 p0)
{
    .reg .b32 %r<16>;
    .reg .b32 %rs<4>;
    .reg .pred %ps<3>;
    .reg .b64 %rd<12>;
    ld.param.u64 %rd1, [p0];
    mov.b32 %r12, 0;
    mov.b32 %r13, 32;
    bmsk.clamp.b32 %r1, %r12, %r13;
    mov.b32 %r12, 0;
    mov.b32 %r13, 31;
    bmsk.clamp.b32 %r2, %r12, %r13;
    mov.b32 %r12, 5;
    mov.b32 %r13, 12;
    bmsk.clamp.b32 %r3, %r12, %r13;
    mov.b32 %r12, 7;
    mov.b32 %r13, 7;
    bmsk.clamp.b32 %r4, %r12, %r13;
    mov.b32 %r12, 9;
    mov.b32 %r13, 4;
    bmsk.clamp.b32 %r5, %r12, %r13;
    mov.b32 %r12, 31;
    mov.b32 %r13, 32;
    bmsk.clamp.b32 %r6, %r12, %r13;
    mov.b32 %r12, 0;
    mov.b32 %r13, 1;
    bmsk.clamp.b32 %r7, %r12, %r13;
    mov.b32 %r12, 24;
    mov.b32 %r13, 40;
    bmsk.clamp.b32 %r8, %r12, %r13;
    st.u32 [%rd1], %r1;
    st.u32 [%rd1+4], %r2;
    st.u32 [%rd1+8], %r3;
    st.u32 [%rd1+12], %r4;
    st.u32 [%rd1+16], %r5;
    st.u32 [%rd1+20], %r6;
    st.u32 [%rd1+24], %r7;
    st.u32 [%rd1+28], %r8;
    mov.b64 %rd7, 0;
    mov.b64 %rd8, 64;
    cvt.u32.u64 %rs0, %rd8;
    cvt.u32.u64 %rs1, %rd7;
    mov.u32 %rs2, 63;
    min.u32 %rs2, %rs0, %rs2;
    mov.b64 %rd11, 1;
    shl.b64 %rd9, %rd11, %rs2;
    sub.u64 %rd9, %rd9, 1;
    setp.ge.u32 %ps1, %rs0, 64;
    selp.b64 %rd9, 0xFFFFFFFFFFFFFFFF, %rd9, %ps1;
    mov.u32 %rs3, 63;
    min.u32 %rs3, %rs1, %rs3;
    mov.b64 %rd11, 1;
    shl.b64 %rd10, %rd11, %rs3;
    sub.u64 %rd10, %rd10, 1;
    setp.ge.u32 %ps2, %rs1, 64;
    selp.b64 %rd10, 0xFFFFFFFFFFFFFFFF, %rd10, %ps2;
    not.b64 %rd10, %rd10;
    and.b64 %rd2, %rd9, %rd10;
    mov.b64 %rd7, 32;
    mov.b64 %rd8, 64;
    cvt.u32.u64 %rs0, %rd8;
    cvt.u32.u64 %rs1, %rd7;
    mov.u32 %rs2, 63;
    min.u32 %rs2, %rs0, %rs2;
    mov.b64 %rd11, 1;
    shl.b64 %rd9, %rd11, %rs2;
    sub.u64 %rd9, %rd9, 1;
    setp.ge.u32 %ps1, %rs0, 64;
    selp.b64 %rd9, 0xFFFFFFFFFFFFFFFF, %rd9, %ps1;
    mov.u32 %rs3, 63;
    min.u32 %rs3, %rs1, %rs3;
    mov.b64 %rd11, 1;
    shl.b64 %rd10, %rd11, %rs3;
    sub.u64 %rd10, %rd10, 1;
    setp.ge.u32 %ps2, %rs1, 64;
    selp.b64 %rd10, 0xFFFFFFFFFFFFFFFF, %rd10, %ps2;
    not.b64 %rd10, %rd10;
    and.b64 %rd3, %rd9, %rd10;
    mov.b64 %rd7, 5;
    mov.b64 %rd8, 40;
    cvt.u32.u64 %rs0, %rd8;
    cvt.u32.u64 %rs1, %rd7;
    mov.u32 %rs2, 63;
    min.u32 %rs2, %rs0, %rs2;
    mov.b64 %rd11, 1;
    shl.b64 %rd9, %rd11, %rs2;
    sub.u64 %rd9, %rd9, 1;
    setp.ge.u32 %ps1, %rs0, 64;
    selp.b64 %rd9, 0xFFFFFFFFFFFFFFFF, %rd9, %ps1;
    mov.u32 %rs3, 63;
    min.u32 %rs3, %rs1, %rs3;
    mov.b64 %rd11, 1;
    shl.b64 %rd10, %rd11, %rs3;
    sub.u64 %rd10, %rd10, 1;
    setp.ge.u32 %ps2, %rs1, 64;
    selp.b64 %rd10, 0xFFFFFFFFFFFFFFFF, %rd10, %ps2;
    not.b64 %rd10, %rd10;
    and.b64 %rd4, %rd9, %rd10;
    mov.b64 %rd7, 63;
    mov.b64 %rd8, 64;
    cvt.u32.u64 %rs0, %rd8;
    cvt.u32.u64 %rs1, %rd7;
    mov.u32 %rs2, 63;
    min.u32 %rs2, %rs0, %rs2;
    mov.b64 %rd11, 1;
    shl.b64 %rd9, %rd11, %rs2;
    sub.u64 %rd9, %rd9, 1;
    setp.ge.u32 %ps1, %rs0, 64;
    selp.b64 %rd9, 0xFFFFFFFFFFFFFFFF, %rd9, %ps1;
    mov.u32 %rs3, 63;
    min.u32 %rs3, %rs1, %rs3;
    mov.b64 %rd11, 1;
    shl.b64 %rd10, %rd11, %rs3;
    sub.u64 %rd10, %rd10, 1;
    setp.ge.u32 %ps2, %rs1, 64;
    selp.b64 %rd10, 0xFFFFFFFFFFFFFFFF, %rd10, %ps2;
    not.b64 %rd10, %rd10;
    and.b64 %rd5, %rd9, %rd10;
    mov.b64 %rd7, 40;
    mov.b64 %rd8, 30;
    cvt.u32.u64 %rs0, %rd8;
    cvt.u32.u64 %rs1, %rd7;
    mov.u32 %rs2, 63;
    min.u32 %rs2, %rs0, %rs2;
    mov.b64 %rd11, 1;
    shl.b64 %rd9, %rd11, %rs2;
    sub.u64 %rd9, %rd9, 1;
    setp.ge.u32 %ps1, %rs0, 64;
    selp.b64 %rd9, 0xFFFFFFFFFFFFFFFF, %rd9, %ps1;
    mov.u32 %rs3, 63;
    min.u32 %rs3, %rs1, %rs3;
    mov.b64 %rd11, 1;
    shl.b64 %rd10, %rd11, %rs3;
    sub.u64 %rd10, %rd10, 1;
    setp.ge.u32 %ps2, %rs1, 64;
    selp.b64 %rd10, 0xFFFFFFFFFFFFFFFF, %rd10, %ps2;
    not.b64 %rd10, %rd10;
    and.b64 %rd6, %rd9, %rd10;
    st.u64 [%rd1+32], %rd2;
    st.u64 [%rd1+40], %rd3;
    st.u64 [%rd1+48], %rd4;
    st.u64 [%rd1+56], %rd5;
    st.u64 [%rd1+64], %rd6;
    mov.b32 %r12, 0;
    mov.b32 %r13, 33;
    bmsk.clamp.b32 %r9, %r12, %r13;
    st.u32 [%rd1+72], %r9;
    ret;
}

// atom.cas.b16: table 41 of the isa gives the 16-bit width exactly one atomic, a
// compare-exchange, and this host's atomics are 32 bits. So the half addressed is
// compared and written on its own, and the half beside it keeps its value. The buffer
// starts as 1.0 above 0.5, both non-zero, so a translation that wrote the whole word
// would show up as the wrong high half rather than as a zero nobody notices.
//
//   casb16      compare 1.0 matches: the low half becomes 2.0, the high half stays
//               0.5, and the half the slot held before comes back in buffer 1
//   casb16miss  compare 4.0 does not match: nothing is written, the old half returns
//   casb16race  eight lanes all compare 1.0 and swap in 2.0: the first match writes,
//               the rest see 2.0 and leave it alone, so the answer is order-free
.version 7.0
.target sm_80
.address_size 64

.visible .entry casb16(
    .param .u64 casb16_param_0,     // in/out: two halves in one word
    .param .u64 casb16_param_1      // out: the half the slot held before
)
{
    .reg .b16 %hs<4>;
    .reg .b32 %r<4>;
    .reg .b64 %rd<8>;

    ld.param.u64 %rd1, [casb16_param_0];
    ld.param.u64 %rd2, [casb16_param_1];
    mov.u32 %r1, %tid.x;
    mul.wide.u32 %rd3, %r1, 4;
    add.u64 %rd5, %rd2, %rd3;

    mov.b16 %hs1, 0x3C00;     // compare 1.0
    mov.b16 %hs2, 0x4000;     // swap in 2.0
    atom.global.cas.b16 %hs3, [%rd1], %hs1, %hs2;
    cvt.u32.u16 %r3, %hs3;
    st.global.b32 [%rd5], %r3;
    ret;
}

.visible .entry casb16miss(
    .param .u64 casb16miss_param_0,
    .param .u64 casb16miss_param_1
)
{
    .reg .b16 %hs<4>;
    .reg .b32 %r<4>;
    .reg .b64 %rd<8>;

    ld.param.u64 %rd1, [casb16miss_param_0];
    ld.param.u64 %rd2, [casb16miss_param_1];
    mov.u32 %r1, %tid.x;
    mul.wide.u32 %rd3, %r1, 4;
    add.u64 %rd5, %rd2, %rd3;

    mov.b16 %hs1, 0x4400;     // compare 4.0, which is not what is there
    mov.b16 %hs2, 0x4000;     // swap in 2.0 if it were
    atom.global.cas.b16 %hs3, [%rd1], %hs1, %hs2;
    cvt.u32.u16 %r3, %hs3;
    st.global.b32 [%rd5], %r3;
    ret;
}

.visible .entry casb16race(
    .param .u64 casb16race_param_0
)
{
    .reg .b16 %hs<4>;
    .reg .b64 %rd<2>;

    ld.param.u64 %rd1, [casb16race_param_0];
    mov.b16 %hs1, 0x3C00;
    mov.b16 %hs2, 0x4000;
    atom.global.cas.b16 %hs3, [%rd1], %hs1, %hs2;
    ret;
}

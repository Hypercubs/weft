// multimem: one address, whose value every replica of a multicast mapping holds.
//
// This runtime binds one replica, so a reduce across the replicas of a value is that
// value, whatever the operation: add, min and max all fold a single operand. A
// multicast store writes the one copy there is. The three kernels therefore answer
// the input unchanged, which is the only thing a single replica can show -- and it is
// exactly what a wrong translation (a dropped store, a reduce of nothing) breaks.
//
//   mmld   multimem.ld_reduce.global.add.u32   the value, as an add of one
//   mmmin  multimem.ld_reduce.global.min.u32   the value, as a min of one
//   mmst   multimem.st.global.u32              the same bytes land at the address
.version 8.1
.target sm_90
.address_size 64

.visible .entry mmld(.param .u64 p_in, .param .u64 p_out)
{
  .reg .b32 %r<3>;
  .reg .b64 %rd<4>;
  ld.param.u64 %rd1, [p_in];
  ld.param.u64 %rd2, [p_out];
  mov.u32 %r1, %tid.x;
  mul.wide.u32 %rd3, %r1, 4;
  add.u64 %rd3, %rd1, %rd3;
  multimem.ld_reduce.global.add.u32 %r2, [%rd3];
  sub.u64 %rd3, %rd3, %rd1;
  add.u64 %rd3, %rd2, %rd3;
  st.global.u32 [%rd3], %r2;
  ret;
}

.visible .entry mmmin(.param .u64 p_in, .param .u64 p_out)
{
  .reg .b32 %r<3>;
  .reg .b64 %rd<4>;
  ld.param.u64 %rd1, [p_in];
  ld.param.u64 %rd2, [p_out];
  mov.u32 %r1, %tid.x;
  mul.wide.u32 %rd3, %r1, 4;
  add.u64 %rd3, %rd1, %rd3;
  multimem.ld_reduce.global.min.u32 %r2, [%rd3];
  sub.u64 %rd3, %rd3, %rd1;
  add.u64 %rd3, %rd2, %rd3;
  st.global.u32 [%rd3], %r2;
  ret;
}

.visible .entry mmst(.param .u64 p_in, .param .u64 p_out)
{
  .reg .b32 %r<3>;
  .reg .b64 %rd<4>;
  ld.param.u64 %rd1, [p_in];
  ld.param.u64 %rd2, [p_out];
  mov.u32 %r1, %tid.x;
  mul.wide.u32 %rd3, %r1, 4;
  add.u64 %rd3, %rd1, %rd3;
  ld.global.u32 %r2, [%rd3];
  sub.u64 %rd3, %rd3, %rd1;
  add.u64 %rd3, %rd2, %rd3;
  multimem.st.global.u32 [%rd3], %r2;
  ret;
}

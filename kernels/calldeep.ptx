.version 8.6
.target sm_100
.address_size 64

// A function that calls itself and then uses the result, so each call keeps a frame.
// It adds n down to zero into one word, through four frames, and the answer is 10.
.visible .func step(
    .param .u64 acc,
    .param .u32 n
)
{
    .reg .b64 %rd<2>;
    .reg .b32 %r<4>;
    .reg .pred %p<2>;

    ld.param.u64 %rd1, [acc];
    ld.param.u32 %r1, [n];
    setp.eq.u32 %p1, %r1, 0;
    @%p1 ret;

    sub.u32 %r3, %r1, 1;
    call.uni step, (%rd1, %r3);
    ld.global.u32 %r2, [%rd1];
    add.u32 %r2, %r2, %r1;
    st.global.u32 [%rd1], %r2;
    ret;
}

.visible .entry calldeep(
    .param .u64 in
)
{
    .reg .b64 %rd<2>;
    .reg .b32 %r<2>;

    ld.param.u64 %rd1, [in];
    mov.u32 %r1, 0;
    st.global.u32 [%rd1], %r1;
    mov.u32 %r1, 4;
    call.uni step, (%rd1, %r1);
    ret;
}

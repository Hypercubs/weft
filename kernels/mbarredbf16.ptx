// `cp.reduce.async.bulk` with bfloat16 elements, which the ISA requires in the
// `.noftz` form for the 16-bit types. Eight bf16 counters 1..8 with 0.5, 1, ... 4
// added give 1.5, 3, 4.5, 6, 7.5, 9, 10.5, 12, every one exact in a bf16, since a
// bf16 holds eight significand bits and each of these needs three.
//
// The elements are written two to a word, which is how a tile is filled in
// practice, and the reduction walks eight elements of two bytes rather than four
// of four: a reduce that kept the 32-bit width would add (1,2) to (0.5,1) as one
// number and land nowhere near these.
.version 7.0
.target sm_90
.address_size 64

.visible .entry mbarredbf16(
    .param .u64 mbarredbf16_param_0,   // the eight bf16 counters
    .param .u64 mbarredbf16_param_1    // the same four words, copied out
)
{
    .shared .align 16 .b32 tile[4];

    .reg .b32 %r<6>;
    .reg .b64 %rd<4>;

    ld.param.u64 %rd1, [mbarredbf16_param_0];
    ld.param.u64 %rd2, [mbarredbf16_param_1];

    // 1, 2 then 3, 4 then 5, 6 then 7, 8
    mov.u32 %r1, 0x40003F80;
    st.global.u32 [%rd1], %r1;
    mov.u32 %r1, 0x40804040;
    st.global.u32 [%rd1+4], %r1;
    mov.u32 %r1, 0x40C040A0;
    st.global.u32 [%rd1+8], %r1;
    mov.u32 %r1, 0x410040E0;
    st.global.u32 [%rd1+12], %r1;

    // 0.5, 1 then 1.5, 2 then 2.5, 3 then 3.5, 4
    mov.u32 %r2, 0x3F803F00;
    st.shared.u32 [tile], %r2;
    mov.u32 %r2, 0x40003FC0;
    st.shared.u32 [tile + 4], %r2;
    mov.u32 %r2, 0x40404020;
    st.shared.u32 [tile + 8], %r2;
    mov.u32 %r2, 0x40804060;
    st.shared.u32 [tile + 12], %r2;
    bar.sync 0;

    cp.reduce.async.bulk.global.shared::cta.bulk_group.add.noftz.bf16 [%rd1], [tile], 16;
    cp.async.bulk.commit_group;
    cp.async.bulk.wait_group 0;

    ld.global.u32 %r3, [%rd1];
    st.global.u32 [%rd2], %r3;
    ld.global.u32 %r3, [%rd1+4];
    st.global.u32 [%rd2+4], %r3;
    ld.global.u32 %r3, [%rd1+8];
    st.global.u32 [%rd2+8], %r3;
    ld.global.u32 %r3, [%rd1+12];
    st.global.u32 [%rd2+12], %r3;
    ret;
}

// Hand-written PTX for `lop3` (an arbitrary three-input bitwise function) and
// the `testp` floating-point class tests. LLVM 23 emits neither at -O2, so these
// are the two instructions only hand-written PTX contains — which is exactly why
// they are worth a kernel. The Metal kernel `logic` computes the same numbers
// from the definitions and check.sh compares the two byte for byte.
//
// The eight class tests are constants on purpose: each one is a different class,
// and their weighted sum is 63 if and only if all eight answers are right.
.version 7.0
.target sm_70
.address_size 64

.visible .entry logic(
    .param .u64 logic_param_0,
    .param .u64 logic_param_1
)
{
    .reg .b32 %r<17>;
    .reg .b64 %rd<6>;
    .reg .f32 %f<4>;
    .reg .pred %p<12>;

    ld.param.u64 %rd1, [logic_param_0];
    ld.param.u64 %rd2, [logic_param_1];

    mov.u32 %r1, %tid.x;
    mov.u32 %r2, %ctaid.x;
    mov.u32 %r3, %ntid.x;
    mul.lo.s32 %r4, %r2, %r3;
    add.s32 %r5, %r4, %r1;
    mov.u32 %r6, %nctaid.x;
    mul.lo.s32 %r7, %r6, %r3;
    setp.ge.s32 %p1, %r5, %r7;
    @%p1 bra.uni DONE;

    mul.lo.s32 %r8, %r5, 4;
    cvt.u64.u32 %rd3, %r8;
    add.u64 %rd4, %rd1, %rd3;
    ld.global.f32 %f1, [%rd4];

    // a, b, c from the input, so the truth table runs on real bits
    mul.f32 %f2, %f1, 0f447A0000;
    cvt.rzi.s32.f32 %r9, %f2;
    mul.lo.s32 %r10, %r9, -1640531535;   // a
    shr.u32 %r11, %r10, 13;              // b
    xor.b32 %r12, %r10, 305419896;       // c

    // 0x96 is a^b^c, 0xE8 is the majority of a, b and c
    lop3.b32 %r13, %r10, %r11, %r12, 0x96;
    lop3.b32 %r14, %r10, %r11, %r12, 0xE8;

    // one test per class: 1.0, +inf, NaN, 1.0, the smallest subnormal, +inf,
    // that subnormal again (not normal), and +inf (not finite)
    testp.finite.f32 %p2, 0f3F800000;
    testp.infinite.f32 %p3, 0f7F800000;
    testp.nan.f32 %p4, 0f7FC00000;
    testp.normal.f32 %p5, 0f3F800000;
    testp.subnormal.f32 %p6, 0f00000001;
    testp.number.f32 %p7, 0f7F800000;
    testp.normal.f32 %p8, 0f00000001;
    testp.finite.f32 %p9, 0f7F800000;

    selp.b32 %r15, 1, 0, %p2;
    selp.b32 %r16, 2, 0, %p3;
    add.s32 %r15, %r15, %r16;
    selp.b32 %r16, 4, 0, %p4;
    add.s32 %r15, %r15, %r16;
    selp.b32 %r16, 8, 0, %p5;
    add.s32 %r15, %r15, %r16;
    selp.b32 %r16, 16, 0, %p6;
    add.s32 %r15, %r15, %r16;
    selp.b32 %r16, 32, 0, %p7;
    add.s32 %r15, %r15, %r16;
    selp.b32 %r16, 64, 0, %p8;
    add.s32 %r15, %r15, %r16;
    selp.b32 %r16, 128, 0, %p9;
    add.s32 %r15, %r15, %r16;

    add.s32 %r13, %r13, %r14;
    add.s32 %r13, %r13, %r15;

    add.u64 %rd5, %rd2, %rd3;
    st.global.b32 [%rd5], %r13;

DONE:
    ret;
}

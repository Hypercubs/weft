.version 7.2
.target sm_86
.address_size 64
// min/max.xorsign.abs answers the magnitude of the comparison with the exclusive or of
// the two signs on top, which is not the plain comparison: `min.xorsign.abs(-1, 2)` is
// -1 because the magnitudes compared are 1 and 2, and `min(-1, 2)` is also -1 for a
// different reason, so the rows that tell them apart are the ones where the signs differ
// the other way. The doubles are the plain form, where the canonical NaN is 0x7ff8... and
// -0.0 is below +0.0.
.visible .entry fxorabs(.param .u64 p0)
{
    .reg .b32 %r<8>;
    .reg .b64 %rd<6>;
    .reg .f32 %f<8>;
    .reg .f64 %fd<6>;
    ld.param.u64 %rd1, [p0];
    mov.b32 %f1, 0xBF800000;
    mov.b32 %f2, 0x40000000;
    min.xorsign.abs.f32 %f3, %f1, %f2;
    mov.b32 %r3, %f3;
    st.u32 [%rd1+0], %r3;
    mov.b32 %f1, 0x3F800000;
    mov.b32 %f2, 0xC0000000;
    min.xorsign.abs.f32 %f3, %f1, %f2;
    mov.b32 %r3, %f3;
    st.u32 [%rd1+4], %r3;
    mov.b32 %f1, 0xC0400000;
    mov.b32 %f2, 0xC0000000;
    min.xorsign.abs.f32 %f3, %f1, %f2;
    mov.b32 %r3, %f3;
    st.u32 [%rd1+8], %r3;
    mov.b32 %f1, 0xC0400000;
    mov.b32 %f2, 0x40000000;
    max.xorsign.abs.f32 %f3, %f1, %f2;
    mov.b32 %r3, %f3;
    st.u32 [%rd1+12], %r3;
    mov.b32 %f1, 0x3F800000;
    mov.b32 %f2, 0xC0800000;
    max.xorsign.abs.f32 %f3, %f1, %f2;
    mov.b32 %r3, %f3;
    st.u32 [%rd1+16], %r3;
    mov.b32 %f1, 0x7FC00000;
    mov.b32 %f2, 0x40000000;
    min.xorsign.abs.f32 %f3, %f1, %f2;
    mov.b32 %r3, %f3;
    st.u32 [%rd1+20], %r3;
    mov.b32 %f1, 0x40000000;
    mov.b32 %f2, 0x7FC00000;
    min.xorsign.abs.f32 %f3, %f1, %f2;
    mov.b32 %r3, %f3;
    st.u32 [%rd1+24], %r3;
    mov.b32 %f1, 0x80000000;
    mov.b32 %f2, 0x00000000;
    min.xorsign.abs.f32 %f3, %f1, %f2;
    mov.b32 %r3, %f3;
    st.u32 [%rd1+28], %r3;
    mov.b32 %f1, 0x00000000;
    mov.b32 %f2, 0x80000000;
    max.xorsign.abs.f32 %f3, %f1, %f2;
    mov.b32 %r3, %f3;
    st.u32 [%rd1+32], %r3;
    mov.b32 %f1, 0x7F800000;
    mov.b32 %f2, 0x3F800000;
    min.xorsign.abs.f32 %f3, %f1, %f2;
    mov.b32 %r3, %f3;
    st.u32 [%rd1+36], %r3;
    // the plain double form: minNum/maxNum, and two NaNs answer the canonical 0x7ff8...
    mov.b64 %fd1, 0x7FF8000000000000;
    mov.b64 %fd2, 0x3FF0000000000000;
    min.f64 %fd3, %fd1, %fd2;
    mov.b64 %rd2, %fd3;
    st.u64 [%rd1+40], %rd2;
    mov.b64 %fd1, 0x3FF0000000000000;
    mov.b64 %fd2, 0x7FF8000000000000;
    max.f64 %fd3, %fd1, %fd2;
    mov.b64 %rd2, %fd3;
    st.u64 [%rd1+48], %rd2;
    mov.b64 %fd1, 0x7FF8000000000000;
    mov.b64 %fd2, 0x7FF8000000000001;
    min.f64 %fd3, %fd1, %fd2;
    mov.b64 %rd2, %fd3;
    st.u64 [%rd1+56], %rd2;
    mov.b64 %fd1, 0x8000000000000000;
    mov.b64 %fd2, 0x0000000000000000;
    max.f64 %fd3, %fd1, %fd2;
    mov.b64 %rd2, %fd3;
    st.u64 [%rd1+64], %rd2;
    mov.b64 %fd1, 0x8000000000000000;
    mov.b64 %fd2, 0x0000000000000000;
    min.f64 %fd3, %fd1, %fd2;
    mov.b64 %rd2, %fd3;
    st.u64 [%rd1+72], %rd2;
    // a zero immediate through a double register: `0x0` is an int, so the bitcast has to
    // zero the whole destination rather than read the four bytes after the literal
    mov.b64 %fd1, 0x0;
    mov.b64 %rd2, %fd1;
    st.u64 [%rd1+80], %rd2;
    mov.b64 %fd1, 0x0000000000000000;
    mov.b64 %rd2, %fd1;
    st.u64 [%rd1+88], %rd2;
    // the sign operations on a double are bit operations on the software double: the
    // copysign keeps a NaN's payload, and abs clears the sign of one
    mov.b64 %fd1, 0x3FF0000000000000;
    mov.b64 %fd2, 0x8000000000000000;
    copysign.f64 %fd3, %fd1, %fd2;
    mov.b64 %rd2, %fd3;
    st.u64 [%rd1+96], %rd2;
    mov.b64 %fd1, 0x7FF8000000000001;
    mov.b64 %fd2, 0x8000000000000000;
    copysign.f64 %fd3, %fd1, %fd2;
    mov.b64 %rd2, %fd3;
    st.u64 [%rd1+104], %rd2;
    mov.b64 %fd1, 0x8000000000000000;
    abs.f64 %fd2, %fd1;
    mov.b64 %rd2, %fd2;
    st.u64 [%rd1+112], %rd2;
    mov.b64 %fd1, 0x0000000000000000;
    neg.f64 %fd2, %fd1;
    mov.b64 %rd2, %fd2;
    st.u64 [%rd1+120], %rd2;
    mov.b64 %fd1, 0xFFF8000000000001;
    abs.f64 %fd2, %fd1;
    mov.b64 %rd2, %fd2;
    st.u64 [%rd1+128], %rd2;
    ret;
}

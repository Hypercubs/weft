.version 7.0
.target sm_70
.address_size 64
// A carry chain is how a wide integer addition is spelled: `add.cc` writes the flag,
// `addc` reads it and writes the next one, and the words that come out are the sum.
// Each pair below is one chain: one that carries out of the top, one that does not, a
// subtraction that borrows, and the low word of a product with the flag folded in.
.visible .entry carry(.param .u64 p0)
{
    .reg .b32 %r<24>;
    .reg .b64 %rd<10>;
    ld.param.u64 %rd1, [p0];
    // 0xFFFFFFFF + 1 is zero and carries, and the carry is what the next word adds.
    mov.u32 %r1, 0xFFFFFFFF;
    mov.u32 %r2, 1;
    add.cc.u32 %r3, %r1, %r2;
    addc.u32 %r4, %r2, %r2;
    st.u32 [%rd1], %r3;
    st.u32 [%rd1+4], %r4;
    // 5 + 7 does not carry, so the next word adds nothing.
    mov.u32 %r5, 5;
    mov.u32 %r6, 7;
    add.cc.u32 %r7, %r5, %r6;
    addc.u32 %r8, %r5, %r5;
    st.u32 [%rd1+8], %r7;
    st.u32 [%rd1+12], %r8;
    // 1 - 3 borrows, and the borrow is subtracted from the next word.
    mov.u32 %r9, 1;
    mov.u32 %r10, 3;
    sub.cc.u32 %r11, %r9, %r10;
    subc.u32 %r12, %r10, %r9;
    st.u32 [%rd1+16], %r11;
    st.u32 [%rd1+20], %r12;
    // The low word of 3*5 plus 7, with a carry-in of one: 15 + 7 + 1 is 23.
    mov.u32 %r13, 3;
    mov.u32 %r14, 5;
    mov.u32 %r15, 7;
    add.cc.u32 %r16, %r1, %r2;
    madc.lo.cc.u32 %r17, %r13, %r14, %r15;
    st.u32 [%rd1+24], %r17;
    // 0xFFFFFFFF + 0xFFFFFFFF carries, and the word after it takes that carry and
    // wraps out of the top again, so the flag survives a second write.
    mov.u32 %r20, 0xFFFFFFFF;
    mov.u32 %r21, 0xFFFFFFFF;
    add.cc.u32 %r22, %r20, %r21;
    addc.cc.u32 %r23, %r20, %r20;
    st.u32 [%rd1+28], %r23;
    // The same two chains one size up, where a 32-bit flag cannot stand in.
    mov.b64 %rd2, 0xFFFFFFFFFFFFFFFF;
    mov.b64 %rd3, 1;
    add.cc.u64 %rd4, %rd2, %rd3;
    addc.cc.u64 %rd5, %rd2, %rd2;
    st.u64 [%rd1+32], %rd4;
    st.u64 [%rd1+40], %rd5;
    mov.b64 %rd6, 0;
    mov.b64 %rd7, 0x8000000000000000;
    sub.cc.u64 %rd8, %rd6, %rd7;
    subc.u64 %rd9, %rd7, %rd6;
    st.u64 [%rd1+48], %rd8;
    st.u64 [%rd1+56], %rd9;
    ret;
}

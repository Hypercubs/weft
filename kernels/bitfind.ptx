// Bit scans, and a half register declared as `.reg .f16`.
//
//   bfindu   bfind.u32: the highest set bit, counted from 0, and 0xFFFFFFFF when
//            there is none. An input of 0 has to answer 0xFFFFFFFF and an input of
//            1 has to answer 0, so a translation that used the count of leading
//            zeros answers 32 and 31 instead.
//   bfinds   bfind.s32: the highest bit that differs from the sign, so -1 and 0
//            have none and -2 has bit 0. A translation that read the register as
//            unsigned answers 31 for -1 rather than 0xFFFFFFFF.
//   fns3     fns.b32 with base 0 and offset 2: the third set bit from bit 0.
//   fnsbase  the same masks with base 4 and offset 1: the second set bit at or
//            above bit 4, so a table that ignored the base lands on a lower bit.
//   f16reg   `.reg .f16 %h<4>` and `add.rn.f16`: a half register is the 16 bits
//            `.b16` names, and doubling a half is exact until it overflows.
.version 7.0
.target sm_70
.address_size 64

.visible .entry bfindu(.param .u64 p_in, .param .u64 p_out)
{
  .reg .b32 %r<4>;
  .reg .b64 %rd<5>;
  ld.param.u64 %rd1, [p_in];
  ld.param.u64 %rd2, [p_out];
  mov.u32 %r1, %tid.x;
  cvt.u64.u32 %rd3, %r1;
  shl.b64 %rd3, %rd3, 2;
  add.s64 %rd3, %rd1, %rd3;
  ld.global.u32 %r1, [%rd3];
  bfind.u32 %r2, %r1;
  mov.u32 %r3, %tid.x;
  cvt.u64.u32 %rd4, %r3;
  shl.b64 %rd4, %rd4, 2;
  add.s64 %rd4, %rd2, %rd4;
  st.global.u32 [%rd4], %r2;
  ret;
}

.visible .entry bfinds(.param .u64 p_in, .param .u64 p_out)
{
  .reg .b32 %r<4>;
  .reg .b64 %rd<5>;
  ld.param.u64 %rd1, [p_in];
  ld.param.u64 %rd2, [p_out];
  mov.u32 %r1, %tid.x;
  cvt.u64.u32 %rd3, %r1;
  shl.b64 %rd3, %rd3, 2;
  add.s64 %rd3, %rd1, %rd3;
  ld.global.u32 %r1, [%rd3];
  bfind.s32 %r2, %r1;
  mov.u32 %r3, %tid.x;
  cvt.u64.u32 %rd4, %r3;
  shl.b64 %rd4, %rd4, 2;
  add.s64 %rd4, %rd2, %rd4;
  st.global.u32 [%rd4], %r2;
  ret;
}

.visible .entry fns3(.param .u64 p_in, .param .u64 p_out)
{
  .reg .b32 %r<5>;
  .reg .b64 %rd<5>;
  ld.param.u64 %rd1, [p_in];
  ld.param.u64 %rd2, [p_out];
  mov.u32 %r1, %tid.x;
  cvt.u64.u32 %rd3, %r1;
  shl.b64 %rd3, %rd3, 2;
  add.s64 %rd3, %rd1, %rd3;
  ld.global.u32 %r1, [%rd3];
  fns.b32 %r2, %r1, 0, 2;
  mov.u32 %r3, %tid.x;
  cvt.u64.u32 %rd4, %r3;
  shl.b64 %rd4, %rd4, 2;
  add.s64 %rd4, %rd2, %rd4;
  st.global.u32 [%rd4], %r2;
  ret;
}

.visible .entry fnsbase(.param .u64 p_in, .param .u64 p_out)
{
  .reg .b32 %r<5>;
  .reg .b64 %rd<5>;
  ld.param.u64 %rd1, [p_in];
  ld.param.u64 %rd2, [p_out];
  mov.u32 %r1, %tid.x;
  cvt.u64.u32 %rd3, %r1;
  shl.b64 %rd3, %rd3, 2;
  add.s64 %rd3, %rd1, %rd3;
  ld.global.u32 %r1, [%rd3];
  fns.b32 %r2, %r1, 4, 1;
  mov.u32 %r3, %tid.x;
  cvt.u64.u32 %rd4, %r3;
  shl.b64 %rd4, %rd4, 2;
  add.s64 %rd4, %rd2, %rd4;
  st.global.u32 [%rd4], %r2;
  ret;
}

.visible .entry f16reg(.param .u64 p_in, .param .u64 p_out)
{
  .reg .f16 %h<4>;
  .reg .b32 %r<4>;
  .reg .b64 %rd<8>;
  ld.param.u64 %rd1, [p_in];
  ld.param.u64 %rd2, [p_out];
  mov.u32 %r1, %tid.x;
  mul.wide.u32 %rd3, %r1, 2;
  add.u64 %rd4, %rd1, %rd3;
  ld.global.b16 %h1, [%rd4];
  mul.wide.u32 %rd5, %r1, 2;
  add.u64 %rd6, %rd2, %rd5;
  add.rn.f16 %h2, %h1, %h1;
  st.global.b16 [%rd6], %h2;
  ret;
}

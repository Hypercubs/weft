// Two threadgroup arrays in one kernel. They are separate objects: `ta` starts at
// offset 0 of the group's shared window and `tb` at 256, so the second tile must
// not overwrite the first. The Metal twin of this kernel is `twotile` in
// basic.metal, and the two must agree byte for byte.
//
//   threadgroup float ta[64], tb[64];
//   ta[i] = in[gid];  tb[i] = in[gid] * 2;
//   threadgroup_barrier(mem_threadgroup);
//   out[gid] = ta[(i + 1) & 63] + tb[(i + 3) & 63];
.version 7.0
.target sm_70
.address_size 64

.visible .entry twotile(
    .param .u64 twotile_param_0,
    .param .u64 twotile_param_1
)
{
    .reg .b32 %r<16>;
    .reg .f32 %f<8>;
    .reg .b64 %rd<8>;
    .shared .align 4 .b8 ta[256];
    .shared .align 4 .b8 tb[256];

    ld.param.u64 %rd1, [twotile_param_0];
    ld.param.u64 %rd2, [twotile_param_1];

    mov.u32 %r1, %tid.x;
    mov.u32 %r2, %ctaid.x;
    mov.u32 %r3, %ntid.x;

    mul.lo.s32 %r4, %r2, %r3;
    add.s32 %r5, %r4, %r1;      // gid
    mul.lo.s32 %r6, %r5, 4;
    cvt.u64.u32 %rd3, %r6;
    add.u64 %rd4, %rd1, %rd3;
    ld.global.f32 %f1, [%rd4];

    and.b32 %r7, %r1, 63;       // i = lid & 63
    mul.lo.s32 %r8, %r7, 4;
    st.shared.f32 [%r8], %f1;          // ta[i]
    mul.f32 %f2, %f1, 0f40000000;
    st.shared.f32 [%r8+256], %f2;      // tb[i]

    bar.sync 0;

    add.s32 %r9, %r7, 1;
    and.b32 %r10, %r9, 63;
    mul.lo.s32 %r11, %r10, 4;
    ld.shared.f32 %f3, [%r11];         // ta[(i + 1) & 63]

    add.s32 %r12, %r7, 3;
    and.b32 %r13, %r12, 63;
    mul.lo.s32 %r14, %r13, 4;
    ld.shared.f32 %f4, [%r14+256];     // tb[(i + 3) & 63]

    add.f32 %f5, %f3, %f4;
    add.u64 %rd5, %rd2, %rd3;
    st.global.f32 [%rd5], %f5;
    ret;
}

; `lgamma_r` (OpenCL.std 36): the same logarithm, and the sign of gamma written through
; the pointer the instruction carries.
;   buffer 0: one argument per lane
;   buffer 1: ln|Gamma| of it
;   buffer 2: the sign gamma had, as an int
               OpCapability Kernel
               OpCapability Addresses
               OpCapability Int64
       %ocl = OpExtInstImport "OpenCL.std"
               OpMemoryModel Physical64 OpenCL
               OpEntryPoint Kernel %main "lgammar" %gid
               OpName %main "lgammar"
               OpDecorate %gid BuiltIn GlobalInvocationId
      %void = OpTypeVoid
       %u64 = OpTypeInt 64 0
       %i32 = OpTypeInt 32 0
       %f32 = OpTypeFloat 32
      %f32p = OpTypePointer CrossWorkgroup %f32
      %i32p = OpTypePointer CrossWorkgroup %i32
    %v3u64 = OpTypeVector %u64 3
       %pin = OpTypePointer Input %v3u64
      %fnty = OpTypeFunction %void %f32p %f32p %i32p
       %gid = OpVariable %pin Input
       %main = OpFunction %void None %fnty
         %a0 = OpFunctionParameter %f32p
         %a1 = OpFunctionParameter %f32p
         %a2 = OpFunctionParameter %i32p
      %entry = OpLabel
          %g = OpLoad %v3u64 %gid
         %gi = OpCompositeExtract %u64 %g 0
        %pa = OpPtrAccessChain %f32p %a0 %gi
        %vv = OpLoad %f32 %pa
         %ps = OpPtrAccessChain %i32p %a2 %gi
         %r = OpExtInst %f32 %ocl lgamma_r %vv %ps
        %po = OpPtrAccessChain %f32p %a1 %gi
               OpStore %po %r
               OpReturn
               OpFunctionEnd

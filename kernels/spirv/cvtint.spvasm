; Float to integer on the SPIR-V side, at the ends of the destination range.
;
; The instruction's result is undefined by the spec for a value the destination cannot
; hold, and the device answers the end of the range; a NaN answers zero. weft emitted a
; bare cast, which is undefined in C++ as well and answered 0 for both infinities, so
; the two columns disagreed on those rows. `Kernel` makes every integer type unsigned,
; which is why the signedness lives on the instruction and both results are u32 here.
;
;   0  ConvertFToS  NaN        -> 00000000
;   1  ConvertFToS  +inf       -> 7FFFFFFF
;   2  ConvertFToS  -inf       -> 80000000
;   3  ConvertFToS  -1.5       -> FFFFFFFF   toward zero
;   4  ConvertFToU  -1.5       -> 00000000
;   5  ConvertFToU  +inf       -> FFFFFFFF
;   6  ConvertFToS   2.5       -> 00000002
;   7  ConvertFToU  NaN        -> 00000000
               OpCapability Kernel
               OpCapability Addresses
               OpCapability Int64
               OpMemoryModel Physical64 OpenCL
               OpEntryPoint Kernel %main "cvtint" %gid
               OpName %main "cvtint"
               OpDecorate %gid BuiltIn GlobalInvocationId
       %void = OpTypeVoid
        %u64 = OpTypeInt 64 0
        %u32 = OpTypeInt 32 0
        %f32 = OpTypeFloat 32
       %u32p = OpTypePointer CrossWorkgroup %u32
       %f32p = OpTypePointer CrossWorkgroup %f32
     %v3u64 = OpTypeVector %u64 3
        %pin = OpTypePointer Input %v3u64
       %fnty = OpTypeFunction %void %f32p %u32p
        %gid = OpVariable %pin Input
         %c0 = OpConstant %u32 0
         %c1 = OpConstant %u32 1
         %c2 = OpConstant %u32 2
         %c3 = OpConstant %u32 3
         %c4 = OpConstant %u32 4
         %c5 = OpConstant %u32 5
         %c6 = OpConstant %u32 6
         %c7 = OpConstant %u32 7
       %main = OpFunction %void None %fnty
         %a0 = OpFunctionParameter %f32p
         %a1 = OpFunctionParameter %u32p
     %entry = OpLabel
        %p0 = OpPtrAccessChain %f32p %a0 %c0
        %x0 = OpLoad %f32 %p0
        %q0 = OpPtrAccessChain %u32p %a1 %c0
        %r0 = OpConvertFToS %u32 %x0
              OpStore %q0 %r0
        %p1 = OpPtrAccessChain %f32p %a0 %c1
        %x1 = OpLoad %f32 %p1
        %q1 = OpPtrAccessChain %u32p %a1 %c1
        %r1 = OpConvertFToS %u32 %x1
              OpStore %q1 %r1
        %p2 = OpPtrAccessChain %f32p %a0 %c2
        %x2 = OpLoad %f32 %p2
        %q2 = OpPtrAccessChain %u32p %a1 %c2
        %r2 = OpConvertFToS %u32 %x2
              OpStore %q2 %r2
        %p3 = OpPtrAccessChain %f32p %a0 %c3
        %x3 = OpLoad %f32 %p3
        %q3 = OpPtrAccessChain %u32p %a1 %c3
        %r3 = OpConvertFToS %u32 %x3
              OpStore %q3 %r3
        %p4 = OpPtrAccessChain %f32p %a0 %c4
        %x4 = OpLoad %f32 %p4
        %q4 = OpPtrAccessChain %u32p %a1 %c4
        %r4 = OpConvertFToU %u32 %x4
              OpStore %q4 %r4
        %p5 = OpPtrAccessChain %f32p %a0 %c5
        %x5 = OpLoad %f32 %p5
        %q5 = OpPtrAccessChain %u32p %a1 %c5
        %r5 = OpConvertFToU %u32 %x5
              OpStore %q5 %r5
        %p6 = OpPtrAccessChain %f32p %a0 %c6
        %x6 = OpLoad %f32 %p6
        %q6 = OpPtrAccessChain %u32p %a1 %c6
        %r6 = OpConvertFToS %u32 %x6
              OpStore %q6 %r6
        %p7 = OpPtrAccessChain %f32p %a0 %c7
        %x7 = OpLoad %f32 %p7
        %q7 = OpPtrAccessChain %u32p %a1 %c7
        %r7 = OpConvertFToU %u32 %x7
              OpStore %q7 %r7
              OpReturn
              OpFunctionEnd

; Two counters, 32 and 64 bits, incremented by every thread with a real atomic.
; Order-independent, so the answer is arithmetic: base + grid, checked in
; check.sh against a zero-thread run.
               OpCapability Kernel
               OpCapability Addresses
               OpCapability Int64
               OpCapability Int64Atomics
               OpMemoryModel Physical64 OpenCL
               OpEntryPoint Kernel %main "atomic" %gid
               OpName %main "atomic"
               OpDecorate %gid BuiltIn GlobalInvocationId
      %void = OpTypeVoid
      %u32 = OpTypeInt 32 0
      %u64 = OpTypeInt 64 0
     %u32p = OpTypePointer CrossWorkgroup %u32
     %u64p = OpTypePointer CrossWorkgroup %u64
   %v3u64 = OpTypeVector %u64 3
      %pin = OpTypePointer Input %v3u64
    %fnty = OpTypeFunction %void %u32p %u32p %u64p
       %c0 = OpConstant %u32 0
       %c1 = OpConstant %u32 1
       %c2 = OpConstant %u32 2
      %scp = OpConstant %u32 1
     %sem = OpConstant %u32 0
      %one = OpConstant %u64 1
      %gid = OpVariable %pin Input
      %main = OpFunction %void None %fnty
     %dummy = OpFunctionParameter %u32p
        %c0p = OpFunctionParameter %u32p
        %c1p = OpFunctionParameter %u64p
     %entry = OpLabel
        %p32 = OpPtrAccessChain %u32p %c0p %c0
     %old32 = OpAtomicIAdd %u32 %p32 %scp %sem %c1
        %p64 = OpPtrAccessChain %u64p %c1p %c0
     %old64 = OpAtomicIAdd %u64 %p64 %scp %sem %one
                OpReturn
                OpFunctionEnd

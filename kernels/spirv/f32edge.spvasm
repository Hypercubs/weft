      %c43u = OpConstant %u64 43
      %c44u = OpConstant %u64 44
      %c45u = OpConstant %u64 45
      %c46u = OpConstant %u64 46
      %c47u = OpConstant %u64 47
      %c48u = OpConstant %u64 48
      %c49u = OpConstant %u64 49
      %c50u = OpConstant %u64 50
      %c51u = OpConstant %u64 51
      %c52u = OpConstant %u64 52
       %main = OpFunction %void None %fnty
         %a0 = OpFunctionParameter %f32p
         %a1 = OpFunctionParameter %f32p
         %a2 = OpFunctionParameter %f32p
         %a3 = OpFunctionParameter %u32p
      %entry = OpLabel
          %g = OpLoad %v3u64 %gid
         %gi = OpCompositeExtract %u64 %g 0
        %inf = OpFDiv %f32 %one %pzero
        %nan = OpFDiv %f32 %pzero %pzero
       %ninf = OpFDiv %f32 %n_one %pzero
       %base = OpIMul %u64 %gi %cNu
        %r00 = OpFDiv %f32 %one %pzero
        %r01 = OpFDiv %f32 %n_one %pzero
        %r02 = OpFDiv %f32 %pzero %pzero
        %r03 = OpFMul %f32 %pzero %inf
        %r04 = OpFSub %f32 %inf %inf
        %r05 = OpFAdd %f32 %fmax %fmax
        %r06 = OpExtInst %f32 %ocl sqrt %n_one
        %r07 = OpExtInst %f32 %ocl sqrt %nzero
        %r08 = OpFAdd %f32 %nzero %nzero
        %r09 = OpExtInst %f32 %ocl log %pzero
        %r10 = OpExtInst %f32 %ocl log %n_one
        %r11 = OpExtInst %f32 %ocl exp %big
        %r12 = OpExtInst %f32 %ocl tgamma %n_three
        %r13 = OpExtInst %f32 %ocl sin %inf
        %r14 = OpExtInst %f32 %ocl fdim %inf %inf
        %r15 = OpExtInst %f32 %ocl fdim %one %inf
        %r16 = OpExtInst %f32 %ocl minmag %nan %one
        %r17 = OpExtInst %f32 %ocl maxmag %nan %nan
        %r18 = OpExtInst %f32 %ocl nextafter %fmax %inf
        %r19 = OpExtInst %f32 %ocl nextafter %inf %one
        %r20 = OpExtInst %f32 %ocl nextafter %pzero %n_one
        %r21 = OpExtInst %f32 %ocl nextafter %one %one
        %r22 = OpExtInst %f32 %ocl fmod %one %pzero
        %r23 = OpExtInst %f32 %ocl remainder %inf %one
        %r24 = OpExtInst %f32 %ocl powr %n_one %half
        %r25 = OpExtInst %f32 %ocl rootn %n_eight %c3i
        %r26 = OpExtInst %f32 %ocl rootn %n_eight %c2i
        %r27 = OpExtInst %f32 %ocl ldexp %fmax %c1i
        %r28 = OpExtInst %f32 %ocl ldexp %one %cM150i
      %base2 = OpIMul %u64 %gi %c10u
      %bs00 = OpIAdd %u64 %base2 %c00u
      %bs01 = OpIAdd %u64 %base2 %c01u
      %bs02 = OpIAdd %u64 %base2 %c02u
      %bs03 = OpIAdd %u64 %base2 %c03u
      %bs04 = OpIAdd %u64 %base2 %c04u
      %bs05 = OpIAdd %u64 %base2 %c05u
      %bs06 = OpIAdd %u64 %base2 %c06u
      %bs07 = OpIAdd %u64 %base2 %c07u
      %bs08 = OpIAdd %u64 %base2 %c08u
      %bs09 = OpIAdd %u64 %base2 %c09u
      %pf0 = OpPtrAccessChain %u32p %a3 %bs00
      %pf1 = OpPtrAccessChain %u32p %a3 %bs01
      %pf2 = OpPtrAccessChain %u32p %a3 %bs02
      %pm3 = OpPtrAccessChain %f32p %a2 %bs03
      %pm4 = OpPtrAccessChain %f32p %a2 %bs04
      %pm5 = OpPtrAccessChain %f32p %a2 %bs05
      %pc6 = OpPtrAccessChain %f32p %a2 %bs06
      %pc7 = OpPtrAccessChain %f32p %a2 %bs07
      %pq8 = OpPtrAccessChain %u32p %a3 %bs08
      %pq9 = OpPtrAccessChain %u32p %a3 %bs09
      %pfr0 = OpPtrAccessChain %f32p %a2 %bs00
      %pfr1 = OpPtrAccessChain %f32p %a2 %bs01
      %pfr2 = OpPtrAccessChain %f32p %a2 %bs02
      %pfr3 = OpPtrAccessChain %f32p %a2 %bs08
      %pfr4 = OpPtrAccessChain %f32p %a2 %bs09
        %r29 = OpExtInst %f32 %ocl frexp %fmax %pf0
        %r30 = OpExtInst %f32 %ocl frexp %nzero %pf1
        %r31 = OpExtInst %f32 %ocl frexp %sub %pf2
        %r32 = OpExtInst %f32 %ocl modf %nzero %pm3
        %r33 = OpExtInst %f32 %ocl modf %inf %pm4
        %r34 = OpExtInst %f32 %ocl modf %onehalf %pm5
        %r35 = OpExtInst %f32 %ocl sincos %inf %pc6
        %r36 = OpExtInst %f32 %ocl sincos %nzero %pc7
        %r37 = OpExtInst %f32 %ocl remquo %one %pzero %pq8
        %r38 = OpExtInst %f32 %ocl remquo %inf %one %pq9
        %r39 = OpExtInst %f32 %ocl fract %inf %pfr0
        %r40 = OpExtInst %f32 %ocl fract %nzero %pfr1
        %r41 = OpExtInst %f32 %ocl fract %big %pfr2
        %r51 = OpExtInst %f32 %ocl fract %onehalf %pfr3
        %r52 = OpExtInst %f32 %ocl fract %n_three %pfr4
        %r42 = OpExtInst %f32 %ocl erf %inf
        %r43 = OpExtInst %f32 %ocl erfc %n_one
        %r44 = OpExtInst %f32 %ocl cbrt %nzero
        %r45 = OpExtInst %f32 %ocl hypot %inf %one
        %r46 = OpExtInst %f32 %ocl log1p %nzero
        %r47 = OpExtInst %f32 %ocl acosh %half
        %r48 = OpExtInst %f32 %ocl asinh %ninf
        %r49 = OpExtInst %f32 %ocl expm1 %nzero
        %r50 = OpExtInst %f32 %ocl exp10 %big
        %i00 = OpIAdd %u64 %base %c00u
        %q00 = OpPtrAccessChain %f32p %a1 %i00
                OpStore %q00 %r00
        %i01 = OpIAdd %u64 %base %c01u
        %q01 = OpPtrAccessChain %f32p %a1 %i01
                OpStore %q01 %r01

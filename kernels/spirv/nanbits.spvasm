; `nan` (OpenCL.std 46): the quiet NaN that carries the caller's payload. The operand is
; a Nancode, an integer, which is what the instruction's signature says and what the
; validator enforces; a module passing a float is refused outright.
;   buffer 0: one payload per lane (a u32)
;   buffer 1: the NaN those bits name
               OpCapability Kernel
               OpCapability Addresses
               OpCapability Int64
       %ocl = OpExtInstImport "OpenCL.std"
               OpMemoryModel Physical64 OpenCL
               OpEntryPoint Kernel %main "nanbits" %gid
               OpName %main "nanbits"
               OpDecorate %gid BuiltIn GlobalInvocationId
      %void = OpTypeVoid
       %u64 = OpTypeInt 64 0
       %u32 = OpTypeInt 32 0
       %f32 = OpTypeFloat 32
      %u32p = OpTypePointer CrossWorkgroup %u32
      %f32p = OpTypePointer CrossWorkgroup %f32
    %v3u64 = OpTypeVector %u64 3
       %pin = OpTypePointer Input %v3u64
      %fnty = OpTypeFunction %void %u32p %f32p
       %gid = OpVariable %pin Input
       %main = OpFunction %void None %fnty
         %a0 = OpFunctionParameter %u32p
         %a1 = OpFunctionParameter %f32p
      %entry = OpLabel
          %g = OpLoad %v3u64 %gid
         %gi = OpCompositeExtract %u64 %g 0
        %pa = OpPtrAccessChain %u32p %a0 %gi
        %vv = OpLoad %u32 %pa
         %r = OpExtInst %f32 %ocl nan %vv
        %po = OpPtrAccessChain %f32p %a1 %gi
               OpStore %po %r
               OpReturn
               OpFunctionEnd

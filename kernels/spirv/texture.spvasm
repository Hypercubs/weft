; A texture read and a filtered sample, the SPIR-V twin of basic.metal's texmix:
;     a = img.read(uint2(x, y)).x
;     b = img.sample(nearest, float2((x + 0.5)/w, (y + 0.5)/h)).x
;     out[gid] = a * 2 + b
; The sampler is host state here, `--samplers nearest/clamp`, because in SPIR-V
; a sampler is a value the launcher creates and binds, not a constexpr the kernel
; declares. Every texel is covered, so the two front ends must agree byte for
; byte on all 65536 outputs.
               OpCapability Kernel
               OpCapability Addresses
               OpCapability ImageBasic
               OpCapability Int64
               OpMemoryModel Physical64 OpenCL
               OpEntryPoint Kernel %main "texmix" %gid
               OpName %main "texmix"
               OpDecorate %gid BuiltIn GlobalInvocationId
      %void = OpTypeVoid
       %f32 = OpTypeFloat 32
       %u32 = OpTypeInt 32 0
       %u64 = OpTypeInt 64 0
       %v2f = OpTypeVector %f32 2
       %v4f = OpTypeVector %f32 4
       %v2u = OpTypeVector %u32 2
     %v3u64 = OpTypeVector %u64 3
       %img = OpTypeImage %f32 2D 0 0 0 0 Unknown
       %smp = OpTypeSampler
        %si = OpTypeSampledImage %img
 %ptr_uc_img = OpTypePointer UniformConstant %img
 %ptr_uc_smp = OpTypePointer UniformConstant %smp
    %ptr_out = OpTypePointer CrossWorkgroup %f32
        %pin = OpTypePointer Input %v3u64
       %fnty = OpTypeFunction %void %ptr_out %ptr_uc_img %ptr_uc_smp
        %gid = OpVariable %pin Input
      %zerou = OpConstant %u32 0
        %two = OpConstant %f32 2
       %half = OpConstant %f32 0.5
         %z0 = OpConstant %f32 0
       %main = OpFunction %void None %fnty
          %o = OpFunctionParameter %ptr_out
        %tex = OpFunctionParameter %ptr_uc_img
     %smpvar = OpFunctionParameter %ptr_uc_smp
      %entry = OpLabel
          %g = OpLoad %v3u64 %gid
         %gi = OpCompositeExtract %u64 %g 0
        %g32 = OpUConvert %u32 %gi
      %vimg = OpLoad %img %tex
      %vsmp = OpLoad %smp %smpvar
       %wsz = OpImageQuerySizeLod %v2u %vimg %zerou
         %w = OpCompositeExtract %u32 %wsz 0
         %h = OpCompositeExtract %u32 %wsz 1
         %x = OpUMod %u32 %g32 %w
        %dy = OpUDiv %u32 %g32 %w
         %y = OpUMod %u32 %dy %h
       %xyu = OpCompositeConstruct %v2u %x %y
         %a = OpImageRead %v4f %vimg %xyu
        %ax = OpCompositeExtract %f32 %a 0
        %xf = OpConvertUToF %f32 %x
        %xh = OpFAdd %f32 %xf %half
        %wf = OpConvertUToF %f32 %w
         %u = OpFDiv %f32 %xh %wf
        %yf = OpConvertUToF %f32 %y
        %yh = OpFAdd %f32 %yf %half
        %hf = OpConvertUToF %f32 %h
         %v = OpFDiv %f32 %yh %hf
        %uv = OpCompositeConstruct %v2f %u %v
       %sis = OpSampledImage %si %vimg %vsmp
        %sm = OpImageSampleExplicitLod %v4f %sis %uv Lod %z0
         %b = OpCompositeExtract %f32 %sm 0
        %m1 = OpFMul %f32 %ax %two
         %r = OpFAdd %f32 %m1 %b
        %po = OpPtrAccessChain %ptr_out %o %gi
               OpStore %po %r
               OpReturn
               OpFunctionEnd

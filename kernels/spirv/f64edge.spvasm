        %i41 = OpIAdd %u64 %base %c41u
        %q41 = OpPtrAccessChain %f64p %a1 %i41
                OpStore %q41 %r41
        %i42 = OpIAdd %u64 %base %c42u
        %q42 = OpPtrAccessChain %f64p %a1 %i42
                OpStore %q42 %r42
        %i43 = OpIAdd %u64 %base %c43u
        %q43 = OpPtrAccessChain %f64p %a1 %i43
                OpStore %q43 %r43
                OpReturn
                OpFunctionEnd

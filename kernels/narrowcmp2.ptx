// The same four answers for a bf16, which shares the widening path: the bits are
// different, the comparisons are of the values either way.
.version 7.8
.target sm_90
.address_size 64

.visible .entry narrowcmp_bf16(
    .param .u64 narrowcmp_bf16_param_0, // in: one bf16 a lane
    .param .u64 narrowcmp_bf16_param_1  // out: four 32-bit answers a lane
)
{
    .reg .b16 %hs<6>;
    .reg .b32 %r<8>;
    .reg .b64 %rd<8>;
    .reg .pred %p<4>;

    ld.param.u64 %rd1, [narrowcmp_bf16_param_0];
    ld.param.u64 %rd2, [narrowcmp_bf16_param_1];
    mov.u32 %r1, %tid.x;

    mul.wide.u32 %rd3, %r1, 2;
    add.u64 %rd4, %rd1, %rd3;
    ld.global.b16 %hs1, [%rd4];

    mul.wide.u32 %rd5, %r1, 16;
    add.u64 %rd6, %rd2, %rd5;

    mov.b16 %hs2, 0x3F80;     // 1.0
    mov.b16 %hs3, 0xBF80;     // -1.0
    mov.b16 %hs4, 0x0000;     // +0

    setp.lt.bf16 %p1, %hs1, %hs2;
    selp.b32 %r2, 1, 0, %p1;
    st.global.b32 [%rd6], %r2;
    setp.ge.bf16 %p2, %hs1, %hs3;
    selp.b32 %r2, 1, 0, %p2;
    st.global.b32 [%rd6+4], %r2;
    set.ne.u32.bf16 %r3, %hs1, %hs4;
    st.global.b32 [%rd6+8], %r3;
    set.eq.u32.bf16 %r3, %hs1, %hs1;
    st.global.b32 [%rd6+12], %r3;
    ret;
}

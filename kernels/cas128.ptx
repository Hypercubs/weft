// atom.cas.b128: sixteen bytes compared and written as one value. The widest atomic
// instruction on either engine here is 64 bits, so the four words are read, compared
// and written under a lock -- and the case that matters is the one the old refusal
// warned about: an expected value that differs in the *high* half must not swap. A
// translation comparing a prefix would pass the low-half case and fail that one.
//
// The compare and the new value are loaded from their own buffers rather than built
// from immediates, because PTX has no sixteen-byte immediate and a `.b128` register is
// the only operand the instruction takes.
//
//   cmp = A, new = B                 -> the bytes become B, both halves
//   cmp = A with one low byte off    -> nothing is written, the bytes stay A
//   cmp = A with one high byte off   -> nothing is written, the bytes stay A
//
// Every lane in the group asks with the same three values, so the first to reach the
// word swaps it and the rest then find B and leave it: the answer does not depend on
// the order the lanes ran in.
.version 8.3
.target sm_90
.address_size 64

.visible .entry cas128(
    .param .u64 cas128_param_0,     // in/out: the sixteen bytes
    .param .u64 cas128_param_1,     // in: the value to compare against
    .param .u64 cas128_param_2      // in: the value to swap in
)
{
    .reg .b128 %q<4>;
    .reg .b64 %rd<4>;

    ld.param.u64 %rd1, [cas128_param_0];
    ld.param.u64 %rd2, [cas128_param_1];
    ld.param.u64 %rd3, [cas128_param_2];

    ld.global.b128 %q1, [%rd2];
    ld.global.b128 %q2, [%rd3];
    atom.global.cas.b128 %q3, [%rd1], %q1, %q2;
    ret;
}

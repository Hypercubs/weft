// `cvt.rn{.relu}{.satfinite}.f16.f32` and its bf16 twin: the scalar 16-bit float
// converts, which is what `__float2half` compiles to. Eight cases, each chosen so a
// wrong implementation is visible in the word:
//
//   1.0                        -> 3c00    the ordinary answer
//   1 + 1.5*2^-10              -> 3c02    a tie whose lower candidate is odd, so
//                                          nearest-even takes the even one upward
//   1e5, .satfinite            -> 7bff    past 65504, clamped to the largest finite
//   NaN, .satfinite            -> 0000    a NaN under .satfinite is zero
//   -2.5, .relu                -> 0000    a negative under .relu is zero
//   -2.5                       -> c100    ... and without it, the negative stays
//   1.0 as bf16                -> 3f80    eight significand bits instead of ten
//   +inf, .relu and .satfinite -> 7f7f    the largest finite bf16, not an infinity
//
// The results stay in `b32` registers: the value of a 16-bit float convert is 16
// bits, and a word-sized store keeps this fixture on paths that are not themselves
// under test.
.version 7.0
.target sm_80
.address_size 64

.visible .entry cvtf16(
    .param .u64 cvtf16_param_0      // eight words, one 16-bit value in each
)
{
    .reg .b32 %r<10>;
    .reg .b64 %rd<4>;

    ld.param.u64 %rd1, [cvtf16_param_0];

    mov.u32 %r1, 0x3F800000;
    cvt.rn.f16.f32 %r2, %r1;
    st.global.u32 [%rd1], %r2;

    mov.u32 %r1, 0x3F803000;
    cvt.rn.f16.f32 %r3, %r1;
    st.global.u32 [%rd1+4], %r3;

    mov.u32 %r1, 0x47C35000;
    cvt.rn.satfinite.f16.f32 %r4, %r1;
    st.global.u32 [%rd1+8], %r4;

    mov.u32 %r1, 0x7FC00000;
    cvt.rn.satfinite.f16.f32 %r5, %r1;
    st.global.u32 [%rd1+12], %r5;

    mov.u32 %r1, 0xC0200000;
    cvt.rn.relu.f16.f32 %r6, %r1;
    st.global.u32 [%rd1+16], %r6;

    mov.u32 %r1, 0xC0200000;
    cvt.rn.f16.f32 %r7, %r1;
    st.global.u32 [%rd1+20], %r7;

    mov.u32 %r1, 0x3F800000;
    cvt.rn.bf16.f32 %r8, %r1;
    st.global.u32 [%rd1+24], %r8;

    mov.u32 %r1, 0x7F800000;
    cvt.rn.relu.satfinite.bf16.f32 %r9, %r1;
    st.global.u32 [%rd1+28], %r9;
    ret;
}

// `.rz`: the same converts with the tail dropped instead of rounded.
//
//   1 + 3.5*2^-10               -> 3c03    rn would take this tie to 3c04
//   1e5, .satfinite             -> 7bff    the largest finite half
//   +inf                        -> 7c00    an infinity has nothing to truncate
//   1 + 3*2^-9 as bf16          -> 3f80    rn would answer 3f81
//   NaN as bf16                 -> 7fc0    ditto
.visible .entry cvtf16rz(
    .param .u64 cvtf16rz_param_0      // five words, one 16-bit value in each
)
{
    .reg .b32 %r<10>;
    .reg .b64 %rd<4>;

    ld.param.u64 %rd1, [cvtf16rz_param_0];

    mov.u32 %r1, 0x3F807000;
    cvt.rz.f16.f32 %r2, %r1;
    st.global.u32 [%rd1], %r2;

    mov.u32 %r1, 0x47C35000;
    cvt.rz.satfinite.f16.f32 %r3, %r1;
    st.global.u32 [%rd1+4], %r3;

    mov.u32 %r1, 0x7F800000;
    cvt.rz.f16.f32 %r4, %r1;
    st.global.u32 [%rd1+8], %r4;

    mov.u32 %r1, 0x3F80C000;
    cvt.rz.bf16.f32 %r5, %r1;
    st.global.u32 [%rd1+12], %r5;

    mov.u32 %r1, 0x7FC00000;
    cvt.rz.bf16.f32 %r6, %r1;
    st.global.u32 [%rd1+16], %r6;
    ret;
}

// `.sat` on a floating-point destination is the [0, 1] clamp with a NaN flushed to
// positive zero, the ISA's own note, and not the destination's range:
//
//   2.0            -> 3f800000    clamped down to 1
//  -0.5            -> 00000000    clamped up to 0
//   NaN            -> 00000000    +0, not a NaN and not a 1
//   0.25           -> 3e800000    inside the range, untouched
//   2.0 as an f16   -> 00003c00    the same clamp before the 16-bit conversion
//  -1.0 as an f16   -> 00000000
.visible .entry cvtsat(
    .param .u64 cvtsat_param_0      // six words
)
{
    .reg .b32 %r<10>;
    .reg .b64 %rd<4>;

    ld.param.u64 %rd1, [cvtsat_param_0];

    mov.u32 %r1, 0x40000000;
    cvt.sat.f32.f32 %r2, %r1;
    st.global.u32 [%rd1], %r2;

    mov.u32 %r1, 0xBF000000;
    cvt.sat.f32.f32 %r3, %r1;
    st.global.u32 [%rd1+4], %r3;

    mov.u32 %r1, 0x7FC00000;
    cvt.sat.f32.f32 %r4, %r1;
    st.global.u32 [%rd1+8], %r4;

    mov.u32 %r1, 0x3E800000;
    cvt.sat.f32.f32 %r5, %r1;
    st.global.u32 [%rd1+12], %r5;

    mov.u32 %r1, 0x40000000;
    cvt.rn.sat.f16.f32 %r6, %r1;
    st.global.u32 [%rd1+16], %r6;

    mov.u32 %r1, 0xBF800000;
    cvt.rn.sat.f16.f32 %r7, %r1;
    st.global.u32 [%rd1+20], %r7;
    ret;
}

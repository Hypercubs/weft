// The cluster forms of shared memory, which are the whole of a one-CTA launch: a
// cluster is one CTA wide here.
.version 8.3
.target sm_90
.address_size 64

.visible .entry sclv4(
    .param .u64 sclv4_param_0        // out: 32 words, lane by lane
)
{
    .shared .align 16 .b32 tile[32];

    .reg .b32 %r<16>;
    .reg .b64 %rd<4>;

    ld.param.u64 %rd1, [sclv4_param_0];
    mov.u32 %r1, %tid.x;             // lane
    shl.b32 %r2, %r1, 4;             // this lane's 16 bytes
    shl.b32 %r3, %r1, 2;             // 4 * lane
    mul.lo.u32 %r3, %r1, 10;         // the value only this lane writes
    add.u32 %r4, %r3, 1;
    add.u32 %r5, %r3, 4;
    add.u32 %r6, %r3, 7;
    add.u32 %r7, %r3, 10;
    st.shared::cluster.v4.b32 [%r2], {%r4, %r5, %r6, %r7};

    bar.sync 0;

    // The neighbour's four words: lane + 1 round the eight lanes.
    add.u32 %r8, %r1, 1;
    and.b32 %r8, %r8, 7;
    shl.b32 %r9, %r8, 4;
    ld.shared::cluster.v4.b32 {%r12, %r13, %r14, %r15}, [%r9];

    cvt.u64.u32 %rd2, %r2;
    add.s64 %rd3, %rd1, %rd2;
    st.global.b32 [%rd3], %r12;
    st.global.b32 [%rd3+4], %r13;
    st.global.b32 [%rd3+8], %r14;
    st.global.b32 [%rd3+12], %r15;
    ret;
}

.visible .entry sclmapa(
    .param .u64 sclmapa_param_0      // out: one word a lane
)
{
    .shared .align 16 .b32 tile[32];

    .reg .b32 %r<10>;
    .reg .b64 %rd<4>;

    ld.param.u64 %rd1, [sclmapa_param_0];
    mov.u32 %r1, %tid.x;
    shl.b32 %r2, %r1, 2;             // byte offset inside the window
    mul.lo.u32 %r3, %r1, 5;
    add.u32 %r3, %r3, 3;
    st.shared.b32 [%r2], %r3;

    bar.sync 0;

    // Rank 0 is this CTA: the address that comes back is the one that went in.
    mov.u32 %r4, 0;
    mapa.shared::cluster.u32 %r5, %r2, %r4;
    ld.shared.b32 %r6, [%r5];

    cvt.u64.u32 %rd2, %r2;
    add.s64 %rd3, %rd1, %rd2;
    st.global.b32 [%rd3], %r6;
    ret;
}

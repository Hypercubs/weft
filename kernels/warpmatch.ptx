// match.any, match.all and elect, on an 8-lane warp.
.version 8.6
.target sm_100
.address_size 64

.visible .entry electk(.param .u64 pout)
{
    .reg .b32 %r<8>;
    .reg .b64 %rd<3>;
    .reg .pred %p<2>;

    ld.param.u64 %rd1, [pout];
    mov.u32 %r1, %tid.x;
    mul.wide.u32 %rd2, %r1, 4;
    add.u64 %rd2, %rd1, %rd2;
    elect.sync %r2|%p1, -1;
    selp.u32 %r3, 1000, 0, %p1;
    add.u32 %r3, %r3, %r2;
    st.global.b32 [%rd2], %r3;
    ret;
}

.visible .entry matchny(.param .u64 pin, .param .u64 pout)
{
    .reg .b32 %r<8>;
    .reg .b64 %rd<5>;

    ld.param.u64 %rd1, [pin];
    ld.param.u64 %rd3, [pout];
    mov.u32 %r1, %tid.x;
    mul.wide.u32 %rd2, %r1, 4;
    add.u64 %rd2, %rd1, %rd2;
    ld.global.b32 %r2, [%rd2];
    match.any.sync.b32 %r3, %r2, -1;
    mul.wide.u32 %rd4, %r1, 4;
    add.u64 %rd4, %rd3, %rd4;
    st.global.b32 [%rd4], %r3;
    ret;
}

.visible .entry matchalld(.param .u64 pin, .param .u64 pout)
{
    .reg .b32 %r<8>;
    .reg .b64 %rd<5>;
    .reg .pred %p<2>;

    ld.param.u64 %rd1, [pin];
    ld.param.u64 %rd3, [pout];
    mov.u32 %r1, %tid.x;
    mul.wide.u32 %rd2, %r1, 4;
    add.u64 %rd2, %rd1, %rd2;
    ld.global.b32 %r2, [%rd2];
    match.all.sync.b32 %r3|%p1, %r2, -1;
    mul.wide.u32 %rd4, %r1, 4;
    add.u64 %rd4, %rd3, %rd4;
    st.global.b32 [%rd4], %r3;
    ret;
}

.visible .entry matchallp(.param .u64 pin, .param .u64 pout)
{
    .reg .b32 %r<8>;
    .reg .b64 %rd<5>;
    .reg .pred %p<2>;

    ld.param.u64 %rd1, [pin];
    ld.param.u64 %rd3, [pout];
    mov.u32 %r1, %tid.x;
    mul.wide.u32 %rd2, %r1, 4;
    add.u64 %rd2, %rd1, %rd2;
    ld.global.b32 %r2, [%rd2];
    match.all.sync.b32 %r3|%p1, %r2, -1;
    selp.u32 %r4, 7, 3, %p1;
    mul.wide.u32 %rd4, %r1, 4;
    add.u64 %rd4, %rd3, %rd4;
    st.global.b32 [%rd4], %r4;
    ret;
}

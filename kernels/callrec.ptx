.version 8.6
.target sm_100
.address_size 64

// Two functions that call each other, both calls in tail position. Each hop adds its
// count into the word, so six down to zero through both names is 6 + 4 + 2 = 12.
.visible .func () ping(.param .u64 acc, .param .u32 n);

.visible .func pong(
    .param .u64 acc,
    .param .u32 n
)
{
    .reg .b64 %rd<2>;
    .reg .b32 %r<3>;
    .reg .pred %p<2>;

    ld.param.u64 %rd1, [acc];
    ld.param.u32 %r1, [n];
    setp.eq.u32 %p1, %r1, 0;
    @%p1 ret;
    sub.u32 %r2, %r1, 1;
    call.uni ping, (%rd1, %r2);
    ret;
}

.visible .func ping(
    .param .u64 acc,
    .param .u32 n
)
{
    .reg .b64 %rd<2>;
    .reg .b32 %r<4>;
    .reg .pred %p<2>;

    ld.param.u64 %rd1, [acc];
    ld.param.u32 %r1, [n];
    ld.global.u32 %r2, [%rd1];
    add.u32 %r2, %r2, %r1;
    st.global.u32 [%rd1], %r2;
    setp.eq.u32 %p1, %r1, 0;
    @%p1 ret;
    sub.u32 %r3, %r1, 1;
    call.uni pong, (%rd1, %r3);
    ret;
}

.visible .entry callrec(
    .param .u64 in
)
{
    .reg .b64 %rd<2>;
    .reg .b32 %r<2>;

    ld.param.u64 %rd1, [in];
    mov.u32 %r1, 0;
    st.global.u32 [%rd1], %r1;
    mov.u32 %r1, 6;
    call.uni ping, (%rd1, %r1);
    ret;
}

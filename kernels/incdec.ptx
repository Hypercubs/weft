// atom.inc and atom.dec: table 41 gives them one width,.u32, and this host has no
// instruction for either.
.version 7.0
.target sm_80
.address_size 64

.visible .entry inc(
    .param .u64 inc_param_0        // in/out: the counter
)
{
    .reg .b32 %r<2>;
    .reg .b64 %rd<2>;

    ld.param.u64 %rd1, [inc_param_0];
    atom.global.inc.u32 %r1, [%rd1], 3;
    ret;
}

.visible .entry dec(
    .param .u64 dec_param_0
)
{
    .reg .b32 %r<2>;
    .reg .b64 %rd<2>;

    ld.param.u64 %rd1, [dec_param_0];
    atom.global.dec.u32 %r1, [%rd1], 3;
    ret;
}

.visible .entry incgrab(
    .param .u64 incgrab_param_0,   // in/out: the counter
    .param .u64 incgrab_param_1    // out: the value the counter held before
)
{
    .reg .b32 %r<2>;
    .reg .b64 %rd<4>;

    ld.param.u64 %rd1, [incgrab_param_0];
    ld.param.u64 %rd2, [incgrab_param_1];
    atom.global.inc.u32 %r1, [%rd1], 3;
    st.global.b32 [%rd2], %r1;
    ret;
}

.visible .entry redinc(
    .param .u64 redinc_param_0
)
{
    .reg .b64 %rd<2>;

    ld.param.u64 %rd1, [redinc_param_0];
    red.global.inc.u32 [%rd1], 3;
    ret;
}

// Reading two packed narrow values out into two halves: `cvt.rn.f16x2.<packed>`.
//
// The last type in the modifier list is the destination, so the pair is the source and
// the halves are the result. The source container is the narrow type's own width  -- a
// byte for an fp4 pair, a half-word for the rest  -- and that width is part of the
// spelling: a word-sized source there is `Arguments mismatch`.
//
//   e4m3x2 0x3C38 (1.5, 1.0)      -> 3e003c00  high value in the high half
//   e2m1x2 0xB2 with .relu        -> 00003c00  -1.5 is zeroed, 1.0 is kept
//   e2m3x2 0x1F02 (7.5, 0.25)     -> 47803400  MAX_NORM, and a subnormal of M/8
//   e3m2x2 0x1F01 (28, 0.0625)    -> 4f002c00  MAX_NORM, and the M/16 subnormal
//   e5m2x2 0x3C3C (1.0, 1.0)      -> 3c003c00
//   e2m1x2 0x40 (2.0, 0.0)        -> 40000000
//
// The other direction and the four-lane arithmetic are in `cvtf8x2dn.ptx`: ptxas takes
// only two of those rows, so that file carries them and says why.
.version 8.7
.target sm_100a
.address_size 64

.visible .entry cvtdown(
    .param .u64 cvtdown_param_0     // six words
)
{
    .reg .b8 %b<4>;
    .reg .b16 %hs<4>;
    .reg .b32 %r<10>;
    .reg .b64 %rd<4>;

    ld.param.u64 %rd1, [cvtdown_param_0];

    mov.u32 %r1, 0x3C38;
    cvt.u16.u32 %hs1, %r1;
    cvt.rn.f16x2.e4m3x2 %r2, %hs1;
    st.global.u32 [%rd1], %r2;

    mov.u32 %r1, 0xB2;
    cvt.u8.u32 %b1, %r1;
    cvt.rn.relu.f16x2.e2m1x2 %r3, %b1;
    st.global.u32 [%rd1+4], %r3;

    mov.u32 %r1, 0x1F02;
    cvt.u16.u32 %hs1, %r1;
    cvt.rn.f16x2.e2m3x2 %r4, %hs1;
    st.global.u32 [%rd1+8], %r4;

    mov.u32 %r1, 0x1F01;
    cvt.u16.u32 %hs1, %r1;
    cvt.rn.f16x2.e3m2x2 %r5, %hs1;
    st.global.u32 [%rd1+12], %r5;

    mov.u32 %r1, 0x3C3C;
    cvt.u16.u32 %hs1, %r1;
    cvt.rn.f16x2.e5m2x2 %r6, %hs1;
    st.global.u32 [%rd1+16], %r6;

    mov.u32 %r1, 0x40;
    cvt.u8.u32 %b1, %r1;
    cvt.rn.f16x2.e2m1x2 %r7, %b1;
    st.global.u32 [%rd1+20], %r7;
    ret;
}

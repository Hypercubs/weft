// A double read as an integer, on the software fp64 path the GPU target uses.
//
// `weft_fp64` saturates, and three of its answers were wrong: an unsigned destination
// returned the two's complement of a negative magnitude instead of zero, the 64-bit
// clamp only began at 2^119 so 1e20 wrapped to 0x6BC75E2D63100000, and a 32-bit
// destination narrowed the 64-bit answer instead of clamping to its own range.
//
//   0  s64  1e20      -> 7FFFFFFFFFFFFFFF
//   1  s64  2^64      -> 7FFFFFFFFFFFFFFF
//   2  s64  2^63      -> 7FFFFFFFFFFFFFFF
//   3  s64 -2^63      -> 8000000000000000
//   4  s64 -1e20      -> 8000000000000000
//   5  s64  2^62      -> 4000000000000000
//   6  u64  1e20      -> FFFFFFFFFFFFFFFF
//   7  u64 -1.5       -> 0000000000000000
//   8  s64  NaN       -> 0000000000000000
//   9  s64  +inf      -> 7FFFFFFFFFFFFFFF
//  10  u64  +inf      -> FFFFFFFFFFFFFFFF
//  11  s32  1e20      -> 7FFFFFFF
//  12  s32  2^40      -> 7FFFFFFF
//  13  u32 -1.5       -> 00000000
.version 7.1
.target sm_86
.address_size 64
.visible .entry f64cvt(.param .u64 f64cvt_param_0)
{
    .reg .b64 %rd<8>;
    .reg .f64 %fd<2>;
    .reg .b32 %r<8>;
    ld.param.u64 %rd7, [f64cvt_param_0];
    mov.b64 %fd1, 0x4415AF1D78B58C40;
    cvt.rzi.s64.f64 %rd2, %fd1;
    st.u64 [%rd7+0], %rd2;
    mov.b64 %fd1, 0x43F0000000000000;
    cvt.rzi.s64.f64 %rd2, %fd1;
    st.u64 [%rd7+8], %rd2;
    mov.b64 %fd1, 0x43E0000000000000;
    cvt.rzi.s64.f64 %rd2, %fd1;
    st.u64 [%rd7+16], %rd2;
    mov.b64 %fd1, 0xC3E0000000000000;
    cvt.rzi.s64.f64 %rd2, %fd1;
    st.u64 [%rd7+24], %rd2;
    mov.b64 %fd1, 0xC415AF1D78B58C40;
    cvt.rzi.s64.f64 %rd2, %fd1;
    st.u64 [%rd7+32], %rd2;
    mov.b64 %fd1, 0x43D0000000000000;
    cvt.rzi.s64.f64 %rd2, %fd1;
    st.u64 [%rd7+40], %rd2;
    mov.b64 %fd1, 0x4415AF1D78B58C40;
    cvt.rzi.u64.f64 %rd2, %fd1;
    st.u64 [%rd7+48], %rd2;
    mov.b64 %fd1, 0xBFF8000000000000;
    cvt.rzi.u64.f64 %rd2, %fd1;
    st.u64 [%rd7+56], %rd2;
    mov.b64 %fd1, 0x7FF8000000000000;
    cvt.rzi.s64.f64 %rd2, %fd1;
    st.u64 [%rd7+64], %rd2;
    mov.b64 %fd1, 0x7FF0000000000000;
    cvt.rzi.s64.f64 %rd2, %fd1;
    st.u64 [%rd7+72], %rd2;
    mov.b64 %fd1, 0x7FF0000000000000;
    cvt.rzi.u64.f64 %rd2, %fd1;
    st.u64 [%rd7+80], %rd2;
    mov.b64 %fd1, 0x4415AF1D78B58C40;
    cvt.rzi.s32.f64 %r2, %fd1;
    st.u32 [%rd7+88], %r2;
    mov.b64 %fd1, 0x4270000000000000;
    cvt.rzi.s32.f64 %r2, %fd1;
    st.u32 [%rd7+92], %r2;
    mov.b64 %fd1, 0xBFF8000000000000;
    cvt.rzi.u32.f64 %r2, %fd1;
    st.u32 [%rd7+96], %r2;
    ret;
}

.version 8.6
.target sm_100
.address_size 64

// A function that returns its answer and calls itself for the rest of it, so the value
// has to come back through the frame. Four down to zero sums to 10.
.visible .func (.reg .b32 r) sum(
    .param .u32 n
)
{
    .reg .b32 %r<4>;
    .reg .pred %p<2>;

    ld.param.u32 %r1, [n];
    setp.eq.u32 %p1, %r1, 0;
    @%p1 bra base;
    sub.u32 %r2, %r1, 1;
    call.uni (%r3), sum, (%r2);
    add.u32 %r3, %r3, %r1;
    mov.b32 r, %r3;
    ret;
base:
    mov.u32 r, 0;
    ret;
}

.visible .entry callvalu(
    .param .u64 out
)
{
    .reg .b64 %rd<2>;
    .reg .b32 %r<4>;

    ld.param.u64 %rd1, [out];
    mov.u32 %r1, 4;
    call.uni (%r2), sum, (%r1);
    st.global.u32 [%rd1], %r2;
    ret;
}

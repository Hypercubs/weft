// `tld4`: the four texels around a coordinate, each on its own channel.
//
//     u = (x + 0.5) / 64, v = (y + 0.5) / 64
//     g = tld4(tex, u, v)            // (x,y), (x+1,y), (x,y+1), (x+1,y+1)
//     out[gid] = g.x + g.y + g.z + g.w
//
// A filter would blend those four into one number; a gather keeps them apart, so
// an implementation that samples instead of gathering adds the same texel four
// times and lands on a different answer for every lane that is not on a flat
// patch of the image.
.version 7.0
.target sm_70
.address_size 64

.tex .u32 tex, 1, 1, 1, 1;

.visible .entry ptxgather(
    .param .u64 ptxgather_param_0
)
{
    .reg .b32 %r<16>;
    .reg .f32 %f<20>;
    .reg .b64 %rd<8>;

    ld.param.u64 %rd1, [ptxgather_param_0];
    mov.u32 %r1, %tid.x;
    mov.u32 %r2, %ctaid.x;
    mov.u32 %r3, %ntid.x;
    mad.lo.s32 %r4, %r2, %r3, %r1;      // gid

    and.b32 %r5, %r4, 63;               // x
    shr.u32 %r6, %r4, 6;
    and.b32 %r6, %r6, 63;               // y

    cvt.rn.f32.u32 %f1, %r5;
    cvt.rn.f32.u32 %f2, %r6;
    add.f32 %f3, %f1, 0f3F000000;       // x + 0.5
    add.f32 %f4, %f2, 0f3F000000;       // y + 0.5
    // The coordinate is normalised, and the binding is 64x64, so the divisor is
    // the size the kernel already knows it was launched against.
    mul.f32 %f3, %f3, 0f3B800000;       // (x + 0.5) / 64
    mul.f32 %f4, %f4, 0f3B800000;       // (y + 0.5) / 64

    tld4.b.2d.v4.f32.f32 {%f7,%f8,%f9,%f10}, [tex, {%f3,%f4}];

    add.f32 %f11, %f7, %f8;
    add.f32 %f12, %f9, %f10;
    add.f32 %f13, %f11, %f12;

    mul.wide.s32 %rd3, %r4, 4;
    add.s64 %rd4, %rd1, %rd3;
    st.global.f32 [%rd4], %f13;
    ret;
}

// Float to integer, at the ends of the destination range. `F2I` saturates, so a value
// past the range clamps to its end and a NaN answers zero.
.version 7.1
.target sm_86
.address_size 64
.visible .entry cvtint(.param .u64 cvtint_param_0)
{
    .reg .b32 %r<24>;
    .reg .b64 %rd<4>;
    ld.param.u64 %rd1, [cvtint_param_0];
    mov.b32 %r1, 0x7FC00000;
    cvt.rzi.s32.f32 %r2, %r1;
    st.u32 [%rd1+0], %r2;
    mov.b32 %r1, 0x7F800000;
    cvt.rzi.s32.f32 %r2, %r1;
    st.u32 [%rd1+4], %r2;
    mov.b32 %r1, 0xFF800000;
    cvt.rzi.s32.f32 %r2, %r1;
    st.u32 [%rd1+8], %r2;
    mov.b32 %r1, 0x40200000;
    cvt.rzi.s32.f32 %r2, %r1;
    st.u32 [%rd1+12], %r2;
    mov.b32 %r1, 0xBFC00000;
    cvt.rzi.u32.f32 %r2, %r1;
    st.u32 [%rd1+16], %r2;
    mov.b32 %r1, 0xBFC00000;
    cvt.rzi.s32.f32 %r2, %r1;
    st.u32 [%rd1+20], %r2;
    mov.b32 %r1, 0x7FC00000;
    cvt.rzi.u32.f32 %r2, %r1;
    st.u32 [%rd1+24], %r2;
    mov.b32 %r1, 0x40200000;
    cvt.rni.s32.f32 %r2, %r1;
    st.u32 [%rd1+28], %r2;
    mov.b32 %r1, 0x40600000;
    cvt.rni.s32.f32 %r2, %r1;
    st.u32 [%rd1+32], %r2;
    mov.b32 %r1, 0xC0200000;
    cvt.rmi.s32.f32 %r2, %r1;
    st.u32 [%rd1+36], %r2;
    mov.b32 %r1, 0x40066666;
    cvt.rpi.s32.f32 %r2, %r1;
    st.u32 [%rd1+40], %r2;
    mov.b32 %r1, 0x40000000;
    cvt.sat.f32.f32 %r2, %r1;
    st.u32 [%rd1+44], %r2;
    mov.b32 %r1, 0xBF800000;
    cvt.sat.f32.f32 %r2, %r1;
    st.u32 [%rd1+48], %r2;
    mov.b32 %r1, 0x7FC00000;
    cvt.sat.f32.f32 %r2, %r1;
    st.u32 [%rd1+52], %r2;
    ret;
}

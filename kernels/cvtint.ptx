// Float to integer, at the ends of the destination range.
//
// `F2I` saturates: a value past the destination's range clamps to its end, and a
// NaN answers zero (the `.NTZ` bit). A C++ cast is undefined for all of these, and
// the CPU column answered 0 for both infinities until this fixture existed. The
// rounding modes are here because the clamp has to happen after the rounding, not
// before it: 2.5 rounds up to 3 under .rpi and truncates to 2 under .rzi.
//
//   0  rzi.s32  NaN        -> 00000000
//   1  rzi.s32  +inf       -> 7FFFFFFF
//   2  rzi.s32  -inf       -> 80000000
//   3  rzi.s32  2.5        -> 00000002
//   4  rzi.u32  -1.5       -> 00000000   an unsigned destination cannot hold -1
//   5  rzi.s32  -1.5       -> FFFFFFFF
//   6  rzi.u32  NaN        -> 00000000
//   7  rni.s32  2.5        -> 00000002   ties to even
//   8  rni.s32  3.5        -> 00000004
//   9  rmi.s32  -2.5       -> FFFFFFFD
//  10  rpi.s32  2.1        -> 00000003
//  11  sat.f32  2.0        -> 3F800000   1.0, the [0, 1] clamp
//  12  sat.f32  -1.0       -> 00000000
//  13  sat.f32  NaN        -> 00000000
.version 7.1
.target sm_86
.address_size 64
.visible .entry cvtint(.param .u64 cvtint_param_0)
{
    .reg .b32 %r<24>;
    .reg .b64 %rd<4>;
    ld.param.u64 %rd1, [cvtint_param_0];
    mov.b32 %r1, 0x7FC00000;
    cvt.rzi.s32.f32 %r2, %r1;
    st.u32 [%rd1+0], %r2;
    mov.b32 %r1, 0x7F800000;
    cvt.rzi.s32.f32 %r2, %r1;
    st.u32 [%rd1+4], %r2;
    mov.b32 %r1, 0xFF800000;
    cvt.rzi.s32.f32 %r2, %r1;
    st.u32 [%rd1+8], %r2;
    mov.b32 %r1, 0x40200000;
    cvt.rzi.s32.f32 %r2, %r1;
    st.u32 [%rd1+12], %r2;
    mov.b32 %r1, 0xBFC00000;
    cvt.rzi.u32.f32 %r2, %r1;
    st.u32 [%rd1+16], %r2;
    mov.b32 %r1, 0xBFC00000;
    cvt.rzi.s32.f32 %r2, %r1;
    st.u32 [%rd1+20], %r2;
    mov.b32 %r1, 0x7FC00000;
    cvt.rzi.u32.f32 %r2, %r1;
    st.u32 [%rd1+24], %r2;
    mov.b32 %r1, 0x40200000;
    cvt.rni.s32.f32 %r2, %r1;
    st.u32 [%rd1+28], %r2;
    mov.b32 %r1, 0x40600000;
    cvt.rni.s32.f32 %r2, %r1;
    st.u32 [%rd1+32], %r2;
    mov.b32 %r1, 0xC0200000;
    cvt.rmi.s32.f32 %r2, %r1;
    st.u32 [%rd1+36], %r2;
    mov.b32 %r1, 0x40066666;
    cvt.rpi.s32.f32 %r2, %r1;
    st.u32 [%rd1+40], %r2;
    mov.b32 %r1, 0x40000000;
    cvt.sat.f32.f32 %r2, %r1;
    st.u32 [%rd1+44], %r2;
    mov.b32 %r1, 0xBF800000;
    cvt.sat.f32.f32 %r2, %r1;
    st.u32 [%rd1+48], %r2;
    mov.b32 %r1, 0x7FC00000;
    cvt.sat.f32.f32 %r2, %r1;
    st.u32 [%rd1+52], %r2;
    ret;
}

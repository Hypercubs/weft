// A cube texture from PTX, the twin of basic.metal's `texcube`:
//
//     x = gid & 63, y = (gid >> 6) & 63, face = (gid >> 12) % 6
//     s = (x + .5) / 64 * 2 - 1, t = 1 - (y + .5) / 64 * 2
//     out[gid] = texCube(cube, {s, t, face}) * 2 + face
//
// PTX's cube form names a face and a position on it rather than a direction, and
// this is the one place the two spellings of the same thing are checked against
// each other: `weft_cube_dir` rebuilds the direction, and the sampler picks the
// face back out of it. A face that is off by one, an axis that is flipped, or a
// t that runs the wrong way all answer on a different texel, and the face is
// folded into the result, so picking the wrong one cannot hide behind a texel
// that happens to hold the same number.
.version 7.0
.target sm_70
.address_size 64

.tex .u32 cube, 1, 1, 1, 1;

.visible .entry ptxcube(
    .param .u64 ptxcube_param_0
)
{
    .reg .b32 %r<20>;
    .reg .f32 %f<24>;
    .reg .b64 %rd<8>;

    ld.param.u64 %rd1, [ptxcube_param_0];
    mov.u32 %r1, %tid.x;
    mov.u32 %r2, %ctaid.x;
    mov.u32 %r3, %ntid.x;
    mad.lo.s32 %r4, %r2, %r3, %r1;      // gid

    // The size the binding reports, not a number written into the kernel.
    txq.width.b32 %r5, [cube];

    and.b32 %r7, %r4, 63;               // x = gid & 63
    shr.u32 %r8, %r4, 6;
    and.b32 %r9, %r8, 63;               // y = (gid >> 6) & 63
    shr.u32 %r10, %r4, 12;
    // face = (gid >> 12) % 6, without assuming a power of two.
    div.u32 %r11, %r10, 6;
    mul.lo.s32 %r12, %r11, 6;
    sub.s32 %r13, %r10, %r12;           // the face index

    cvt.rn.f32.u32 %f1, %r7;
    cvt.rn.f32.u32 %f2, %r9;
    add.f32 %f3, %f1, 0f3F000000;       // x + 0.5
    add.f32 %f4, %f2, 0f3F000000;       // y + 0.5
    cvt.rn.f32.u32 %f5, %r5;
    div.rn.f32 %f6, %f3, %f5;           // (x + .5) / w, in (0, 1)
    div.rn.f32 %f7, %f4, %f5;           // (y + .5) / h
    // A cube coordinate runs from -1 to 1 across the face, with t pointing up.
    add.f32 %f8, %f6, %f6;
    add.f32 %f9, %f8, 0fBF800000;       // s = 2u - 1
    add.f32 %f10, %f7, %f7;
    sub.f32 %f11, 0f3F800000, %f10;     // t = 1 - 2v

    tex.cube.v4.f32.f32 {%f12,%f13,%f14,%f15}, [cube, {%f9,%f11,%r13}];

    mul.f32 %f16, %f12, 0f40000000;     // the texel, doubled
    cvt.rn.f32.u32 %f17, %r13;          // with the face folded in
    add.f32 %f18, %f16, %f17;
    mul.wide.s32 %rd3, %r4, 4;
    add.s64 %rd4, %rd1, %rd3;
    st.global.f32 [%rd4], %f18;
    ret;
}

// `cvt.*.tf32.f32`: tf32 is a float32 with the low thirteen mantissa bits dropped,
// so the three rounding modes differ only in those bits. A multiply sees the
// rounded value, which is why every tensor-core path converts its operands first.
//
// The first entry walks the eight lanes through the interesting places: an exact
// value (lane 0), a tie with an even kept bit (1), an exact value whose kept bit is
// odd (2), a tie with an odd kept bit (3), and four values just above or below.
// `rna` and `rn` part company only where a tie lands, and `rz` differs from both
// wherever anything was dropped, 24 words that a truncation-only or a
// nearest-even-only implementation cannot reproduce.
//
// The second entry is the two modifiers: `.relu` zeroes a negative, `.satfinite`
// clamps an infinity to the largest finite tf32 and turns a NaN into zero, and the
// last line has both on a value that neither should touch.
.version 7.0
.target sm_80
.address_size 64

.visible .entry tf32cvt(
    .param .u64 tf32cvt_param_0      // three words a lane: rna, rn, rz
)
{
    .reg .b32 %r<12>;
    .reg .b64 %rd<4>;

    ld.param.u64 %rd1, [tf32cvt_param_0];
    mov.u32 %r1, %tid.x;

    // The input: 1.0 with lane*0x1000 in the dropped bits.
    shl.b32 %r2, %r1, 12;
    mov.u32 %r3, 0x3F800000;
    or.b32 %r4, %r3, %r2;

    cvt.rna.tf32.f32 %r5, %r4;
    cvt.rn.tf32.f32  %r6, %r4;
    cvt.rz.tf32.f32  %r7, %r4;

    mul.lo.u32 %r8, %r1, 12;
    cvt.u64.u32 %rd2, %r8;
    add.s64 %rd2, %rd1, %rd2;
    st.global.u32 [%rd2], %r5;
    st.global.u32 [%rd2+4], %r6;
    st.global.u32 [%rd2+8], %r7;
    ret;
}

.visible .entry tf32sat(
    .param .u64 tf32sat_param_0      // four words: relu, +inf, nan, untouched
)
{
    .reg .b32 %r<12>;
    .reg .b64 %rd<4>;

    ld.param.u64 %rd1, [tf32sat_param_0];

    mov.u32 %r1, 0xBFC00000;              // -1.5
    cvt.rn.relu.tf32.f32 %r2, %r1;
    st.global.u32 [%rd1], %r2;

    mov.u32 %r1, 0x7F800000;              // +inf
    cvt.rn.satfinite.tf32.f32 %r3, %r1;
    st.global.u32 [%rd1+4], %r3;

    mov.u32 %r1, 0x7FC00000;              // nan
    cvt.rn.satfinite.tf32.f32 %r4, %r1;
    st.global.u32 [%rd1+8], %r4;

    mov.u32 %r1, 0x3F800000;              // 1.0, which neither modifier touches
    cvt.rz.satfinite.relu.tf32.f32 %r5, %r1;
    st.global.u32 [%rd1+12], %r5;
    ret;
}

.version 8.6
.target sm_100
.address_size 64

// A return list around a function that returns nothing: the call and the declaration
// disagree, and the mismatch is said rather than the answer invented.
.visible .func quiet(
    .param .u64 src
)
{
    .reg .b64 %rd<2>;
    .reg .b32 %r<2>;

    ld.param.u64 %rd1, [src];
    ld.global.u32 %r1, [%rd1];
    ret;
}

.visible .entry calldrop(
    .param .u64 in,
    .param .u64 out
)
{
    .reg .b64 %rd<3>;
    .reg .b32 %r<3>;

    ld.param.u64 %rd1, [in];
    ld.param.u64 %rd2, [out];
    call.uni (%r2), quiet, (%rd1);
    mov.u32 %r1, %tid.x;
    mul.wide.u32 %rd3, %r1, 4;
    add.u64 %rd2, %rd2, %rd3;
    st.global.u32 [%rd2], %r2;
    ret;
}

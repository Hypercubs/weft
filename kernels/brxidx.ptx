// brx.idx: an indirect branch through a jump table.
.version 7.0
.target sm_70
.address_size 64

.visible .entry brxidx(.param .u64 p_in, .param .u64 p_out)
{
  .reg .b32 %r<4>;
  .reg .b64 %rd<5>;
  ld.param.u64 %rd1, [p_in];
  ld.param.u64 %rd2, [p_out];
  mov.u32 %r1, %tid.x;
  cvt.u64.u32 %rd3, %r1;
  shl.b64 %rd3, %rd3, 2;
  add.s64 %rd3, %rd1, %rd3;
  ld.global.u32 %r1, [%rd3];
  ts: .branchtargets L0, L1, L2;
  brx.idx %r1, ts;
  mov.u32 %r2, 99;
  bra.uni Ldone;
L0:
  mov.u32 %r2, 10;
  bra.uni Ldone;
L1:
  mov.u32 %r2, 11;
  bra.uni Ldone;
L2:
  mov.u32 %r2, 12;
  bra.uni Ldone;
Ldone:
  mov.u32 %r3, %tid.x;
  cvt.u64.u32 %rd4, %r3;
  shl.b64 %rd4, %rd4, 2;
  add.s64 %rd4, %rd2, %rd4;
  st.global.u32 [%rd4], %r2;
  ret;
}

.visible .entry brxpred(.param .u64 p_in, .param .u64 p_out)
{
  .reg .b32 %r<4>;
  .reg .pred %p<2>;
  .reg .b64 %rd<5>;
  ld.param.u64 %rd1, [p_in];
  ld.param.u64 %rd2, [p_out];
  mov.u32 %r1, %tid.x;
  cvt.u64.u32 %rd3, %r1;
  shl.b64 %rd3, %rd3, 2;
  add.s64 %rd3, %rd1, %rd3;
  ld.global.u32 %r1, [%rd3];
  mov.u32 %r2, 99;
  setp.lt.u32 %p1, %r1, 3;
  ms: .branchtargets M<3>;
  @%p1 brx.idx %r1, ms;
  bra.uni Ldone2;
M0:
  mov.u32 %r2, 20;
  bra.uni Ldone2;
M1:
  mov.u32 %r2, 21;
  bra.uni Ldone2;
M2:
  mov.u32 %r2, 22;
  bra.uni Ldone2;
Ldone2:
  mov.u32 %r3, %tid.x;
  cvt.u64.u32 %rd4, %r3;
  shl.b64 %rd4, %rd4, 2;
  add.s64 %rd4, %rd2, %rd4;
  st.global.u32 [%rd4], %r2;
  ret;
}

// The four-value forms of the MX converts, split out of `cvtmx.ptx`.
//
// ptxas has no `.x4` spelling of these with `.rn`. What it does have is the pair
// form, `cvt.rn.satfinite{.relu}.{e2m1,e2m3,e3m2}x2.f32 d, a, b`, whose destination
// is a `.b8` register for fp4 and a `.b16` one for f6, and whose first source lands
// in the high field. Two of those plus one shift are the four-value form's bits
// exactly, because that form packs the first source highest and the last lowest:
//
//   {a, b, e, f} -> (a<<12 | b<<8 | e<<4 | f)      e2m1
//                -> (a<<24 | b<<16 | e<<8 | f)      e2m3, e3m2
//
// The pair form puts its first source in the high field of the pair, so (a,b) is the
// high half of the four-value answer and (e,f) the low one: the first is shifted up
// and the second or-ed in. weft reads both spellings, and its suite checks the
// values against the four-value form the fixture used to write.
.version 8.8
.target sm_100a
.address_size 64
//   {1, 3, 0.25, -7} as e2m1x4 -> 0000250f  1 -> 0010, 3 -> 0101, 0.25 is a tie
//                                          between 0 and 0.5 and takes 0, -7
//                                          saturates to -6 (1111)
//   {1.5, -2, 0.0625, 8} as e2m3x4 with .relu
//                              -> 0c00001f  relu zeroes the negative; 1.5 -> 01100,
//                                          8 saturates to 7.5 (011111), and 0.0625
//                                          is a tie on the M/8 grid that takes 0
//   {28, 0.25, 1.75, 1e6} as e3m2x4
//                              -> 1f040f1f  28 is MAX_NORM itself (011111), 0.25 is
//                                          the smallest normal (000100), 1.75 is
//                                          001111, and 1e6 saturates
.visible .entry cvtmx4(
    .param .u64 cvtmx4_param_0     // three words
)
{
    .reg .b32 %r<12>;
    .reg .b16 %rs<4>;
    .reg .b8 %rb<4>;
    .reg .b64 %rd<4>;

    ld.param.u64 %rd1, [cvtmx4_param_0];

    // four fp4 codes: two nibble pairs, first source high in each
    mov.u32 %r1, 0x3F800000;
    mov.u32 %r2, 0x40400000;
    mov.u32 %r3, 0x3E800000;
    mov.u32 %r4, 0xC0E00000;
    cvt.rn.satfinite.e2m1x2.f32 %rb1, %r1, %r2;
    cvt.rn.satfinite.e2m1x2.f32 %rb2, %r3, %r4;
    cvt.u32.u8 %r5, %rb1;
    cvt.u32.u8 %r6, %rb2;
    shl.b32 %r5, %r5, 8;
    or.b32 %r7, %r5, %r6;
    st.global.u32 [%rd1], %r7;

    // four five-bit codes, the first pair into the top half of the word
    mov.u32 %r1, 0x3FC00000;
    mov.u32 %r2, 0xC0000000;
    mov.u32 %r3, 0x3D800000;
    mov.u32 %r4, 0x41000000;
    cvt.rn.satfinite.relu.e2m3x2.f32 %rs1, %r1, %r2;
    cvt.rn.satfinite.relu.e2m3x2.f32 %rs2, %r3, %r4;
    cvt.u32.u16 %r5, %rs1;
    cvt.u32.u16 %r6, %rs2;
    shl.b32 %r5, %r5, 16;
    or.b32 %r7, %r5, %r6;
    st.global.u32 [%rd1+4], %r7;

    // four six-bit codes, the same split
    mov.u32 %r1, 0x41E00000;
    mov.u32 %r2, 0x3E800000;
    mov.u32 %r3, 0x3FE00000;
    mov.u32 %r4, 0x49742400;
    cvt.rn.satfinite.e3m2x2.f32 %rs1, %r1, %r2;
    cvt.rn.satfinite.e3m2x2.f32 %rs2, %r3, %r4;
    cvt.u32.u16 %r5, %rs1;
    cvt.u32.u16 %r6, %rs2;
    shl.b32 %r5, %r5, 16;
    or.b32 %r7, %r5, %r6;
    st.global.u32 [%rd1+8], %r7;
    ret;
}

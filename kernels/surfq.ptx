// A surface answering its own size.
.version 7.0
.target sm_70
.address_size 64

.global .surfref srf;

.visible .entry surfq(
    .param .u64 out
)
{
    .reg .b32 %r<8>;
    .reg .b64 %rd<3>;

    ld.param.u64 %rd1, [out];

    suq.width.b32 %r1, [srf];
    suq.height.b32 %r2, [srf];
    suq.depth.b32 %r3, [srf];

    add.s32 %r4, %r1, %r2;
    add.s32 %r4, %r4, %r3;

    st.global.b32 [%rd1], %r1;
    st.global.b32 [%rd1+4], %r2;
    st.global.b32 [%rd1+8], %r3;
    st.global.b32 [%rd1+12], %r4;
    ret;
}

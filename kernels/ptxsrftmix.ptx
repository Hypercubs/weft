// A surface and a sampled texture held by one module.
//
//     sust.2d [img, {x, y}], {gid}              // every lane writes its own texel
//     bar.sync
//     v = suld.2d [img, {x + 1 (mod 64), y}]    // the next lane along wrote that
//     t = tex2D(tex, (x + .5)/64, (y + .5)/64)  // this lane's texel, through a filter
//     out[gid] = 2 t
//     aux[gid] = v
//
// PTX keeps the two spaces apart: `sust`/`suld` take a `.surfref` and `tex` takes a
// `.texref`, and one symbol cannot be both (`Inconsistent redefinition`), so the
// module declares one of each and `--textures 64x64,64x64` fills them in
// declaration order. The surface read crosses lanes and the barrier is what makes
// its answer another lane's write, so a write that never reached the image shows up
// as a wrong word in `aux` rather than hiding in a register. The sample lands on a
// texel centre under nearest/clamp, so the filter, the address mode and the size
// all show up as a wrong number too.
.version 7.0
.target sm_70
.address_size 64

.global .surfref img;
.global .texref tex;

.visible .entry ptxsrftmix(
    .param .u64 ptxsrftmix_param_0,
    .param .u64 ptxsrftmix_param_1
)
{
    .reg .b32 %r<20>;
    .reg .f32 %f<16>;
    .reg .b64 %rd<8>;

    ld.param.u64 %rd1, [ptxsrftmix_param_0];
    ld.param.u64 %rd2, [ptxsrftmix_param_1];
    mov.u32 %r1, %tid.x;
    mov.u32 %r2, %ctaid.x;
    mov.u32 %r3, %ntid.x;
    mad.lo.s32 %r4, %r2, %r3, %r1;      // gid

    and.b32 %r5, %r4, 63;               // x
    shr.u32 %r6, %r4, 6;
    and.b32 %r6, %r6, 63;               // y

    cvt.rn.f32.s32 %f1, %r4;
    sust.b.2d.clamp.b32 [img, {%r5,%r6}], {%f1};

    bar.sync 0;

    // The next lane along, which another lane wrote: x wraps inside the row, so the
    // last column reads what the first column put there.
    add.s32 %r7, %r5, 1;
    and.b32 %r7, %r7, 63;
    suld.b.2d.clamp.b32 %r8, [img, {%r7,%r6}];

    // And this lane's own texel of the sampled binding, through the sampler state.
    cvt.rn.f32.u32 %f2, %r5;
    cvt.rn.f32.u32 %f3, %r6;
    add.f32 %f4, %f2, 0f3F000000;       // x + 0.5
    add.f32 %f5, %f3, 0f3F000000;       // y + 0.5
    mul.f32 %f6, %f4, 0f3B800000;       // u
    mul.f32 %f7, %f5, 0f3B800000;       // v
    tex.2d.v4.f32.f32 {%f8,%f9,%f10,%f11}, [tex, {%f6,%f7}];

    mul.f32 %f12, %f8, 0f40000000;      // 2 t

    mul.wide.s32 %rd3, %r4, 4;
    add.s64 %rd4, %rd1, %rd3;
    st.global.f32 [%rd4], %f12;
    add.s64 %rd5, %rd2, %rd3;
    st.global.b32 [%rd5], %r8;          // the texel the neighbour stored, as it was
    ret;
}

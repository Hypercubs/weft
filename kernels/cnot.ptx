.version 7.0
.target sm_70
.address_size 64
// cnot is the C logical negation, so the only input that answers 1 is zero. The rows
// below are the ones that separate it from `not`: all bits set, the top bit alone, a
// single low bit, and the largest non-zero value, which all answer 0. The 64-bit form
// repeats it one size up, where a set bit beyond 32 still makes the answer 0.
.visible .entry cnot(.param .u64 p0)
{
    .reg .b32 %r<20>;
    .reg .b64 %rd<10>;
    ld.param.u64 %rd1, [p0];
    mov.u32 %r1, 0;
    mov.u32 %r2, 1;
    mov.u32 %r3, 0xFFFFFFFF;
    mov.u32 %r4, 0x80000000;
    mov.u32 %r5, 0;
    mov.u32 %r6, 42;
    mov.u32 %r7, 0;
    mov.u32 %r8, 0x7FFFFFFF;
    cnot.b32 %r11, %r1;
    cnot.b32 %r12, %r2;
    cnot.b32 %r13, %r3;
    cnot.b32 %r14, %r4;
    cnot.b32 %r15, %r5;
    cnot.b32 %r16, %r6;
    cnot.b32 %r17, %r7;
    cnot.b32 %r18, %r8;
    st.u32 [%rd1], %r11;
    st.u32 [%rd1+4], %r12;
    st.u32 [%rd1+8], %r13;
    st.u32 [%rd1+12], %r14;
    st.u32 [%rd1+16], %r15;
    st.u32 [%rd1+20], %r16;
    st.u32 [%rd1+24], %r17;
    st.u32 [%rd1+28], %r18;
    mov.b64 %rd2, 0;
    mov.b64 %rd3, 0x0000000100000000;
    mov.b64 %rd4, 0xFFFFFFFFFFFFFFFF;
    mov.b64 %rd5, 0x8000000000000000;
    cnot.b64 %rd6, %rd2;
    cnot.b64 %rd7, %rd3;
    cnot.b64 %rd8, %rd4;
    cnot.b64 %rd9, %rd5;
    st.u64 [%rd1+32], %rd6;
    st.u64 [%rd1+40], %rd7;
    st.u64 [%rd1+48], %rd8;
    st.u64 [%rd1+56], %rd9;
    ret;
}

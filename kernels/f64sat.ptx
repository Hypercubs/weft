// `.sat` on a 64-bit float destination, which the ISA defines as the [0, 1] clamp
// with a NaN flushed to positive zero, not the destination's range. That distinction
// is the whole fixture: 2.0 saturates down to 1 rather than staying 2, -0.5 goes up to
// zero, a NaN becomes +0 and not a NaN, a value inside the range is untouched, and
// -0.0 is *not* below zero, so it keeps its sign.
//
//     cvt.sat.f64.f64 2.0   -> 3ff0000000000000
//     cvt.sat.f64.f64 -0.5  -> 0000000000000000
//     cvt.sat.f64.f64 NaN   -> 0000000000000000
//     cvt.sat.f64.f64 0.25  -> 3fd0000000000000   inside the range, untouched
//     cvt.sat.f64.f64 -0.0  -> 8000000000000000   a zero is not a negative
//     cvt.sat.f64.f64 +inf  -> 3ff0000000000000
//     cvt.sat.f64.f64 -inf  -> 0000000000000000
//     cvt.sat.f64.f64 1.0   -> 3ff0000000000000   the top of the range is legal
//     cvt.sat.f64.f32 2.0   -> 3ff0000000000000   the same clamp on a converted source
//
// This GPU has no fp64, so each of these runs on the software double over the bits
// while the CPU column runs the host's own, and the answers have to be the same
// bytes, which is what makes the clamp worth writing over the software comparisons.
.version 7.0
.target sm_70
.address_size 64

.visible .entry f64sat(
    .param .u64 f64sat_param_0      // nine doubles
)
{
    .reg .b64 %rd<4>;
    .reg .f64 %fd<12>;
    .reg .f32 %f<4>;

    ld.param.u64 %rd1, [f64sat_param_0];

    mov.f64 %fd1, 0d4000000000000000;
    cvt.sat.f64.f64 %fd2, %fd1;
    st.global.f64 [%rd1], %fd2;

    mov.f64 %fd1, 0dBFE0000000000000;
    cvt.sat.f64.f64 %fd3, %fd1;
    st.global.f64 [%rd1+8], %fd3;

    mov.f64 %fd1, 0d7FF8000000000000;
    cvt.sat.f64.f64 %fd4, %fd1;
    st.global.f64 [%rd1+16], %fd4;

    mov.f64 %fd1, 0d3FD0000000000000;
    cvt.sat.f64.f64 %fd5, %fd1;
    st.global.f64 [%rd1+24], %fd5;

    mov.f64 %fd1, 0d8000000000000000;
    cvt.sat.f64.f64 %fd6, %fd1;
    st.global.f64 [%rd1+32], %fd6;

    mov.f64 %fd1, 0d7FF0000000000000;
    cvt.sat.f64.f64 %fd7, %fd1;
    st.global.f64 [%rd1+40], %fd7;

    mov.f64 %fd1, 0dFFF0000000000000;
    cvt.sat.f64.f64 %fd8, %fd1;
    st.global.f64 [%rd1+48], %fd8;

    mov.f64 %fd1, 0d3FF0000000000000;
    cvt.sat.f64.f64 %fd9, %fd1;
    st.global.f64 [%rd1+56], %fd9;

    mov.f32 %f1, 0f40000000;
    cvt.sat.f64.f32 %fd10, %f1;
    st.global.f64 [%rd1+64], %fd10;
    ret;
}

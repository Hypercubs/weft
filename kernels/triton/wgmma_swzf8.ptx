//
// The swizzle with one-byte elements: `wgmma.mma_async.m64n8k32.f32.e4m3.e4m3`.
//
// K is 32 here, 32 bytes, and an element is one byte, so K byte columns run all
// the way across a quarter of the 128-byte atom. That is the case where the
// pattern's phase and the byte column overlap: the phase is bits 4-6 and a byte
// column past 15 has bits there too, so a byte ends up somewhere else in the row
// entirely rather than a few bytes along.
//
// B's rows are 32 bytes as well, so its values are staged two at a time: adjacent
// K are adjacent bytes here, which is not true of any wider element.
.version 8.1
.target sm_90
.address_size 64

.maxntid 128, 1, 1

.visible .entry wgmma_swzf8_kernel(
	.param .u64 wgmma_swzf8_kernel_param_0,
	.param .u64 wgmma_swzf8_kernel_param_1,
	.param .u64 wgmma_swzf8_kernel_param_2
)
{
	.reg .b32 	%r<40>;
	.reg .f32 	%f<12>;
	.reg .b64 	%rd<16>;

	// A: 64 rows of 128 bytes. B: eight rows of 128 after it.
	.shared .align 1024 .b8 weft_ab[9216];

	ld.param.u64 	%rd1, [wgmma_swzf8_kernel_param_0];
	ld.param.u64 	%rd2, [wgmma_swzf8_kernel_param_1];
	ld.param.u64 	%rd3, [wgmma_swzf8_kernel_param_2];

	mov.u32 	%r1, %tid.x;
	mov.u64 	%rd5, weft_ab;

	// ---- A: one 16-byte chunk of one row, sixteen bytes of K ----
	and.b32 	%r2, %r1, 63;			// row
	shr.u32 	%r3, %r1, 6;			// which chunk of the row
	shl.b32 	%r6, %r3, 4;			// chunk * 16
	shl.b32 	%r4, %r2, 5;			// row * 32 bytes in the source tile
	add.s32 	%r4, %r4, %r6;
	cvt.u64.u32 	%rd4, %r4;
	add.s64 	%rd4, %rd1, %rd4;
	ld.global.v4.b32 	{%r10, %r11, %r12, %r13}, [%rd4];

	and.b32 	%r8, %r2, 7;
	shl.b32 	%r8, %r8, 4;
	xor.b32 	%r9, %r6, %r8;
	shl.b32 	%r7, %r2, 7;
	add.s32 	%r9, %r9, %r7;
	cvt.u64.u32 	%rd6, %r9;
	add.s64 	%rd6, %rd5, %rd6;
	st.shared.v4.b32 	[%rd6], {%r10, %r11, %r12, %r13};

	// ---- B: two adjacent K of one row, n = lane / 16, k = 2 * (lane % 16) ----
	shr.u32 	%r14, %r1, 4;			// n
	and.b32 	%r15, %r1, 15;			// which pair of K
	shl.b32 	%r16, %r15, 4;			// a pair is 16 bytes in: eight values, two bytes
	add.s32 	%r16, %r16, %r14;
	cvt.u64.u32 	%rd7, %r16;
	add.s64 	%rd7, %rd2, %rd7;
	ld.global.u8 	%r30, [%rd7];
	ld.global.u8 	%r31, [%rd7+8];
	shl.b32 	%r31, %r31, 8;
	or.b32 	%r32, %r30, %r31;

	shl.b32 	%r17, %r15, 1;			// the K byte column
	and.b32 	%r19, %r14, 7;
	shl.b32 	%r19, %r19, 4;
	xor.b32 	%r17, %r17, %r19;
	shl.b32 	%r20, %r14, 7;
	add.s32 	%r17, %r17, %r20;
	add.s32 	%r17, %r17, 8192;		// B starts after A's 8 KiB
	cvt.u64.u32 	%rd8, %r17;
	add.s64 	%rd8, %rd5, %rd8;
	st.shared.u16 	[%rd8], %r32;

	bar.sync 	0;

	// Swizzle mode 1 in bits 62-63; B's base field is 512 units of 16 bytes.
	mov.u64 	%rd10, 0x4000004000400000;
	mov.u64 	%rd12, 0x4000004000400200;

	mov.f32 	%f5, 0f00000000;
	mov.f32 	%f6, 0f00000000;
	mov.f32 	%f7, 0f00000000;
	mov.f32 	%f8, 0f00000000;
	wgmma.fence.sync.aligned;
	wgmma.mma_async.sync.aligned.m64n8k32.f32.e4m3.e4m3 {%f5, %f6, %f7, %f8}, %rd10, %rd12, 1;
	wgmma.commit_group.sync.aligned;
	wgmma.wait_group.sync.aligned 0;

	// D[16w+g][2t], [2t+1], [16w+g+8][2t], [2t+1], the Z pattern a warpgroup
	// lane holds for m64n8k16.
	shr.u32 	%r21, %r1, 5;
	shr.u32 	%r22, %r1, 2;
	and.b32 	%r22, %r22, 7;
	and.b32 	%r23, %r1, 3;
	shl.b32 	%r24, %r21, 4;
	add.s32 	%r24, %r24, %r22;
	shl.b32 	%r25, %r24, 5;
	shl.b32 	%r26, %r23, 3;
	add.s32 	%r25, %r25, %r26;
	cvt.u64.u32 	%rd13, %r25;
	add.s64 	%rd13, %rd3, %rd13;
	st.global.b32 	[%rd13], %f5;
	st.global.b32 	[%rd13+4], %f6;
	st.global.b32 	[%rd13+256], %f7;
	st.global.b32 	[%rd13+260], %f8;
	ret;
}

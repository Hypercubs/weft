//
// wgmma with MN-major operands: both descriptors point at tiles whose contiguous
// direction is M for A and N for B, and the last two immediates say so.
//
//     wgmma.mma_async.sync.aligned.m64n8k16.f32.f16.f16 {d}, a, b, 1, 0, 0, 1, 1;
//
// What changes is the walk, not the element count. A core matrix is still 8 by 16
// bytes, but a 16-byte chunk now holds eight values along M instead of eight along
// K, so a core covers a group of eight M values for eight K positions. The
// descriptor's two offsets do not move: SBO still steps between M groups and LBO
// between K groups. Only which direction is contiguous inside the chunk changes,
// which is the mirror of `wgmma.ptx`.
//
// A is 64x16 f16: eight M groups of 8, each owning both K groups, so SBO = 256 and
// LBO = 128, 2048 bytes. B is 16x8, N contiguous, so a chunk holds the eight
// columns and the four K positions... two K groups of eight, LBO = 128, 256 bytes.
//
// The tiles are the same logical matrices as `wgmma.ptx`, staged the other way up,
// so the reference that multiplies the input tiles directly still applies.
.version 8.1
.target sm_90
.address_size 64

.maxntid 128, 1, 1

.visible .entry wgmma_trans_kernel(
	.param .u64 wgmma_trans_kernel_param_0,
	.param .u64 wgmma_trans_kernel_param_1,
	.param .u64 wgmma_trans_kernel_param_2
)
{
	.reg .b32 	%r<48>;
	.reg .f32 	%f<16>;
	.reg .b64 	%rd<24>;

	.shared .align 128 .b8 weft_ab[2304];

	ld.param.u64 	%rd1, [wgmma_trans_kernel_param_0];
	ld.param.u64 	%rd2, [wgmma_trans_kernel_param_1];
	ld.param.u64 	%rd3, [wgmma_trans_kernel_param_2];
	mov.u64 	%rd5, weft_ab;

	mov.u32 	%r1, %tid.x;

	// A: lane -> one (M group, k), eight elements down the M direction. One element
	// at a time: a core-matrix chunk gathers M values that are 32 bytes apart in the
	// row-major input.
	and.b32 	%r2, %r1, 15;			// k
	shr.u32 	%r3, %r1, 4;			// which group of 8 rows
	shl.b32 	%r4, %r3, 8;			// group * 256 bytes
	shl.b32 	%r5, %r2, 1;			// k * 2
	add.s32 	%r4, %r4, %r5;
	cvt.u64.u32 	%rd4, %r4;
	add.s64 	%rd4, %rd1, %rd4;

	shl.b32 	%r6, %r3, 8;			// group * SBO(256)
	shr.u32 	%r7, %r2, 3;
	shl.b32 	%r7, %r7, 7;			// (k / 8) * LBO(128)
	and.b32 	%r8, %r2, 7;
	shl.b32 	%r8, %r8, 4;			// (k % 8) * 16 bytes
	add.s32 	%r9, %r6, %r7;
	add.s32 	%r9, %r9, %r8;
	cvt.u64.u32 	%rd6, %r9;
	add.s64 	%rd6, %rd5, %rd6;

	ld.global.u16 	%r10, [%rd4];
	st.shared.u16 	[%rd6], %r10;
	ld.global.u16 	%r11, [%rd4+32];
	st.shared.u16 	[%rd6+2], %r11;
	ld.global.u16 	%r12, [%rd4+64];
	st.shared.u16 	[%rd6+4], %r12;
	ld.global.u16 	%r13, [%rd4+96];
	st.shared.u16 	[%rd6+6], %r13;
	ld.global.u16 	%r14, [%rd4+128];
	st.shared.u16 	[%rd6+8], %r14;
	ld.global.u16 	%r15, [%rd4+160];
	st.shared.u16 	[%rd6+10], %r15;
	ld.global.u16 	%r16, [%rd4+192];
	st.shared.u16 	[%rd6+12], %r16;
	ld.global.u16 	%r17, [%rd4+224];
	st.shared.u16 	[%rd6+14], %r17;

	// B: one (k, n) a lane. N is contiguous, so the eight columns are the sixteen
	// bytes of a chunk and only k walks between them.
	and.b32 	%r20, %r1, 7;			// n
	shr.u32 	%r21, %r1, 3;			// k
	shl.b32 	%r22, %r21, 3;
	add.s32 	%r22, %r22, %r20;
	shl.b32 	%r22, %r22, 1;
	cvt.u64.u32 	%rd7, %r22;
	add.s64 	%rd7, %rd2, %rd7;
	ld.global.u16 	%r23, [%rd7];

	shr.u32 	%r24, %r21, 3;
	shl.b32 	%r24, %r24, 7;			// (k / 8) * LBO(128)
	and.b32 	%r25, %r21, 7;
	shl.b32 	%r25, %r25, 4;			// (k % 8) * 16 bytes
	add.s32 	%r24, %r24, %r25;
	shl.b32 	%r26, %r20, 1;			// n * 2
	add.s32 	%r24, %r24, %r26;
	add.s32 	%r24, %r24, 2048;
	cvt.u64.u32 	%rd8, %r24;
	add.s64 	%rd8, %rd5, %rd8;
	st.shared.u16 	[%rd8], %r23;

	bar.sync 	0;

	// A: start 0, LBO = 128 bytes (8 units), SBO = 256 (16 units). B: start 2048
	// (128 units), LBO = 128, and an SBO that a single N group never reaches.
	mov.u64 	%rd10, 68720001024;
	mov.u64 	%rd12, 68720001152;

	mov.f32 	%f5, 0f00000000;
	mov.f32 	%f6, 0f00000000;
	mov.f32 	%f7, 0f00000000;
	mov.f32 	%f8, 0f00000000;
	wgmma.fence.sync.aligned;
	wgmma.mma_async.sync.aligned.m64n8k16.f32.f16.f16 {%f5, %f6, %f7, %f8}, %rd10, %rd12, 1, 0, 0, 1, 1;
	wgmma.commit_group.sync.aligned;
	wgmma.wait_group.sync.aligned 0;

	// The accumulator pattern is the instruction's, not the operand layouts'.
	shr.u32 	%r30, %r1, 5;
	shr.u32 	%r31, %r1, 2;
	and.b32 	%r31, %r31, 7;
	and.b32 	%r32, %r1, 3;
	shl.b32 	%r33, %r30, 4;
	add.s32 	%r33, %r33, %r31;
	shl.b32 	%r34, %r33, 5;
	shl.b32 	%r35, %r32, 3;
	add.s32 	%r34, %r34, %r35;
	cvt.u64.u32 	%rd13, %r34;
	add.s64 	%rd13, %rd3, %rd13;
	st.global.b32 	[%rd13], %f5;
	st.global.b32 	[%rd13+4], %f6;
	st.global.b32 	[%rd13+256], %f7;
	st.global.b32 	[%rd13+260], %f8;
	ret;
}

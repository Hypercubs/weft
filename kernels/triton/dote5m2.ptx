//
// Triton: `tl.dot` over fp8 (e5m2), `mma.sync.m16n8k32`, four bytes a register
// and twice the K of the half-precision form.
//
// The operands arrive already converted, as the byte tiles a `cvt`+`prmt` pass
// leaves them, so this kernel is the fragment layout and nothing else: A is a
// 16x32 tile of bytes, B a 32x8 tile of bytes in row-major order, and D comes out
// as the 16x8 tile of f32 the instruction accumulates into.
.version 8.1
.target sm_89
.address_size 64

.visible .entry dote5m2_kernel(
	.param .u64 dote5m2_kernel_param_0,
	.param .u64 dote5m2_kernel_param_1,
	.param .u64 dote5m2_kernel_param_2
)
{
	.reg .b32 	%r<64>;
	.reg .f32 	%f<9>;
	.reg .b64 	%rd<12>;

	ld.param.u64 	%rd1, [dote5m2_kernel_param_0];
	ld.param.u64 	%rd2, [dote5m2_kernel_param_1];
	ld.param.u64 	%rd3, [dote5m2_kernel_param_2];

	mov.u32 	%r1, %tid.x;
	shr.u32 	%r2, %r1, 2;
	and.b32 	%r3, %r1, 3;

	shl.b32 	%r4, %r2, 5;
	shl.b32 	%r5, %r3, 2;
	add.s32 	%r4, %r4, %r5;
	cvt.u64.u32 	%rd4, %r4;
	add.s64 	%rd4, %rd1, %rd4;
	ld.global.b32 	%r10, [%rd4];
	ld.global.b32 	%r11, [%rd4+256];
	ld.global.b32 	%r12, [%rd4+16];
	ld.global.b32 	%r13, [%rd4+272];

	shl.b32 	%r6, %r3, 5;
	add.s32 	%r6, %r6, %r2;
	cvt.u64.u32 	%rd5, %r6;
	add.s64 	%rd5, %rd2, %rd5;
	ld.global.u8 	%r20, [%rd5];
	ld.global.u8 	%r21, [%rd5+8];
	ld.global.u8 	%r22, [%rd5+16];
	ld.global.u8 	%r23, [%rd5+24];
	shl.b32 	%r21, %r21, 8;
	shl.b32 	%r22, %r22, 16;
	shl.b32 	%r23, %r23, 24;
	or.b32 	%r20, %r20, %r21;
	or.b32 	%r22, %r22, %r23;
	or.b32 	%r24, %r20, %r22;
	ld.global.u8 	%r25, [%rd5+128];
	ld.global.u8 	%r26, [%rd5+136];
	ld.global.u8 	%r27, [%rd5+144];
	ld.global.u8 	%r28, [%rd5+152];
	shl.b32 	%r26, %r26, 8;
	shl.b32 	%r27, %r27, 16;
	shl.b32 	%r28, %r28, 24;
	or.b32 	%r25, %r25, %r26;
	or.b32 	%r27, %r27, %r28;
	or.b32 	%r29, %r25, %r27;

	mov.f32 	%f1, 0f00000000;
	mov.f32 	%f2, 0f00000000;
	mov.f32 	%f3, 0f00000000;
	mov.f32 	%f4, 0f00000000;
	mma.sync.aligned.m16n8k32.row.col.f32.e5m2.e5m2.f32 {%f5, %f6, %f7, %f8}, {%r10, %r11, %r12, %r13}, {%r24, %r29}, {%f1, %f2, %f3, %f4};

	shl.b32 	%r30, %r2, 5;
	shl.b32 	%r31, %r3, 3;
	add.s32 	%r30, %r30, %r31;
	cvt.u64.u32 	%rd6, %r30;
	add.s64 	%rd6, %rd3, %rd6;
	st.global.b32 	[%rd6], %f5;
	st.global.b32 	[%rd6+4], %f6;
	st.global.b32 	[%rd6+256], %f7;
	st.global.b32 	[%rd6+260], %f8;
	ret;
}

//
// The swizzle with four-byte elements: `wgmma.mma_async.m64n8k8.f32.tf32.tf32`.
//
// Same descriptor as the f16 fixture — mode 1, a 128-byte atom — and K is 8
// instead of 16 because the K extent of the instruction is 32 bytes and an element
// is four of them. A row of the tile is the 32 bytes of K, which is a quarter of
// the atom's width, so the pattern moves each row's two chunks about on its own.
//
// The walk does not read the element width to place a byte, it reads it to decode
// one, so this fixture is what says the two are kept apart: an atom width counted
// in elements rather than bytes lands every row on the wrong half.
.version 8.1
.target sm_90
.address_size 64

.maxntid 128, 1, 1

.visible .entry wgmma_swztf32_kernel(
	.param .u64 wgmma_swztf32_kernel_param_0,
	.param .u64 wgmma_swztf32_kernel_param_1,
	.param .u64 wgmma_swztf32_kernel_param_2
)
{
	.reg .b32 	%r<40>;
	.reg .f32 	%f<12>;
	.reg .b64 	%rd<16>;
	.reg .pred 	%p<2>;

	// A: 64 rows of 128 bytes, four of the row used. B: eight rows after it.
	.shared .align 1024 .b8 weft_ab[9216];

	ld.param.u64 	%rd1, [wgmma_swztf32_kernel_param_0];
	ld.param.u64 	%rd2, [wgmma_swztf32_kernel_param_1];
	ld.param.u64 	%rd3, [wgmma_swztf32_kernel_param_2];

	mov.u32 	%r1, %tid.x;
	mov.u64 	%rd5, weft_ab;

	// ---- A: one 16-byte chunk of one row, four floats ----
	and.b32 	%r2, %r1, 63;			// row
	shr.u32 	%r3, %r1, 6;			// which chunk of the row
	shl.b32 	%r6, %r3, 4;			// chunk * 16
	shl.b32 	%r4, %r2, 5;			// row * 32 bytes in the source tile
	add.s32 	%r4, %r4, %r6;
	cvt.u64.u32 	%rd4, %r4;
	add.s64 	%rd4, %rd1, %rd4;
	ld.global.v4.b32 	{%r10, %r11, %r12, %r13}, [%rd4];

	and.b32 	%r8, %r2, 7;
	shl.b32 	%r8, %r8, 4;
	xor.b32 	%r9, %r6, %r8;			// chunk ^ (row & 7) << 4
	shl.b32 	%r7, %r2, 7;
	add.s32 	%r9, %r9, %r7;
	cvt.u64.u32 	%rd6, %r9;
	add.s64 	%rd6, %rd5, %rd6;
	st.shared.v4.b32 	[%rd6], {%r10, %r11, %r12, %r13};

	// ---- B: one float — row n = lane / 2, half of its 32 bytes = lane % 2 ----
	setp.lt.u32 	%p1, %r1, 16;
	shr.u32 	%r14, %r1, 1;
	and.b32 	%r14, %r14, 7;			// n
	and.b32 	%r15, %r1, 1;			// which four values of K
	shl.b32 	%r16, %r15, 7;			// four values in, 128 bytes
	shl.b32 	%r17, %r14, 2;			// four bytes a value, one row at a time
	add.s32 	%r16, %r16, %r17;
	cvt.u64.u32 	%rd7, %r16;
	add.s64 	%rd7, %rd2, %rd7;

	// B[k][n] is eight values apart, so the four of a chunk are four loads.
	ld.global.f32 	%r10, [%rd7];
	ld.global.f32 	%r11, [%rd7+32];
	ld.global.f32 	%r12, [%rd7+64];
	ld.global.f32 	%r13, [%rd7+96];

	and.b32 	%r19, %r14, 7;
	shl.b32 	%r19, %r19, 4;
	shl.b32 	%r20, %r15, 4;			// the chunk's own 16 bytes
	xor.b32 	%r20, %r20, %r19;
	shl.b32 	%r21, %r14, 7;
	add.s32 	%r20, %r20, %r21;
	add.s32 	%r20, %r20, 8192;
	cvt.u64.u32 	%rd8, %r20;
	add.s64 	%rd8, %rd5, %rd8;
	@%p1 st.shared.v4.b32 	[%rd8], {%r10, %r11, %r12, %r13};

	bar.sync 	0;

	// Swizzle mode 1 in bits 62-63; LBO and SBO are 1024 bytes, 64 units. B starts
	// at 8192, which is the base field's 512 units of 16 bytes.
	mov.u64 	%rd10, 0x4000004000400000;
	mov.u64 	%rd12, 0x4000004000400200;

	mov.f32 	%f5, 0f00000000;
	mov.f32 	%f6, 0f00000000;
	mov.f32 	%f7, 0f00000000;
	mov.f32 	%f8, 0f00000000;
	wgmma.fence.sync.aligned;
	wgmma.mma_async.sync.aligned.m64n8k8.f32.tf32.tf32 {%f5, %f6, %f7, %f8}, %rd10, %rd12, 1;
	wgmma.commit_group.sync.aligned;
	wgmma.wait_group.sync.aligned 0;

	// D[16w+g][2t], [2t+1], [16w+g+8][2t], [2t+1] — the Z pattern a warpgroup
	// lane holds for m64n8k16.
	shr.u32 	%r21, %r1, 5;
	shr.u32 	%r22, %r1, 2;
	and.b32 	%r22, %r22, 7;
	and.b32 	%r23, %r1, 3;
	shl.b32 	%r24, %r21, 4;
	add.s32 	%r24, %r24, %r22;
	shl.b32 	%r25, %r24, 5;
	shl.b32 	%r26, %r23, 3;
	add.s32 	%r25, %r25, %r26;
	cvt.u64.u32 	%rd13, %r25;
	add.s64 	%rd13, %rd3, %rd13;
	st.global.b32 	[%rd13], %f5;
	st.global.b32 	[%rd13+4], %f6;
	st.global.b32 	[%rd13+256], %f7;
	st.global.b32 	[%rd13+260], %f8;
	ret;
}

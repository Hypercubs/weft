//
// wgmma accumulating into its own result: the same instruction issued twice, both
// with scale-d = 1.
//
//     D = A*B + D        (scale-d 1)
//
// The first issue adds the product to the zeroed accumulator and the second adds it
// again, so the buffer holds 2 * A * B. That is the only thing in the suite that
// tests scale-d at all: every other fixture writes a value and stops, so a
// translator that treated scale-d as "overwrite" would agree with all of them. A
// real `tl.dot` chain — `for k: acc += tl.dot(a, b)` — is exactly this shape, and
// getting it wrong loses every tile but the last.
//
// A is 64x16 f16 and B is 16x8, both K-major, staged as in `wgmma.ptx`.
.version 8.1
.target sm_90
.address_size 64

.maxntid 128, 1, 1

.visible .entry wgmma_acc_kernel(
	.param .u64 wgmma_acc_kernel_param_0,
	.param .u64 wgmma_acc_kernel_param_1,
	.param .u64 wgmma_acc_kernel_param_2
)
{
	.reg .b32 	%r<48>;
	.reg .f32 	%f<16>;
	.reg .b64 	%rd<24>;

	.shared .align 128 .b8 weft_ab[2304];

	ld.param.u64 	%rd1, [wgmma_acc_kernel_param_0];
	ld.param.u64 	%rd2, [wgmma_acc_kernel_param_1];
	ld.param.u64 	%rd3, [wgmma_acc_kernel_param_2];
	mov.u64 	%rd5, weft_ab;

	mov.u32 	%r1, %tid.x;

	// A: lane -> one row and one K core matrix, 16 bytes each.
	and.b32 	%r2, %r1, 63;
	shr.u32 	%r3, %r1, 6;
	shl.b32 	%r4, %r2, 5;
	shl.b32 	%r5, %r3, 4;
	add.s32 	%r4, %r4, %r5;
	cvt.u64.u32 	%rd4, %r4;
	add.s64 	%rd4, %rd1, %rd4;
	ld.global.v4.b32 	{%r10, %r11, %r12, %r13}, [%rd4];

	shr.u32 	%r6, %r2, 3;
	shl.b32 	%r6, %r6, 8;			// (row / 8) * SBO(256)
	shl.b32 	%r7, %r3, 7;			// core row * LBO(128)
	and.b32 	%r8, %r2, 7;
	shl.b32 	%r8, %r8, 4;
	add.s32 	%r9, %r6, %r7;
	add.s32 	%r9, %r9, %r8;
	cvt.u64.u32 	%rd6, %r9;
	add.s64 	%rd6, %rd5, %rd6;
	st.shared.v4.b32 	[%rd6], {%r10, %r11, %r12, %r13};

	// B: lane -> one (k, n). K is contiguous, so a column is a 16-byte chunk and the
	// eight columns are 16 bytes apart.
	shr.u32 	%r14, %r1, 3;			// k (0..15)
	and.b32 	%r15, %r1, 7;			// n
	shl.b32 	%r16, %r14, 4;			// k * 16 bytes
	shl.b32 	%r17, %r15, 1;			// n * 2
	add.s32 	%r16, %r16, %r17;
	cvt.u64.u32 	%rd7, %r16;
	add.s64 	%rd7, %rd2, %rd7;
	ld.global.u16 	%r18, [%rd7];

	shr.u32 	%r19, %r14, 3;
	shl.b32 	%r19, %r19, 7;			// (k / 8) * LBO(128)
	shl.b32 	%r20, %r15, 4;			// n * 16 bytes
	add.s32 	%r19, %r19, %r20;
	and.b32 	%r21, %r14, 7;
	shl.b32 	%r21, %r21, 1;			// (k % 8) * 2 bytes
	add.s32 	%r19, %r19, %r21;
	add.s32 	%r19, %r19, 2048;
	cvt.u64.u32 	%rd8, %r19;
	add.s64 	%rd8, %rd5, %rd8;
	st.shared.u16 	[%rd8], %r18;

	bar.sync 	0;

	mov.u64 	%rd10, 68720001024;
	mov.u64 	%rd12, 68720001152;

	// The accumulator starts at zero, so both issues add to a known value.
	mov.f32 	%f5, 0f00000000;
	mov.f32 	%f6, 0f00000000;
	mov.f32 	%f7, 0f00000000;
	mov.f32 	%f8, 0f00000000;
	wgmma.fence.sync.aligned;
	wgmma.mma_async.sync.aligned.m64n8k16.f32.f16.f16 {%f5, %f6, %f7, %f8}, %rd10, %rd12, 1;
	wgmma.commit_group.sync.aligned;
	wgmma.wait_group.sync.aligned 0;
	// The same product once more, onto the value the first issue left.
	wgmma.fence.sync.aligned;
	wgmma.mma_async.sync.aligned.m64n8k16.f32.f16.f16 {%f5, %f6, %f7, %f8}, %rd10, %rd12, 1;
	wgmma.commit_group.sync.aligned;
	wgmma.wait_group.sync.aligned 0;

	shr.u32 	%r30, %r1, 5;
	shr.u32 	%r31, %r1, 2;
	and.b32 	%r31, %r31, 7;
	and.b32 	%r32, %r1, 3;
	shl.b32 	%r33, %r30, 4;
	add.s32 	%r33, %r33, %r31;
	shl.b32 	%r34, %r33, 5;
	shl.b32 	%r35, %r32, 3;
	add.s32 	%r34, %r34, %r35;
	cvt.u64.u32 	%rd13, %r34;
	add.s64 	%rd13, %rd3, %rd13;
	st.global.b32 	[%rd13], %f5;
	st.global.b32 	[%rd13+4], %f6;
	st.global.b32 	[%rd13+256], %f7;
	st.global.b32 	[%rd13+260], %f8;
	ret;
}

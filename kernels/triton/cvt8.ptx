//
// Triton: the conversion that builds an fp8 operand, `cvt.rn.satfinite.e4m3x2.f32`
// for two floats at a time, then `prmt` to join two such pairs into the four bytes
// one fragment register holds. LLVM emits exactly this sequence for a `tl.dot`
// whose operands are floated through `to(tl.float8e4nv)`.
.version 8.1
.target sm_89
.address_size 64

.visible .entry cvt8_kernel(
	.param .u64 cvt8_kernel_param_0,
	.param .u64 cvt8_kernel_param_1
)
{
	.reg .b32 	%r<12>;
	.reg .f32 	%f<8>;
	.reg .b64 	%rd<8>;

	ld.param.u64 	%rd1, [cvt8_kernel_param_0];
	ld.param.u64 	%rd2, [cvt8_kernel_param_1];
	mov.u32 	%r1, %tid.x;
	shl.b32 	%r2, %r1, 4;
	cvt.u64.u32 	%rd3, %r2;
	add.s64 	%rd3, %rd1, %rd3;
	ld.global.v4.b32 	{%f1, %f2, %f3, %f4}, [%rd3];
	cvt.rn.satfinite.e4m3x2.f32 %r3, %f2, %f1;
	cvt.rn.satfinite.e4m3x2.f32 %r4, %f4, %f3;
	prmt.b32 	%r5, %r3, %r4, 0x5410;
	shl.b32 	%r6, %r1, 2;
	cvt.u64.u32 	%rd4, %r6;
	add.s64 	%rd4, %rd2, %rd4;
	st.global.b32 	[%rd4], %r5;
	ret;
}

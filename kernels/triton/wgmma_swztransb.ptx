//
// The other transpose: B is MN-major, A stays K-major, and both are swizzled.
//
// With trans-b set, N is B's contiguous direction, so a row of the atom is the
// eight columns — 16 bytes — and eight K rows make one atom. LBO therefore steps
// between atoms along K, 1024 bytes apart, and the second half of K lives in the
// second atom. The phase is the row's own: rows 0-7 of the pattern are the eight
// K rows of the atom.
//
// This is the mirror of the transposed-A fixture with the roles swapped, and the
// two together are what say the walk's two directions are not the same code with
// a flag: A's M and B's N are both the contiguous direction but they sit in
// different operands, so a walk that swapped the pair reads the wrong operand
// entirely.
.version 8.1
.target sm_90
.address_size 64

.maxntid 128, 1, 1

.visible .entry wgmma_swztransb_kernel(
	.param .u64 wgmma_swztransb_kernel_param_0,
	.param .u64 wgmma_swztransb_kernel_param_1,
	.param .u64 wgmma_swztransb_kernel_param_2
)
{
	.reg .b32 	%r<40>;
	.reg .f32 	%f<12>;
	.reg .b64 	%rd<16>;
	.reg .pred 	%p<2>;

	// A: 64 rows of 128 bytes. B: two atoms of eight K rows, 2048 bytes.
	.shared .align 1024 .b8 weft_ab[10240];

	ld.param.u64 	%rd1, [wgmma_swztransb_kernel_param_0];
	ld.param.u64 	%rd2, [wgmma_swztransb_kernel_param_1];
	ld.param.u64 	%rd3, [wgmma_swztransb_kernel_param_2];

	mov.u32 	%r1, %tid.x;
	mov.u64 	%rd5, weft_ab;

	// ---- A: K-major, one 16-byte chunk of one row ----
	and.b32 	%r2, %r1, 63;			// row
	shr.u32 	%r3, %r1, 6;			// which chunk of the row
	shl.b32 	%r6, %r3, 4;			// chunk * 16
	shl.b32 	%r4, %r2, 5;			// row * 32 bytes in the source tile
	add.s32 	%r4, %r4, %r6;
	cvt.u64.u32 	%rd4, %r4;
	add.s64 	%rd4, %rd1, %rd4;
	ld.global.v4.b32 	{%r10, %r11, %r12, %r13}, [%rd4];

	and.b32 	%r8, %r2, 7;
	shl.b32 	%r8, %r8, 4;
	xor.b32 	%r9, %r6, %r8;
	shl.b32 	%r7, %r2, 7;
	add.s32 	%r9, %r9, %r7;
	cvt.u64.u32 	%rd6, %r9;
	add.s64 	%rd6, %rd5, %rd6;
	st.shared.v4.b32 	[%rd6], {%r10, %r11, %r12, %r13};

	// ---- B: MN-major, one K row of eight columns — lane = K row ----
	setp.lt.u32 	%p1, %r1, 16;
	shl.b32 	%r14, %r1, 4;			// a K row is eight values, 16 bytes
	cvt.u64.u32 	%rd7, %r14;
	add.s64 	%rd7, %rd2, %rd7;
	ld.global.v4.b32 	{%r10, %r11, %r12, %r13}, [%rd7];

	shr.u32 	%r18, %r1, 3;			// the atom K = 8 lands in
	shl.b32 	%r18, %r18, 10;			// 1024 bytes an atom
	and.b32 	%r19, %r1, 7;
	shl.b32 	%r19, %r19, 7;			// 128 bytes a row
	add.s32 	%r18, %r18, %r19;
	and.b32 	%r20, %r1, 7;
	shl.b32 	%r20, %r20, 4;			// the pattern's phase for this row
	add.s32 	%r18, %r18, %r20;		// the row holds one 16-byte chunk
	add.s32 	%r18, %r18, 8192;
	cvt.u64.u32 	%rd8, %r18;
	add.s64 	%rd8, %rd5, %rd8;
	@%p1 st.shared.v4.b32 	[%rd8], {%r10, %r11, %r12, %r13};

	bar.sync 	0;

	// Both mode 1; A at 0, B at 8192. LBO and SBO are 1024 bytes, 64 units.
	mov.u64 	%rd10, 0x4000004000400000;
	mov.u64 	%rd12, 0x4000004000400200;

	mov.f32 	%f5, 0f00000000;
	mov.f32 	%f6, 0f00000000;
	mov.f32 	%f7, 0f00000000;
	mov.f32 	%f8, 0f00000000;
	wgmma.fence.sync.aligned;
	wgmma.mma_async.sync.aligned.m64n8k16.f32.f16.f16 {%f5, %f6, %f7, %f8}, %rd10, %rd12, 1, 0, 0, 0, 1;
	wgmma.commit_group.sync.aligned;
	wgmma.wait_group.sync.aligned 0;

	// D[16w+g][2t], [2t+1], [16w+g+8][2t], [2t+1] — the Z pattern a warpgroup
	// lane holds for m64n8k16.
	shr.u32 	%r21, %r1, 5;
	shr.u32 	%r22, %r1, 2;
	and.b32 	%r22, %r22, 7;
	and.b32 	%r23, %r1, 3;
	shl.b32 	%r24, %r21, 4;
	add.s32 	%r24, %r24, %r22;
	shl.b32 	%r25, %r24, 5;
	shl.b32 	%r26, %r23, 3;
	add.s32 	%r25, %r25, %r26;
	cvt.u64.u32 	%rd13, %r25;
	add.s64 	%rd13, %rd3, %rd13;
	st.global.b32 	[%rd13], %f5;
	st.global.b32 	[%rd13+4], %f6;
	st.global.b32 	[%rd13+256], %f7;
	st.global.b32 	[%rd13+260], %f8;
	ret;
}

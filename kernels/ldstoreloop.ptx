// A store whose address changes from one iteration to the next.
.version 8.8
.target sm_100a
.address_size 64

.visible .entry ldstoreloop(
    .param .u64 ldstoreloop_param_0     // out: two blocks of 128 words
)
{
    .reg .b32 %r<24>;
    .reg .b64 %rd<12>;
    .reg .pred %p<4>;

    ld.param.u64 %rd1, [ldstoreloop_param_0];
    mov.u32 %r1, %tid.x;
    mul.wide.s32 %rd2, %r1, 16;
    add.s64 %rd3, %rd1, %rd2;               // out + 16l

    // block 0: four stores, written out
    shl.b32 %r2, %r1, 3;                    // 8l
    add.u32 %r3, %r2, 1;
    shl.b32 %r3, %r3, 16;
    or.b32 %r3, %r3, %r2;
    st.global.b32 [%rd3], %r3;
    add.u32 %r2, %r2, 2;
    add.u32 %r4, %r2, 1;
    shl.b32 %r4, %r4, 16;
    or.b32 %r4, %r4, %r2;
    st.global.b32 [%rd3+4], %r4;
    add.u32 %r2, %r2, 2;
    add.u32 %r5, %r2, 1;
    shl.b32 %r5, %r5, 16;
    or.b32 %r5, %r5, %r2;
    st.global.b32 [%rd3+8], %r5;
    add.u32 %r2, %r2, 2;
    add.u32 %r6, %r2, 1;
    shl.b32 %r6, %r6, 16;
    or.b32 %r6, %r6, %r2;
    st.global.b32 [%rd3+12], %r6;

    // block 1: the same four, walking the pointer
    add.s64 %rd4, %rd3, 512;
    shl.b32 %r7, %r1, 3;
    mov.u32 %r8, 0;
LOOP: setp.ge.u32 %p1, %r8, 4;
    @%p1 bra LOOPD;
    shl.b32 %r9, %r8, 1;                    // 2i
    add.u32 %r10, %r7, %r9;                 // 8l + 2i
    add.u32 %r11, %r10, 1;
    shl.b32 %r11, %r11, 16;
    or.b32 %r11, %r11, %r10;
    st.global.b32 [%rd4], %r11;
    add.s64 %rd4, %rd4, 4;
    add.u32 %r8, %r8, 1;
    bra LOOP;
LOOPD:
    ret;
}

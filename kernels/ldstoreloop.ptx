// A store whose address changes from one iteration to the next. The warp backend
// batches a store whose lanes walk consecutive addresses into one loop over that
// run, which is only valid if the address is the same expression every time the
// statement runs. It used to fold a register's first value into that address, so a
// loop that walked a pointer wrote every iteration's word to the first iteration's
// slot: the first block below is four stores written out, the second is the same
// four from a loop that advances the pointer, and both have to answer the same
// thing.
//
// Block 0 is at word 4l, one store a round, and block 1 at word 128 + 4l from the
// loop, lane l's half h holding 8l + 2i for round i, so each word is
//     h | (h + 1) << 16,  h = 8l + 2i
// in both blocks. A folded address puts the loop's four words on one slot, so the
// second block is the one that disagrees, and the first block stays right, which is
// what makes the two halves a check on each other.
.version 8.8
.target sm_100a
.address_size 64

.visible .entry ldstoreloop(
    .param .u64 ldstoreloop_param_0     // out: two blocks of 128 words
)
{
    .reg .b32 %r<24>;
    .reg .b64 %rd<12>;
    .reg .pred %p<4>;

    ld.param.u64 %rd1, [ldstoreloop_param_0];
    mov.u32 %r1, %tid.x;
    mul.wide.s32 %rd2, %r1, 16;
    add.s64 %rd3, %rd1, %rd2;               // out + 16l

    // ---- block 0: four stores, written out ----
    shl.b32 %r2, %r1, 3;                    // 8l
    add.u32 %r3, %r2, 1;
    shl.b32 %r3, %r3, 16;
    or.b32 %r3, %r3, %r2;
    st.global.b32 [%rd3], %r3;
    add.u32 %r2, %r2, 2;
    add.u32 %r4, %r2, 1;
    shl.b32 %r4, %r4, 16;
    or.b32 %r4, %r4, %r2;
    st.global.b32 [%rd3+4], %r4;
    add.u32 %r2, %r2, 2;
    add.u32 %r5, %r2, 1;
    shl.b32 %r5, %r5, 16;
    or.b32 %r5, %r5, %r2;
    st.global.b32 [%rd3+8], %r5;
    add.u32 %r2, %r2, 2;
    add.u32 %r6, %r2, 1;
    shl.b32 %r6, %r6, 16;
    or.b32 %r6, %r6, %r2;
    st.global.b32 [%rd3+12], %r6;

    // ---- block 1: the same four, walking the pointer ----
    add.s64 %rd4, %rd3, 512;
    shl.b32 %r7, %r1, 3;
    mov.u32 %r8, 0;
LOOP: setp.ge.u32 %p1, %r8, 4;
    @%p1 bra LOOPD;
    shl.b32 %r9, %r8, 1;                    // 2i
    add.u32 %r10, %r7, %r9;                 // 8l + 2i
    add.u32 %r11, %r10, 1;
    shl.b32 %r11, %r11, 16;
    or.b32 %r11, %r11, %r10;
    st.global.b32 [%rd4], %r11;
    add.s64 %rd4, %rd4, 4;
    add.u32 %r8, %r8, 1;
    bra LOOP;
LOOPD:
    ret;
}

// A 2D *array* texture from PTX, the twin of basic.metal's `texarray`:
//
//     n = txq.depth(tex)                          // the slices an `.a2d` binding has
//     x = gid & 63, y = (gid >> 6) & 63, l = (x + y) & 3
//     t = tex.a2d(tex, (x + 0.5) / 64, (y + 0.5) / 64, l)   // nearest, clamped
//     out[gid] = t * 2 + n + l
//
// `.a2d` is the layered form: the third coordinate is the slice, and it is a
// float at the instruction boundary, CUDA's `tex2DLayered` passes it as one,
// which the translator truncates to the index the slice has. `txq.depth` on such
// a binding reports the slice count, because that is the one number a layered
// kernel has no other way to learn. Both are folded into the value, so a wrong
// slice, a wrong count, or a sample that ignored the layer all show up as a
// different number rather than hiding in a register.
.version 7.0
.target sm_70
.address_size 64

.tex .u32 tex, 1, 1, 1, 1;

.visible .entry ptxarray(
    .param .u64 ptxarray_param_0
)
{
    .reg .b32 %r<16>;
    .reg .f32 %f<24>;
    .reg .b64 %rd<8>;

    ld.param.u64 %rd1, [ptxarray_param_0];
    mov.u32 %r1, %tid.x;
    mov.u32 %r2, %ctaid.x;
    mov.u32 %r3, %ntid.x;
    mad.lo.s32 %r4, %r2, %r3, %r1;      // gid

    // The slice count the binding reports, not a number written into the kernel.
    txq.depth.b32 %r5, [tex];

    and.b32 %r6, %r4, 63;               // x = gid & 63
    shr.u32 %r7, %r4, 6;
    and.b32 %r7, %r7, 63;               // y = (gid >> 6) & 63
    add.s32 %r8, %r6, %r7;
    and.b32 %r9, %r8, 3;                // layer = (x + y) & 3

    cvt.rn.f32.u32 %f1, %r6;
    cvt.rn.f32.u32 %f2, %r7;
    add.f32 %f3, %f1, 0f3F000000;       // x + 0.5
    add.f32 %f4, %f2, 0f3F000000;       // y + 0.5
    mul.f32 %f5, %f3, 0f3B800000;       // (x + 0.5) / 64
    mul.f32 %f6, %f4, 0f3B800000;       // (y + 0.5) / 64
    cvt.rn.f32.s32 %f7, %r9;            // the layer, as a coordinate

    tex.a2d.v4.f32.f32 {%f8,%f9,%f10,%f11}, [tex, {%f5,%f6,%f7}];

    mul.f32 %f12, %f8, 0f40000000;      // t * 2
    cvt.rn.f32.u32 %f13, %r5;           // the slice count, from txq.depth
    add.f32 %f14, %f12, %f13;
    cvt.rn.f32.s32 %f15, %r9;
    add.f32 %f16, %f14, %f15;
    mul.wide.s32 %rd3, %r4, 4;
    add.s64 %rd4, %rd1, %rd3;
    st.global.f32 [%rd4], %f16;
    ret;
}

.version 8.6
.target sm_100
.address_size 64

// A function that calls itself as the last thing it does. The call is a loop, so no
// frame is needed: it adds n down to zero into one word, and the answer is 21 for six.
.visible .func addcount(
    .param .u64 acc,
    .param .u32 n
)
{
    .reg .b64 %rd<2>;
    .reg .b32 %r<4>;
    .reg .pred %p<2>;

    ld.param.u64 %rd1, [acc];
    ld.param.u32 %r1, [n];
    ld.global.u32 %r2, [%rd1];
    add.u32 %r2, %r2, %r1;
    st.global.u32 [%rd1], %r2;
    setp.eq.u32 %p1, %r1, 0;
    @%p1 ret;

    sub.u32 %r3, %r1, 1;
    call.uni addcount, (%rd1, %r3);
    ret;
}

.visible .entry callself(
    .param .u64 in
)
{
    .reg .b64 %rd<2>;
    .reg .b32 %r<2>;

    ld.param.u64 %rd1, [in];
    mov.u32 %r1, 0;
    st.global.u32 [%rd1], %r1;
    mov.u32 %r1, 6;
    call.uni addcount, (%rd1, %r1);
    ret;
}

// Division, reciprocal and square root of a half. Each is one rounding to the nearest
// half, computed on the significands: a quotient keeps 48 bits above the grid with the
// remainder as sticky, and a root is the integer root of an even-exponent significand.
//
// ptxas has no half `div`, `rcp` or `sqrt`, so each is the half widened to a double (an
// exact widening), the double form -- 53 bits of quotient, which is past every half tie
// these inputs can make -- and one rounding back to the half grid. The canonical NaN the
// isa answers with is written out too: the double's quotient carries its own payload.
// Sixteen results a lane, chosen where a widening to float would round twice:
//
//   0  div  2.0 / 3.0
//   1  div  1.0 / 3.0
//   2  div  1.0 / 7.0
//   3  div  1.0 / (1+2^-10)
//   4  rcp  3.0                 the same quotient as slot 1, from the reciprocal form
//   5  rcp  1 + 2^-9
//   6  sqrt 2.0
//   7  sqrt 3.0
//   8  sqrt 65504
//   9  sqrt 2^-24               subnormal in, normal out
//  10  div  2^-24 / 3.0         a subnormal result, rounded on its own grid
//  11  div  2^-24 / 1.5         the same grid, landing one step up
//  12  div  1.0 / 65504         a subnormal result from a normal quotient
//  13  div  1.0 / 0.0           +inf
//  14  div  0.0 / 0.0           the canonical NaN
//  15  sqrt -1.0                the canonical NaN
.version 7.0
.target sm_80
.address_size 64

.visible .entry narrowdiv(
    .param .u64 narrowdiv_param_0   // out: sixteen halfs a lane
)
{
    .reg .b16 %hs<10>;
    .reg .b32 %r<4>;
    .reg .b64 %rd<8>;
    .reg .f64 %df<4>;
    .reg .pred %ps<2>;

    ld.param.u64 %rd1, [narrowdiv_param_0];
    mov.u32 %r1, %tid.x;
    mul.wide.u32 %rd2, %r1, 32;
    add.u64 %rd3, %rd1, %rd2;

    mov.b16 %hs1, 0x4000;     // 2.0
    mov.b16 %hs2, 0x4200;     // 3.0
    mov.b16 %hs3, 0x3C00;     // 1.0
    mov.b16 %hs4, 0x4700;     // 7.0
    mov.b16 %hs5, 0x3C01;     // 1 + 2^-10
    mov.b16 %hs6, 0x3C02;     // 1 + 2^-9
    mov.b16 %hs7, 0x7BFF;     // the largest finite half
    mov.b16 %hs8, 0x0001;     // the smallest subnormal, 2^-24
    mov.b16 %hs9, 0x0000;     // +0

    cvt.f64.f16 %df1, %hs1;
    cvt.f64.f16 %df2, %hs2;
    div.rn.f64 %df3, %df1, %df2;
    setp.nan.f64 %ps1, %df3, %df3;
    cvt.rn.f16.f64 %hs0, %df3;
    selp.b16 %hs0, 0x7FFF, %hs0, %ps1;
    st.global.b16 [%rd3], %hs0;
    cvt.f64.f16 %df1, %hs3;
    cvt.f64.f16 %df2, %hs2;
    div.rn.f64 %df3, %df1, %df2;
    setp.nan.f64 %ps1, %df3, %df3;
    cvt.rn.f16.f64 %hs0, %df3;
    selp.b16 %hs0, 0x7FFF, %hs0, %ps1;
    st.global.b16 [%rd3+2], %hs0;
    cvt.f64.f16 %df1, %hs3;
    cvt.f64.f16 %df2, %hs4;
    div.rn.f64 %df3, %df1, %df2;
    setp.nan.f64 %ps1, %df3, %df3;
    cvt.rn.f16.f64 %hs0, %df3;
    selp.b16 %hs0, 0x7FFF, %hs0, %ps1;
    st.global.b16 [%rd3+4], %hs0;
    cvt.f64.f16 %df1, %hs3;
    cvt.f64.f16 %df2, %hs5;
    div.rn.f64 %df3, %df1, %df2;
    setp.nan.f64 %ps1, %df3, %df3;
    cvt.rn.f16.f64 %hs0, %df3;
    selp.b16 %hs0, 0x7FFF, %hs0, %ps1;
    st.global.b16 [%rd3+6], %hs0;
    cvt.f64.f16 %df1, %hs2;
    mov.f64 %df2, 0d3FF0000000000000;
    div.rn.f64 %df3, %df2, %df1;
    setp.nan.f64 %ps1, %df3, %df3;
    cvt.rn.f16.f64 %hs0, %df3;
    selp.b16 %hs0, 0x7FFF, %hs0, %ps1;
    st.global.b16 [%rd3+8], %hs0;
    cvt.f64.f16 %df1, %hs6;
    mov.f64 %df2, 0d3FF0000000000000;
    div.rn.f64 %df3, %df2, %df1;
    setp.nan.f64 %ps1, %df3, %df3;
    cvt.rn.f16.f64 %hs0, %df3;
    selp.b16 %hs0, 0x7FFF, %hs0, %ps1;
    st.global.b16 [%rd3+10], %hs0;
    cvt.f64.f16 %df1, %hs1;
    sqrt.rn.f64 %df3, %df1;
    setp.nan.f64 %ps1, %df3, %df3;
    cvt.rn.f16.f64 %hs0, %df3;
    selp.b16 %hs0, 0x7FFF, %hs0, %ps1;
    st.global.b16 [%rd3+12], %hs0;
    cvt.f64.f16 %df1, %hs2;
    sqrt.rn.f64 %df3, %df1;
    setp.nan.f64 %ps1, %df3, %df3;
    cvt.rn.f16.f64 %hs0, %df3;
    selp.b16 %hs0, 0x7FFF, %hs0, %ps1;
    st.global.b16 [%rd3+14], %hs0;
    cvt.f64.f16 %df1, %hs7;
    sqrt.rn.f64 %df3, %df1;
    setp.nan.f64 %ps1, %df3, %df3;
    cvt.rn.f16.f64 %hs0, %df3;
    selp.b16 %hs0, 0x7FFF, %hs0, %ps1;
    st.global.b16 [%rd3+16], %hs0;
    cvt.f64.f16 %df1, %hs8;
    sqrt.rn.f64 %df3, %df1;
    setp.nan.f64 %ps1, %df3, %df3;
    cvt.rn.f16.f64 %hs0, %df3;
    selp.b16 %hs0, 0x7FFF, %hs0, %ps1;
    st.global.b16 [%rd3+18], %hs0;
    cvt.f64.f16 %df1, %hs8;
    cvt.f64.f16 %df2, %hs2;
    div.rn.f64 %df3, %df1, %df2;
    setp.nan.f64 %ps1, %df3, %df3;
    cvt.rn.f16.f64 %hs0, %df3;
    selp.b16 %hs0, 0x7FFF, %hs0, %ps1;
    st.global.b16 [%rd3+20], %hs0;
    mov.b16 %hs1, 0x3E00;     // 1.5
    cvt.f64.f16 %df1, %hs8;
    cvt.f64.f16 %df2, %hs1;
    div.rn.f64 %df3, %df1, %df2;
    setp.nan.f64 %ps1, %df3, %df3;
    cvt.rn.f16.f64 %hs0, %df3;
    selp.b16 %hs0, 0x7FFF, %hs0, %ps1;
    st.global.b16 [%rd3+22], %hs0;
    cvt.f64.f16 %df1, %hs3;
    cvt.f64.f16 %df2, %hs7;
    div.rn.f64 %df3, %df1, %df2;
    setp.nan.f64 %ps1, %df3, %df3;
    cvt.rn.f16.f64 %hs0, %df3;
    selp.b16 %hs0, 0x7FFF, %hs0, %ps1;
    st.global.b16 [%rd3+24], %hs0;
    cvt.f64.f16 %df1, %hs3;
    cvt.f64.f16 %df2, %hs9;
    div.rn.f64 %df3, %df1, %df2;
    setp.nan.f64 %ps1, %df3, %df3;
    cvt.rn.f16.f64 %hs0, %df3;
    selp.b16 %hs0, 0x7FFF, %hs0, %ps1;
    st.global.b16 [%rd3+26], %hs0;
    cvt.f64.f16 %df1, %hs9;
    cvt.f64.f16 %df2, %hs9;
    div.rn.f64 %df3, %df1, %df2;
    setp.nan.f64 %ps1, %df3, %df3;
    cvt.rn.f16.f64 %hs0, %df3;
    selp.b16 %hs0, 0x7FFF, %hs0, %ps1;
    st.global.b16 [%rd3+28], %hs0;
    mov.b16 %hs2, 0xBC00;     // -1.0
    cvt.f64.f16 %df1, %hs2;
    sqrt.rn.f64 %df3, %df1;
    setp.nan.f64 %ps1, %df3, %df3;
    cvt.rn.f16.f64 %hs0, %df3;
    selp.b16 %hs0, 0x7FFF, %hs0, %ps1;
    st.global.b16 [%rd3+30], %hs0;
    ret;
}

// The infinities, zeros and the one exact tie a subnormal can make:
//
//   0  div  5.0 / inf        +0
//   1  div -5.0 / inf        -0, which a zero written as +0 would lose
//   2  div  inf / inf        the canonical NaN
//   3  div  inf / -2.0       -inf
//   4  rcp  0.0              +inf
//   5  sqrt -0.0             -0
//   6  div  2^-24 / 2.0      exactly halfway between 0 and 2^-24: ties to even, +0
//   7  sqrt 1 + 2^-10        just under the midpoint, so it rounds to 1.0
.visible .entry narrowdiv2(
    .param .u64 narrowdiv2_param_0  // out: eight halfs a lane
)
{
    .reg .b16 %hs<10>;
    .reg .b32 %r<4>;
    .reg .b64 %rd<8>;
    .reg .f64 %df<4>;
    .reg .pred %ps<2>;

    ld.param.u64 %rd1, [narrowdiv2_param_0];
    mov.u32 %r1, %tid.x;
    mul.wide.u32 %rd2, %r1, 16;
    add.u64 %rd3, %rd1, %rd2;

    mov.b16 %hs1, 0x4500;     // 5.0
    mov.b16 %hs2, 0x7C00;     // +inf
    mov.b16 %hs3, 0xC500;     // -5.0
    mov.b16 %hs4, 0xC000;     // -2.0
    mov.b16 %hs5, 0x0000;     // +0
    mov.b16 %hs6, 0x8000;     // -0
    mov.b16 %hs7, 0x3C01;     // 1 + 2^-10
    mov.b16 %hs8, 0x0001;     // 2^-24
    mov.b16 %hs9, 0x4000;     // 2.0

    cvt.f64.f16 %df1, %hs1;
    cvt.f64.f16 %df2, %hs2;
    div.rn.f64 %df3, %df1, %df2;
    setp.nan.f64 %ps1, %df3, %df3;
    cvt.rn.f16.f64 %hs0, %df3;
    selp.b16 %hs0, 0x7FFF, %hs0, %ps1;
    st.global.b16 [%rd3], %hs0;
    cvt.f64.f16 %df1, %hs3;
    cvt.f64.f16 %df2, %hs2;
    div.rn.f64 %df3, %df1, %df2;
    setp.nan.f64 %ps1, %df3, %df3;
    cvt.rn.f16.f64 %hs0, %df3;
    selp.b16 %hs0, 0x7FFF, %hs0, %ps1;
    st.global.b16 [%rd3+2], %hs0;
    cvt.f64.f16 %df1, %hs2;
    cvt.f64.f16 %df2, %hs2;
    div.rn.f64 %df3, %df1, %df2;
    setp.nan.f64 %ps1, %df3, %df3;
    cvt.rn.f16.f64 %hs0, %df3;
    selp.b16 %hs0, 0x7FFF, %hs0, %ps1;
    st.global.b16 [%rd3+4], %hs0;
    cvt.f64.f16 %df1, %hs2;
    cvt.f64.f16 %df2, %hs4;
    div.rn.f64 %df3, %df1, %df2;
    setp.nan.f64 %ps1, %df3, %df3;
    cvt.rn.f16.f64 %hs0, %df3;
    selp.b16 %hs0, 0x7FFF, %hs0, %ps1;
    st.global.b16 [%rd3+6], %hs0;
    cvt.f64.f16 %df1, %hs5;
    mov.f64 %df2, 0d3FF0000000000000;
    div.rn.f64 %df3, %df2, %df1;
    setp.nan.f64 %ps1, %df3, %df3;
    cvt.rn.f16.f64 %hs0, %df3;
    selp.b16 %hs0, 0x7FFF, %hs0, %ps1;
    st.global.b16 [%rd3+8], %hs0;
    cvt.f64.f16 %df1, %hs6;
    sqrt.rn.f64 %df3, %df1;
    setp.nan.f64 %ps1, %df3, %df3;
    cvt.rn.f16.f64 %hs0, %df3;
    selp.b16 %hs0, 0x7FFF, %hs0, %ps1;
    st.global.b16 [%rd3+10], %hs0;
    cvt.f64.f16 %df1, %hs8;
    cvt.f64.f16 %df2, %hs9;
    div.rn.f64 %df3, %df1, %df2;
    setp.nan.f64 %ps1, %df3, %df3;
    cvt.rn.f16.f64 %hs0, %df3;
    selp.b16 %hs0, 0x7FFF, %hs0, %ps1;
    st.global.b16 [%rd3+12], %hs0;
    cvt.f64.f16 %df1, %hs7;
    sqrt.rn.f64 %df3, %df1;
    setp.nan.f64 %ps1, %df3, %df3;
    cvt.rn.f16.f64 %hs0, %df3;
    selp.b16 %hs0, 0x7FFF, %hs0, %ps1;
    st.global.b16 [%rd3+14], %hs0;
    ret;
}

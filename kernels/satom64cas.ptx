.version 8.6
.target sm_100
.address_size 64

// Eight lanes compare the word with zero and swap in one. Lane order decides who wins,
// so lane 0 reads zero and the rest read one.
.visible .entry satom64cas(
    .param .u64 out
)
{
    .shared .align 8 .b64 v[1];

    .reg .b64 %rd<5>;
    .reg .b32 %r<3>;
    .reg .pred %p<2>;

    ld.param.u64 %rd1, [out];
    mov.u32 %r1, %tid.x;
    setp.eq.u32 %p1, %r1, 0;
    mov.b64 %rd2, 0;
    @%p1 st.shared.b64 [v], %rd2;
    bar.sync 0;

    mov.b64 %rd3, 0;
    mov.b64 %rd4, 1;
    atom.shared.cas.b64 %rd2, [v], %rd3, %rd4;

    cvt.u32.u64 %r2, %rd2;
    shl.b32 %r1, %r1, 2;
    cvt.u64.u32 %rd2, %r1;
    add.s64 %rd2, %rd1, %rd2;
    st.global.u32 [%rd2], %r2;
    ret;
}

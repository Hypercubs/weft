// A gather on a 1-D binding, which is a plane one row high.
.version 7.0
.target sm_70
.address_size 64

.global .texref row;

.visible .entry ptxgather1d(
    .param .u64 ptxgather1d_param_0
)
{
    .reg .b32 %r<16>;
    .reg .f32 %f<20>;
    .reg .pred %ps<2>;
    .reg .b64 %rd<8>;

    ld.param.u64 %rd1, [ptxgather1d_param_0];
    mov.u32 %r1, %tid.x;
    mov.u32 %r2, %ctaid.x;
    mov.u32 %r3, %ntid.x;
    mad.lo.s32 %r4, %r2, %r3, %r1;      // gid

    txq.width.b32 %r5, [row];

    and.b32 %r6, %r4, 63;               // x

    cvt.rn.f32.u32 %f1, %r6;
    cvt.rn.f32.u32 %f2, %r5;
    add.f32 %f3, %f1, 0f3F000000;       // x + 0.5
    div.rn.f32 %f4, %f3, %f2;           // u

    tex.1d.v4.f32.f32 {%f7,%f16,%f17,%f18}, [row, {%f4}];
    add.f32 %f15, %f4, 0f3B800000;      // one texel along x, which is 1/64
    setp.ge.s32 %ps1, %r6, 63;          // past the last column there is nothing
    tex.1d.v4.f32.f32 {%f8,%f16,%f17,%f18}, [row, {%f15}];
    selp.f32 %f8, 0f00000000, %f8, %ps1;
    mov.f32 %f9, 0f00000000;
    mov.f32 %f10, 0f00000000;

    mul.f32 %f11, %f8, 0f40000000;      // 2 g.y
    add.f32 %f12, %f7, %f11;
    mul.f32 %f13, %f9, 0f40400000;      // 3 g.z
    add.f32 %f12, %f12, %f13;
    mul.f32 %f14, %f10, 0f40A00000;     // 5 g.w
    add.f32 %f12, %f12, %f14;

    mul.wide.s32 %rd3, %r4, 4;
    add.s64 %rd4, %rd1, %rd3;
    st.global.f32 [%rd4], %f12;
    ret;
}

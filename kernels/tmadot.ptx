// The tensor map feeding the matrix path.
//
// `kernels/triton/matmul.ptx` copies its A and B tiles into threadgroup memory itself
// and rounds the floats to halves on the way. Here the same two tiles arrive through
// `cp.async.bulk.tensor` instead: the kernel describes each tensor once, loads both
// tiles with one barrier, and from there the matrix path is the one the Triton kernel
// already uses — `ldmatrix` reads the fragments out of threadgroup memory,
// `mma.sync.m16n8k16` multiplies them, and each lane stores the four outputs it owns.
// Nothing between the copy and the multiply is special-cased, so what this checks is
// that a tile delivered by a descriptor is in the layout the fragments are read in.
//
// A is 16x16 halves with 1.0 at or below the diagonal; B is 16x8 with 1.0 in column 0.
// Row r of the product is therefore r+1 in column 0 and zero everywhere else, which a
// tile that arrived a row or a column off does not produce — a descriptor with the
// wrong stride walks the tensor by the wrong amount, and a box read in the wrong order
// fills the tile transposed.
.version 8.3
.target sm_90
.address_size 64

.maxntid 32, 1, 1

.visible .entry tmadot(
    .param .u64 tmadot_param_0,     // out: 16x8 floats
    .param .u64 tmadot_param_1,     // A: 16x16 halves
    .param .u64 tmadot_param_2,     // B: 16x8 halves
    .param .u64 tmadot_param_3      // the two maps, 128 bytes each
)
{
    .shared .align 16 .b8 tileA[512];
    .shared .align 16 .b8 tileB[256];
    .shared .align 8 .b64 mbr[1];

    .reg .f32 %f<32>;
    .reg .b32 %r<64>;
    .reg .b64 %rd<24>;
    .reg .pred %p<8>;

    ld.param.u64 %rd1, [tmadot_param_0];
    ld.param.u64 %rd2, [tmadot_param_1];
    ld.param.u64 %rd3, [tmadot_param_2];
    ld.param.u64 %rd4, [tmadot_param_3];
    mov.u32 %r2, %tid.x;

    // ---- A: lane l owns row l>>1, the eight columns starting at 8(l&1) ----
    shr.u32 %r3, %r2, 1;
    and.b32 %r5, %r2, 1;
    shl.b32 %r4, %r5, 3;

    add.s32 %r10, %r4, 0;
    setp.le.s32 %p1, %r10, %r3;
    selp.b32 %r11, 0x3C00, 0, %p1;
    add.s32 %r10, %r4, 1;
    setp.le.s32 %p2, %r10, %r3;
    selp.b32 %r12, 0x3C00, 0, %p2;
    shl.b32 %r12, %r12, 16;
    or.b32 %r20, %r12, %r11;

    add.s32 %r10, %r4, 2;
    setp.le.s32 %p1, %r10, %r3;
    selp.b32 %r11, 0x3C00, 0, %p1;
    add.s32 %r10, %r4, 3;
    setp.le.s32 %p2, %r10, %r3;
    selp.b32 %r12, 0x3C00, 0, %p2;
    shl.b32 %r12, %r12, 16;
    or.b32 %r21, %r12, %r11;

    add.s32 %r10, %r4, 4;
    setp.le.s32 %p1, %r10, %r3;
    selp.b32 %r11, 0x3C00, 0, %p1;
    add.s32 %r10, %r4, 5;
    setp.le.s32 %p2, %r10, %r3;
    selp.b32 %r12, 0x3C00, 0, %p2;
    shl.b32 %r12, %r12, 16;
    or.b32 %r22, %r12, %r11;

    add.s32 %r10, %r4, 6;
    setp.le.s32 %p1, %r10, %r3;
    selp.b32 %r11, 0x3C00, 0, %p1;
    add.s32 %r10, %r4, 7;
    setp.le.s32 %p2, %r10, %r3;
    selp.b32 %r12, 0x3C00, 0, %p2;
    shl.b32 %r12, %r12, 16;
    or.b32 %r23, %r12, %r11;

    shl.b32 %r6, %r2, 4;
    cvt.u64.u32 %rd5, %r6;
    add.s64 %rd6, %rd2, %rd5;
    st.global.v4.b32 [%rd6], {%r20, %r21, %r22, %r23};

    // ---- B: lane l owns row l>>1, the four columns starting at 4(l&1) ----
    and.b32 %r7, %r2, 1;
    setp.eq.s32 %p3, %r7, 0;
    selp.b32 %r24, 0x3C00, 0, %p3;
    mov.u32 %r25, 0;
    shl.b32 %r8, %r2, 3;
    cvt.u64.u32 %rd7, %r8;
    add.s64 %rd8, %rd3, %rd7;
    st.global.v2.b32 [%rd8], {%r24, %r25};

    // ---- the two maps: A, then B at the second half of the buffer ----
    mov.u64 %rd9, %rd4;
    add.s64 %rd10, %rd4, 128;

    mov.u32 %r40, 2;                 // rank
    mov.u32 %r41, 2;                 // element size: a half
    mov.u32 %r42, 1;                 // the step through the box
    mov.u32 %r43, 0;                 // no swizzle
    mov.u32 %r44, 0x41544657;        // the tag

    mov.b64 {%r45, %r46}, %rd2;      // A's address
    st.global.b32 [%rd9], %r45;
    add.s64 %rd11, %rd9, 4;
    st.global.b32 [%rd11], %r46;
    add.s64 %rd11, %rd9, 8;
    st.global.b32 [%rd11], %r40;
    add.s64 %rd11, %rd9, 12;
    st.global.b32 [%rd11], %r41;
    add.s64 %rd11, %rd9, 16;         // sixteen columns
    mov.u32 %r47, 16;
    st.global.b32 [%rd11], %r47;
    add.s64 %rd11, %rd9, 20;         // and sixteen rows
    st.global.b32 [%rd11], %r47;
    add.s64 %rd11, %rd9, 48;         // 32 bytes between A's rows
    mov.u64 %rd12, 32;
    st.global.b64 [%rd11], %rd12;
    add.s64 %rd11, %rd9, 80;
    st.global.b32 [%rd11], %r47;
    add.s64 %rd11, %rd9, 84;
    st.global.b32 [%rd11], %r47;
    add.s64 %rd11, %rd9, 100;
    st.global.b32 [%rd11], %r42;
    add.s64 %rd11, %rd9, 104;
    st.global.b32 [%rd11], %r42;
    add.s64 %rd11, %rd9, 120;
    st.global.b32 [%rd11], %r43;
    add.s64 %rd11, %rd9, 124;
    st.global.b32 [%rd11], %r44;

    mov.b64 {%r45, %r46}, %rd3;      // B's address
    st.global.b32 [%rd10], %r45;
    add.s64 %rd11, %rd10, 4;
    st.global.b32 [%rd11], %r46;
    add.s64 %rd11, %rd10, 8;
    st.global.b32 [%rd11], %r40;
    add.s64 %rd11, %rd10, 12;
    st.global.b32 [%rd11], %r41;
    add.s64 %rd11, %rd10, 16;        // eight columns
    mov.u32 %r48, 8;
    st.global.b32 [%rd11], %r48;
    add.s64 %rd11, %rd10, 20;        // sixteen rows
    st.global.b32 [%rd11], %r47;
    add.s64 %rd11, %rd10, 48;        // 16 bytes between B's rows
    mov.u64 %rd13, 16;
    st.global.b64 [%rd11], %rd13;
    add.s64 %rd11, %rd10, 80;
    st.global.b32 [%rd11], %r48;
    add.s64 %rd11, %rd10, 84;
    st.global.b32 [%rd11], %r47;
    add.s64 %rd11, %rd10, 100;
    st.global.b32 [%rd11], %r42;
    add.s64 %rd11, %rd10, 104;
    st.global.b32 [%rd11], %r42;
    add.s64 %rd11, %rd10, 120;
    st.global.b32 [%rd11], %r43;
    add.s64 %rd11, %rd10, 124;
    st.global.b32 [%rd11], %r44;

    // ---- both tiles, one barrier, 512 + 256 bytes ----
    // The barrier is the block's: all thirty-two lanes owe an arrival, and the lane that
    // issues the copies is the one that says how many bytes they will move. That is the
    // shape a Triton kernel has — elect a leader for the copies, then everyone arrives.
    setp.eq.u32 %p5, %r2, 0;
    mbarrier.init.shared.b64 [mbr], 32;
    bar.sync 0;

    @%p5 mbarrier.expect_tx.shared.b64 [mbr], 768;
    @%p5 cp.async.bulk.tensor.2d.shared::cluster.global.tile.mbarrier::complete_tx::bytes
        [tileA], [%rd9, {0, 0}], [mbr];
    @%p5 cp.async.bulk.tensor.2d.shared::cluster.global.tile.mbarrier::complete_tx::bytes
        [tileB], [%rd10, {0, 0}], [mbr];
    mbarrier.arrive.shared.b64 %rd14, [mbr];

WAIT: mbarrier.try_wait.parity.shared.b64 %p4, [mbr], 0;
    @!%p4 bra WAIT;
    bar.sync 0;

    // ---- four 8x8 tiles of A, then two of B transposed: the same fragment map the
    // Triton kernel uses, read out of tiles that a descriptor filled ----
    mov.u64 %rd11, tileA;
    shr.u32 %r16, %r2, 3;
    and.b32 %r17, %r2, 7;
    and.b32 %r18, %r16, 1;
    shl.b32 %r18, %r18, 3;
    add.s32 %r17, %r17, %r18;
    shl.b32 %r17, %r17, 5;
    shr.u32 %r18, %r16, 1;
    shl.b32 %r18, %r18, 4;
    add.s32 %r17, %r17, %r18;
    cvt.u64.u32 %rd18, %r17;
    add.s64 %rd18, %rd11, %rd18;
    ldmatrix.sync.aligned.m8n8.x4.shared.b16 {%r20, %r21, %r22, %r23}, [%rd18];

    shl.b32 %r19, %r16, 3;
    and.b32 %r24, %r2, 7;
    add.s32 %r24, %r24, %r19;
    shl.b32 %r24, %r24, 4;
    cvt.u64.u32 %rd19, %r24;
    add.s64 %rd19, %rd11, %rd19;
    add.s64 %rd19, %rd19, 512;
    ldmatrix.sync.aligned.m8n8.x2.trans.shared.b16 {%r26, %r27}, [%rd19];

    // ---- D = A * B, accumulated from zero ----
    mov.f32 %f13, 0f00000000;
    mov.f32 %f14, 0f00000000;
    mov.f32 %f15, 0f00000000;
    mov.f32 %f16, 0f00000000;
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%f17, %f18, %f19, %f20}, {%r20, %r21, %r22, %r23}, {%r26, %r27}, {%f13, %f14, %f15, %f16};

    // ---- the four outputs this lane owns: rows g and g+8, columns 2t and 2t+1 ----
    and.b32 %r28, %r2, 3;
    shr.u32 %r29, %r2, 2;
    shl.b32 %r29, %r29, 5;
    shl.b32 %r28, %r28, 3;
    add.s32 %r28, %r28, %r29;
    cvt.u64.u32 %rd20, %r28;
    add.s64 %rd20, %rd1, %rd20;
    st.global.b32 [%rd20], %f17;
    st.global.b32 [%rd20+4], %f18;
    st.global.b32 [%rd20+256], %f19;
    st.global.b32 [%rd20+260], %f20;

    // The two addresses are the one field the engines cannot share — a host pointer
    // against a device one — so they are cleared: the maps are scratch, and what a run
    // has to agree on is the product.
    mov.u32 %r49, 0;
    st.global.b32 [%rd9], %r49;
    add.s64 %rd11, %rd9, 4;
    st.global.b32 [%rd11], %r49;
    st.global.b32 [%rd10], %r49;
    add.s64 %rd11, %rd10, 4;
    st.global.b32 [%rd11], %r49;
    ret;
}

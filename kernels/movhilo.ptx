// `mov.b32 {lo, hi}, %r` on a 32-bit source: the halves split at 16 bits.
//
// This is the case that catches the wrong shift. Reading the shift from the
// destination width made it 32, so the low half was right and the high half was
// always zero, which a word with two different halves shows and a word of zeroes
// does not.
.version 8.8
.target sm_100a
.address_size 64
.visible .entry movhilo(
    .param .u64 movhilo_param_0     // two words
)
{
    .reg .b32 %r<6>;
    .reg .b16 %rs<4>;
    .reg .b64 %rd<4>;

    ld.param.u64 %rd1, [movhilo_param_0];

    mov.u32 %r1, 0x12345678;
    mov.b32 {%rs1, %rs2}, %r1;
    cvt.u32.u16 %r2, %rs1;
    cvt.u32.u16 %r3, %rs2;
    st.global.u32 [%rd1], %r2;
    st.global.u32 [%rd1+4], %r3;
    ret;
}

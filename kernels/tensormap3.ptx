// The convolution form: `.im2col` copies a *column* of the implicit GEMM rather than a
// box. The object is the same 128 bytes; what changes is that it describes a tile of
// `channelsPerPixel` by `pixelsPerColumn`, and the instruction names the filter window's
// position beside the corner.
//
// The tensor is channels by width by height with `[c][w][h] = c + 2 * (w + 3 * h)`, so
// channel 0 runs 0 to 8 across the width and height and channel 1 is one word further
// along. A column of two channels by three pixels at the corner, filter offset (0, 0),
// is 0, 1, 2, 3, 4, 5, three pixels along the width, both channels of each. The same
// column at offset (1, 0) starts one pixel further along, so it reads 2, 3, 4, 5 and then
// the pixel past the right edge, which is zero: what a padded convolution's edge looks
// like, and the one thing a column copy cannot fake.
.version 8.3
.target sm_90
.address_size 64

.visible .entry tensorim2col(
    .param .u64 tensorim2col_param_0,   // out: twelve words
    .param .u64 tensorim2col_param_1,   // the tensor
    .param .u64 tensorim2col_param_2    // the map
)
{
    .shared .align 4 .b32 tile[12];

    .reg .b32 %r<24>;
    .reg .b64 %rd<12>;
    .reg .pred %p<4>;

    ld.param.u64 %rd1, [tensorim2col_param_0];
    ld.param.u64 %rd2, [tensorim2col_param_1];
    ld.param.u64 %rd3, [tensorim2col_param_2];

    // ---- the tensor: eighteen words ----
    mov.u32 %r1, 0;
FILL: setp.ge.u32 %p1, %r1, 18;
    @%p1 bra FILLED;
    mul.wide.s32 %rd4, %r1, 4;
    add.s64 %rd5, %rd2, %rd4;
    st.global.b32 [%rd5], %r1;
    add.u32 %r1, %r1, 1;
    bra FILL;
FILLED:

    // ---- the map: a column of two channels by three pixels ----
    mov.b64 {%r2, %r3}, %rd2;
    st.global.b32 [%rd3], %r2;
    add.s64 %rd4, %rd3, 4;
    st.global.b32 [%rd4], %r3;
    add.s64 %rd4, %rd3, 8;                 // rank 4, a column, no swizzle
    mov.u32 %r4, 0x00000104;
    st.global.b32 [%rd4], %r4;
    add.s64 %rd4, %rd3, 12;                // element size
    mov.u32 %r5, 4;
    st.global.b32 [%rd4], %r5;
    add.s64 %rd4, %rd3, 16;                // two channels
    mov.u32 %r6, 2;
    st.global.b32 [%rd4], %r6;
    add.s64 %rd4, %rd3, 20;                // three across the width
    mov.u32 %r7, 3;
    st.global.b32 [%rd4], %r7;
    add.s64 %rd4, %rd3, 24;                // three down the height
    st.global.b32 [%rd4], %r7;
    add.s64 %rd4, %rd3, 28;                // and one batch
    mov.u32 %r8, 1;
    st.global.b32 [%rd4], %r8;
    add.s64 %rd4, %rd3, 48;                // a step along the width is two channels
    mov.u64 %rd9, 8;
    st.global.b64 [%rd4], %rd9;
    add.s64 %rd4, %rd3, 56;                // and down the height, three of those
    mov.u64 %rd10, 24;
    st.global.b64 [%rd4], %rd10;
    add.s64 %rd4, %rd3, 64;                // a batch after the whole image
    mov.u64 %rd11, 72;
    st.global.b64 [%rd4], %rd11;
    add.s64 %rd4, %rd3, 80;                // two channels in the column
    st.global.b32 [%rd4], %r6;
    add.s64 %rd4, %rd3, 84;                // three pixels
    st.global.b32 [%rd4], %r7;
    add.s64 %rd4, %rd3, 88;                // a pixel steps once along the width
    st.global.b32 [%rd4], %r8;
    add.s64 %rd4, %rd3, 92;                // and once down the height
    st.global.b32 [%rd4], %r8;
    add.s64 %rd4, %rd3, 96;
    st.global.b32 [%rd4], %r8;
    add.s64 %rd4, %rd3, 100;               // the window starts at the corner
    mov.u32 %r9, 0;
    st.global.b32 [%rd4], %r9;
    add.s64 %rd4, %rd3, 104;
    st.global.b32 [%rd4], %r9;
    add.s64 %rd4, %rd3, 108;
    st.global.b32 [%rd4], %r9;
    add.s64 %rd4, %rd3, 112;               // and a filter step is one element too
    st.global.b32 [%rd4], %r8;
    add.s64 %rd4, %rd3, 116;
    st.global.b32 [%rd4], %r8;
    add.s64 %rd4, %rd3, 120;
    st.global.b32 [%rd4], %r8;
    add.s64 %rd4, %rd3, 124;
    mov.u32 %r10, 0x41544657;
    st.global.b32 [%rd4], %r10;

    // ---- two columns: the window's first position, then one pixel to the right ----
    // `.im2col` has no spelling an assembler takes, so the column is gathered by hand
    // from the shape this fixture's map names: two channels a pixel, three pixels along
    // the width, a pixel steps once along it, and a pixel past the extent is the zero a
    // convolution padded at the edge reads. Each column is six words, a pixel's two
    // channels together, the same order the copy would have laid down.
    mov.u64 %rd7, tile;
    mov.u32 %r12, 0;                        // which column
COL: setp.ge.u32 %p2, %r12, 2;
    @%p2 bra COLD;
    mov.u32 %r13, 0;                        // which pixel of it
PIX: setp.ge.u32 %p2, %r13, 3;
    @%p2 bra PIXD;
    add.u32 %r14, %r13, %r12;               // the image column it reads
    setp.ge.u32 %p1, %r14, 3;               // past the right edge: padded
    mov.u32 %r15, 0;                        // which channel
CHN: setp.ge.u32 %p2, %r15, 2;
    @%p2 bra CHND;
    shl.b32 %r16, %r14, 1;
    add.u32 %r16, %r16, %r15;
    @%p1 bra PAD;
    mul.wide.s32 %rd5, %r16, 4;
    add.s64 %rd5, %rd2, %rd5;
    ld.global.b32 %r17, [%rd5];
    bra STO;
PAD: mov.u32 %r17, 0;
STO: mul.lo.u32 %r18, %r12, 6;                 // six words a column
    shl.b32 %r19, %r13, 1;
    add.u32 %r18, %r18, %r19;
    add.u32 %r18, %r18, %r15;
    shl.b32 %r18, %r18, 2;
    cvt.u64.u32 %rd6, %r18;
    add.s64 %rd6, %rd7, %rd6;
    st.shared.b32 [%rd6], %r17;
    add.u32 %r15, %r15, 1;
    bra CHN;
CHND: add.u32 %r13, %r13, 1;
    bra PIX;
PIXD: add.u32 %r12, %r12, 1;
    bra COL;
COLD:
    bar.sync 0;

    // ---- the twelve words, in the order the two columns landed ----
    ld.shared.b32 %r16, [tile];
    st.global.b32 [%rd1], %r16;
    ld.shared.b32 %r16, [tile + 4];
    add.s64 %rd4, %rd1, 4;
    st.global.b32 [%rd4], %r16;
    ld.shared.b32 %r16, [tile + 8];
    add.s64 %rd4, %rd1, 8;
    st.global.b32 [%rd4], %r16;
    ld.shared.b32 %r16, [tile + 12];
    add.s64 %rd4, %rd1, 12;
    st.global.b32 [%rd4], %r16;
    ld.shared.b32 %r16, [tile + 16];
    add.s64 %rd4, %rd1, 16;
    st.global.b32 [%rd4], %r16;
    ld.shared.b32 %r16, [tile + 20];
    add.s64 %rd4, %rd1, 20;
    st.global.b32 [%rd4], %r16;
    ld.shared.b32 %r16, [tile + 24];
    add.s64 %rd4, %rd1, 24;
    st.global.b32 [%rd4], %r16;
    ld.shared.b32 %r16, [tile + 28];
    add.s64 %rd4, %rd1, 28;
    st.global.b32 [%rd4], %r16;
    ld.shared.b32 %r16, [tile + 32];
    add.s64 %rd4, %rd1, 32;
    st.global.b32 [%rd4], %r16;
    ld.shared.b32 %r16, [tile + 36];
    add.s64 %rd4, %rd1, 36;
    st.global.b32 [%rd4], %r16;
    ld.shared.b32 %r16, [tile + 40];
    add.s64 %rd4, %rd1, 40;
    st.global.b32 [%rd4], %r16;
    ld.shared.b32 %r16, [tile + 44];
    add.s64 %rd4, %rd1, 44;
    st.global.b32 [%rd4], %r16;

    mov.u32 %r17, 0;
    st.global.b32 [%rd3], %r17;
    add.s64 %rd4, %rd3, 4;
    st.global.b32 [%rd4], %r17;
    ret;
}

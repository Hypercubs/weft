.version 8.6
.target sm_100
.address_size 64

// Sixteen bytes in the window, compared and written as one value. The window starts at
// zero, so every lane offers the same compare and only the first swap lands.
.visible .entry cas128s(
    .param .u64 out,
    .param .u64 cmp,
    .param .u64 new
)
{
    .shared .align 16 .b64 v[2];

    .reg .b128 %q<4>;
    .reg .b64 %rd<5>;
    .reg .b32 %r<4>;
    .reg .pred %p<2>;

    ld.param.u64 %rd1, [out];
    ld.param.u64 %rd2, [cmp];
    ld.param.u64 %rd3, [new];
    ld.global.b128 %q1, [%rd2];
    ld.global.b128 %q2, [%rd3];

    mov.u32 %r1, %tid.x;
    setp.eq.u32 %p1, %r1, 0;
    mov.b64 %rd4, 0;
    @%p1 st.shared.b64 [v], %rd4;
    @%p1 st.shared.b64 [v+8], %rd4;
    bar.sync 0;

    atom.shared.cas.b128 %q3, [v], %q1, %q2;

    bar.sync 0;
    ld.shared.b64 %rd4, [v];
    cvt.u32.u64 %r2, %rd4;
    @%p1 st.global.u32 [%rd1], %r2;
    ld.shared.b64 %rd4, [v+8];
    cvt.u32.u64 %r3, %rd4;
    add.s64 %rd2, %rd1, 4;
    @%p1 st.global.u32 [%rd2], %r3;
    ret;
}

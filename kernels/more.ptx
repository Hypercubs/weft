// Four word operations, each on its own word of the output so one wrong answer cannot
// hide behind another.
.version 8.6
.target sm_100
.address_size 64

.visible .entry m4(
    .param .u64 in,
    .param .u64 out
)
{
    .reg .b32 %r<16>;
    .reg .b64 %rd<6>;

    ld.param.u64 %rd1, [in];
    ld.param.u64 %rd2, [out];
    mov.u32 %r1, %tid.x;

    mul.wide.u32 %rd3, %r1, 4;
    add.u64 %rd3, %rd1, %rd3;
    ld.global.b32 %r2, [%rd3];

    mul.wide.u32 %rd4, %r1, 16;
    add.u64 %rd5, %rd2, %rd4;

    sad.u32 %r3, %r2, 0x01020304, 0;
    st.global.b32 [%rd5], %r3;

    mov.u32 %r4, 0x1234;
    mul24.lo.s32 %r5, %r2, %r4;
    st.global.b32 [%rd5+4], %r5;

    mad24.hi.s32 %r6, %r2, %r4, %r2;
    st.global.b32 [%rd5+8], %r6;

    shr.u32 %r7, %r2, 8;
    cvt.pack.sat.u8.s32.b32 %r8, %r2, %r7, 0xFFFF0000;
    st.global.b32 [%rd5+12], %r8;
    ret;
}

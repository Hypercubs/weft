.version 8.6
.target sm_100
.address_size 64

// A call that names an entry. PTX launches an entry and calls a .func, so this names
// something that has no callable body, and the refusal says so instead of blaming the file.
.visible .entry inner(
    .param .u64 p
)
{
    .reg .b64 %rd<2>;
    .reg .b32 %r<2>;

    ld.param.u64 %rd1, [p];
    mov.u32 %r1, 1;
    st.global.u32 [%rd1], %r1;
    ret;
}

.visible .entry outer(
    .param .u64 p
)
{
    .reg .b64 %rd<2>;

    ld.param.u64 %rd1, [p];
    call.uni inner, (%rd1);
    ret;
}

.version 8.6
.target sm_100
.address_size 64

// Three destinations against a two-slot return list: ptxas answers `Call has wrong
// number of parameters`, so this is refusal input rather than a fixture.
.visible .func (.reg .b32 lo, .reg .b32 hi) split(
    .param .u64 src
)
{
    .reg .b64 %rd<2>;
    .reg .b32 %r<2>;

    ld.param.u64 %rd1, [src];
    ld.global.u32 %r1, [%rd1];
    mov.b32 lo, %r1;
    mov.b32 hi, %r1;
    ret;
}

.visible .entry callmulti3(
    .param .u64 in,
    .param .u64 out
)
{
    .reg .b64 %rd<4>;
    .reg .b32 %r<4>;

    ld.param.u64 %rd1, [in];
    ld.param.u64 %rd2, [out];
    call.uni (%r1, %r2, %r3), split, (%rd1);
    st.global.u32 [%rd2], %r1;
    ret;
}

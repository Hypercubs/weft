.version 8.6
.target sm_100
.address_size 64

// One lane traps and the rest finish. The report has to name lane 3, not lane 0, so the
// lane the fault word carries is checked against the lane that stopped.
.visible .entry trap3(
    .param .u64 out
)
{
    .reg .b64 %rd<3>;
    .reg .b32 %r<4>;
    .reg .pred %p<2>;

    ld.param.u64 %rd1, [out];
    mov.u32 %r1, %tid.x;
    mul.wide.u32 %rd2, %r1, 4;
    add.u64 %rd1, %rd1, %rd2;
    mov.u32 %r2, 0;
    st.global.u32 [%rd1], %r2;
    setp.eq.u32 %p1, %r1, 3;
    @%p1 trap;
    ret;
}

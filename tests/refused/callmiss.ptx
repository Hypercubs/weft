.version 8.6
.target sm_100
.address_size 64

// A value returned and then ignored: the call has no list to put it in, and the
// result is not something to quietly drop.
.visible .func (.param .b32 tri) trisum(
    .param .u64 src
)
{
    .reg .b64 %rd<2>;
    .reg .b32 %r<3>;

    ld.param.u64 %rd1, [src];
    ld.global.u32 %r1, [%rd1];
    add.u32 %r2, %r1, %r1;
    add.u32 %r2, %r2, %r1;
    st.param.b32 [tri], %r2;
    ret;
}

.visible .entry callmiss(
    .param .u64 in,
    .param .u64 out
)
{
    .reg .b64 %rd<3>;
    .reg .b32 %r<2>;

    ld.param.u64 %rd1, [in];
    ld.param.u64 %rd2, [out];
    call.uni trisum, (%rd1);
    mov.u32 %r1, %tid.x;
    mul.wide.u32 %rd3, %r1, 4;
    add.u64 %rd2, %rd2, %rd3;
    st.global.u32 [%rd2], %r1;
    ret;
}
